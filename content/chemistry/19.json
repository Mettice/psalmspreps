   "id": "ch19",
   "name": "Elements and their symbols"
  }
 ],
 "note": {
  "status": "draft",
  "text": "An element is a pure substance made of only one kind of atom. It cannot be broken down into simpler substances by chemical means. About 118 elements are known; most are metals.\nEach element has a symbol: one capital letter, or a capital and a small letter. H hydrogen, He helium, C carbon, N nitrogen, O oxygen, Na sodium, Mg magnesium, Al aluminium, S sulfur, Cl chlorine, K potassium, Ca calcium, Fe iron, Cu copper, Zn zinc.\nSome symbols come from Latin names: Na (natrium), K (kalium), Fe (ferrum), Cu (cuprum), Ag silver (argentum), Au gold (aurum), Pb lead (plumbum).\nWrite symbols carefully: Co is cobalt, but CO is carbon monoxide.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "a": "Fe",
   "b": "Na"
  },
  "problem": "Why is the symbol for iron {a} and the symbol for sodium {b}?",
  "steps": [
   "They come from the Latin names of the elements.",
   "Iron in Latin is {latinName(a)}: {a}. Sodium is {latinName(b)}: {b}."
  ],
  "answer": "Iron: {a} (from {latinName(a)}); sodium: {b} (from {latinName(b)}).",
  "checks": [
   "nameOf(a) == 'iron'"
  ]
 },
