 "skills": [
  {
   "id": "m4-35",
   "name": "Write numbers in standard form and calculate with them"
  }
 ],
 "note": {
  "status": "draft",
  "text": "Standard form is A × 10ⁿ with 1 ≤ A < 10 and n a whole number.\n• 45 000 = 4.5 × 10⁴; 0.000 32 = 3.2 × 10⁻⁴.\n• Multiply: multiply the A's and add the indices, then adjust: (3 × 10⁴)(5 × 10³) = 15 × 10⁷ = 1.5 × 10⁸.\n• Divide: divide the A's and subtract the indices: (6 × 10⁵) ÷ (2 × 10²) = 3 × 10³.\n• Add or subtract: write both with the same power first: 3 × 10⁴ + 5 × 10³ = 30 × 10³ + 5 × 10³ = 3.5 × 10⁴.",
  "checks": []
 },
 "learn": {
  "status": "draft",
  "vars": {},
  "sections": [
   {
    "heading": "Your goal and connections",
    "text": "By the end, you should be able to write very large and very small numbers in standard form and multiply, divide, add and subtract them.\nBuilds on: Lesson {27} (laws of indices) and Lesson {33} (significant figures).\nLeads to: Physics and Chemistry calculations (the mole, wavelengths) and the use of a calculator's EXP key."
   },
   {
    "heading": "Writing standard form",
    "text": "A × {10}ⁿ with {1} ≤ A < {10}.\n• {45000}: move the point {4} places left to get {4.5}, so {4.5} × {10}{sup(4)}.\n• {0.00032}: move it {4} places right to get {3.2}, so {3.2} × {10}{sup(-4)}.\nBig numbers have a positive index; numbers between {0} and {1} have a negative one.\n{15} × {10}{sup(7)} is not standard form: {15} = {1.5} × {10}, so it is {1.5} × {10}{sup(8)}."
   },
   {
    "heading": "Calculating",
    "text": "• Multiply: ({3} × {10}{sup(4)})({5} × {10}{sup(3)}) = {15} × {10}{sup(7)} = {1.5} × {10}{sup(8)}.\n• Divide: ({6} × {10}{sup(5)}) ÷ ({2} × {10}{sup(2)}) = {3} × {10}{sup(3)}.\n• Add: make the powers equal first. {3} × {10}{sup(4)} + {5} × {10}{sup(3)} = {30} × {10}{sup(3)} + {5} × {10}{sup(3)} = {35} × {10}{sup(3)} = {3.5} × {10}{sup(4)}.\nCheck the size roughly: {30000} + {5000} = {35000}."
   }
  ],
  "key_words": [
   {
    "word": "standard form",
    "meaning": "A × {10}ⁿ with {1} ≤ A < {10}"
   },
   {
    "word": "index",
    "meaning": "the power of {10}"
   },
   {
    "word": "adjust",
    "meaning": "rewrite so that A is between {1} and {10}"
   }
  ],
  "examples": [
   "{602000} = {6.02} × {10}{sup(5)}",
   "{0.0071} = {7.1} × {10}{sup(-3)}",
   "({2} × {10}{sup(3)})² = {4} × {10}{sup(6)}"
  ],
  "mistake": {
   "wrong": "{3} × {10}{sup(4)} + {5} × {10}{sup(3)} = {8} × {10}{sup(7)}",
   "right": "= {3.5} × {10}{sup(4)}",
   "why": "Only multiplying adds indices. For adding, make the powers the same, then add the front numbers."
  }
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "a": 3,
   "m": 4,
   "b": 5,
   "n": 3
  },
  "problem": "Work out ({a} × {10}{sup(m)}) × ({b} × {10}{sup(n)}), giving the answer in standard form.",
  "steps": [
   "Multiply the numbers: {a} × {b} = {a * b}.",
   "Add the indices: {10}{sup(m)} × {10}{sup(n)} = {10}{sup(m + n)}.",
   "{a * b} × {10}{sup(m + n)} is not in standard form: {a * b} = {dec(a * b / 10)} × {10}."
  ],
  "answer": "{dec(a * b / 10)} × {10}{sup(m + n + 1)}",
  "checks": [
   "a * b == 15"
  ]
 },
