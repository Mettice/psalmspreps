     "id": "sign",
     "explain": "{k > 0 ? 'A large number has a positive index.' : 'A small number (less than 1) has a negative index.'}"
    },
    {
     "id": "count",
     "explain": "Count the places the point moves: {abs(k)}."
    }
   ],
   "solution": [
    "Move the point so that one non-zero digit is in front: {fmt(A)}.",
    "The point moved {abs(k)} place{abs(k) == 1 ? '' : 's'} {k > 0 ? 'left, so n = ' + k : 'right, so n = ' + fmt(k)}.",
    "So the answer is {answer}."
   ],
   "where": [
    "m % 10 != 0"
