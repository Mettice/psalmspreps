 "skills": [
  {
   "id": "m4-30",
   "name": "Find the determinant, the adjugate and the inverse of a 2 × 2 matrix"
  }
 ],
 "note": {
  "status": "draft",
  "text": "For A = (a b; c d):\n• Determinant: det A = ad − bc.\n• Adjugate (adjoint): adj A = (d −b; −c a): swap the main diagonal, change the signs of the other two.\n• Inverse: A⁻¹ = (1/det A) × adj A, if det A ≠ 0. Check: A A⁻¹ = I.\n• If det A = 0 the matrix is singular and has no inverse.\nExample: A = (3 1; 5 2): det = 6 − 5 = 1, A⁻¹ = (2 −1; −5 3).",
  "checks": []
 },
 "learn": {
  "status": "draft",
  "vars": {},
  "sections": [
   {
    "heading": "Your goal and connections",
    "text": "By the end, you should be able to find the determinant, adjugate and inverse of a {2} × {2} matrix, and recognise a singular matrix.\nBuilds on: Form Three determinant and inverse, and Lesson {29} (matrix products).\nLeads to: Lesson {31} (solving simultaneous equations) and transformations in Form Five."
   },
   {
    "heading": "Determinant and adjugate",
    "text": "For A = (a  b ; c  d):\n• det A = ad − bc. For ({4}  {3} ; {2}  {5}): {20} − {6} = {14}.\n• adj A = (d  −b ; −c  a): swap the two on the main diagonal, change the signs of the other two.\nFor ({4}  {3} ; {2}  {5}): adj = ({5}  {-3} ; {-2}  {4}).\nA × adj A = det A × I. That is why dividing by the determinant gives the inverse."
   },
   {
    "heading": "The inverse",
    "text": "A⁻¹ = ({1}/det A) × adj A.\n• A = ({3}  {1} ; {5}  {2}): det = {1}, so A⁻¹ = ({2}  {-1} ; {-5}  {3}). Check: A A⁻¹ = ({1}  {0} ; {0}  {1}).\n• If det A = {0}, you cannot divide by it: A is singular and has no inverse. ({2}  {4} ; {1}  {2}) is singular.\nUseful: det(AB) = det A × det B, and (AB)⁻¹ = B⁻¹A⁻¹."
   }
  ],
  "key_words": [
   {
    "word": "determinant",
    "meaning": "ad − bc for (a  b ; c  d)"
   },
   {
    "word": "adjugate (adjoint)",
    "meaning": "(d  −b ; −c  a)"
   },
   {
    "word": "inverse",
    "meaning": "A⁻¹ with A A⁻¹ = I"
   },
   {
    "word": "singular",
    "meaning": "determinant {0}; no inverse"
   }
  ],
  "examples": [
   "det ({2}  {1} ; {7}  {4}) = {1}; inverse ({4}  {-1} ; {-7}  {2})",
   "({6}  {3} ; {4}  {2}) is singular"
  ],
  "mistake": {
   "wrong": "det ({4}  {3} ; {2}  {5}) = {12} − {10}",
   "right": "det = {4} × {5} − {3} × {2} = {14}",
   "why": "Multiply along the diagonals: main diagonal a × d, other diagonal b × c."
  }
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "a": 3,
   "b": 1,
   "c": 5,
   "d": 2
  },
  "problem": "Find the inverse of A = ({a}  {b} ; {c}  {d}).",
  "steps": [
   "det A = {a} × {d} − {b} × {c} = {a * d - b * c}.",
   "adj A: swap {a} and {d}, change the signs of {b} and {c}: ({d}  {-b} ; {-c}  {a}).",
   "A⁻¹ = ({1}/{a * d - b * c}) × adj A."
  ],
  "answer": "A⁻¹ = ({d}  {-b} ; {-c}  {a})",
  "checks": [
   "a * d - b * c == 1"
  ]
 },
