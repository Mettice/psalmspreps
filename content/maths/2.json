    {
      "id": "m2-roman-write",
      "type": "mcq",
      "level": 2,
      "vars": {
        "n": {
          "int": [
            40,
            3900
          ]
        }
      },
      "where": "hasSubtractive(n)",
      "prompt": "Which is {n} written in Roman numerals?",
      "correct": "{roman(n)}",
      "distractors": [
        {
          "text": "{romanAdditive(n)}",
          "misconception": "no-subtraction"
        },
        {
          "text": "{roman(n + 1)}",
          "misconception": "off-by-one"
        },
        {
          "text": "{roman(n - 1)}",
          "misconception": "off-by-one"
        },
        {
          "text": "{roman(n + 10)}",
          "misconception": "off-by-ten"
        }
      ],
      "verify": "fromRoman(answer) == n",
      "misconceptions": [
        {
          "id": "no-subtraction",
          "explain": "Never write the same letter four times. Use subtraction: 4 is IV, 9 is IX, 40 is XL, 90 is XC, 400 is CD, 900 is CM."
        },
        {
          "id": "off-by-one",
          "explain": "Split {n} into thousands, hundreds, tens and units, write each part in Roman numerals, then join them."
        },
        {
          "id": "off-by-ten",
          "explain": "Check the tens: {n} has {plural(idiv(n, 10) % 10, 'ten', 'tens')}."
        }
      ],
      "solution": [
        "Split {n} by place value and write each part in Roman numerals:",
        "{romanWorking(n)}",
        "Answer: {answer}"
      ]
    },
