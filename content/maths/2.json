        "id": "c2-1",
        "status": "draft",
        "idea": "Egyptian numbers are pictures: a stroke is {1}, a heel bone is {10}, a coil of rope is {100} and a lotus flower is {1000}. Add the values of all the pictures.",
        "vars": {
          "n": 1203
        },
        "example": [
          "{egyptianList(n)}:",
          "{idiv(n, 1000)} × {1000} + {idiv(n, 100) % 10} × {100} + {n % 10} × {1} = {n}."
        ],
        "checks": [
          "idiv(n, 10) % 10 == 0",
          "idiv(n, 1000) * 1000 + idiv(n, 100) % 10 * 100 + n % 10 == n"
        ],
        "check": {
