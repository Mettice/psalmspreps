      "answer": "n",
      "verify": "digitAt(answer, 3) == th && digitAt(answer, 2) == h && digitAt(answer, 1) == t && digitAt(answer, 0) == u",
      "misconceptions": [
        {
          "id": "no-placeholder",
          "wrong": "stripZeros(n)",
          "explain": "Egyptian numerals had no place value, so they did not need a zero digit. Ours do: when a picture is missing, write 0 in that place. The answer is {n}."
        }
      ],
      "solution": [
        "Value of each kind of picture: {th} × {1000} = {th * 1000}, {h} × {100} = {h * 100}, {t} × {10} = {t * 10}, {u} × {1} = {u}.",
        "Add them: {th * 1000} + {h * 100} + {t * 10} + {u} = {n}.",
        "A missing picture means {0} in that place."
