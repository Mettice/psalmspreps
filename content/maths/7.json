      },
      "where": "a != n",
      "prompt": "Write {join(rep(a, n), ' × ')} as a power.",
      "correct": "{a}{sup(n)}",
      "distractors": [
        {
          "text": "{n}{sup(a)}",
          "misconception": "swapped"
        },
        {
          "text": "{a} × {n}",
          "misconception": "times-exponent"
        },
        {
          "text": "{a * n}",
          "misconception": "times-exponent"
        }
      ],
      "misconceptions": [
        {
          "id": "swapped",
          "explain": "The number being multiplied ({a}) is the base. The number of factors ({n}) is the exponent: {a}{sup(n)}."
        },
        {
          "id": "times-exponent",
          "explain": "{a} × {n} is a different calculation. {n} factors of {a} make the power {a}{sup(n)}."
        }
      ],
      "solution": [
        "{a} is multiplied by itself: there are {n} factors.",
        "The base is {a} and the exponent is {n}: {a}{sup(n)}."
      ]
    },
