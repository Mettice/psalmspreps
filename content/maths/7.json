            3,
            6
          ]
        },
        "w": {
          "int": [
            0,
            2
          ]
        }
      },
      "prompt": "Ndi calculated {a} + {b} × {c}{sup(2)}. One line has a mistake. Which one?",
      "steps": [
        {
          "text": "Powers first: {c}{sup(2)} = {w == 0 ? 2 * c : c * c}",
          "truth": "(w == 0 ? 2 * c : c * c) == c ^ 2",
          "explain": "{c}{sup(2)} = {c} × {c} = {c * c}, not {c} × 2."
        },
        {
          "text": "Then multiply: {b} × {c * c} = {w == 1 ? b * c * c + b : b * c * c}",
          "truth": "(w == 1 ? b * c * c + b : b * c * c) == b * c ^ 2",
          "explain": "{b} × {c * c} = {b * c * c}."
        },
        {
          "text": "Then add: {a} + {b * c * c} = {w == 2 ? (a + b) * c * c : a + b * c * c}",
          "truth": "(w == 2 ? (a + b) * c * c : a + b * c * c) == a + b * c ^ 2",
          "explain": "{a} + {b * c * c} = {a + b * c * c}."
        }
      ]
    }
