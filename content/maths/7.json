            5000,
            10000
          ]
        }
      },
      "where": "note > x * p",
      "prompt": "Mih buys {x} bunches of plantains at {p} FCFA each. She pays with a {note} FCFA note. How much change does she get?",
      "answer": "note - x * p",
      "unit": "FCFA",
      "verify": "answer + x * p == note && answer > 0",
      "misconceptions": [
        {
          "id": "forgot-multiply",
          "wrong": "note - p",
          "explain": "First find the cost of all {x} bunches: {x} × {p} = {x * p} FCFA. Then subtract it from {note} FCFA."
        },
        {
          "id": "cost-not-change",
          "wrong": "x * p",
          "explain": "{x * p} FCFA is the cost of the plantains. The change is {note} − {x * p}."
        }
      ],
      "solution": [
        "Cost of the plantains: {x} × {p} = {x * p} FCFA.",
        "Change: {note} − {x * p} = {note - x * p} FCFA."
      ]
    },
