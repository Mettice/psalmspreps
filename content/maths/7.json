              "text": "{a} + {c}",
              "misconception": "left-to-right"
            }
          ],
          "misconceptions": [
            {
              "id": "left-to-right",
              "explain": "Multiplication comes before addition (BODMAS): first {b} × {c}."
            }
          ],
          "solution": [
            "BODMAS: multiplication comes before addition.",
            "So first {b} × {c} = {b * c}, then {a} + {b * c} = {a + b * c}."
          ]
        }
      },
      {
        "id": "c7-4",
        "status": "draft",
        "skill": "m7-operations",
        "idea": "In ℕ, the order of adding or multiplying does not matter. A number in front of brackets multiplies everything inside.",
        "vars": {
          "a": 5,
          "b": 8,
          "c": 3
        },
        "example": [
          "{a} + {b} = {b} + {a} = {a + b}",
          "{a} × {b} = {b} × {a} = {a * b}",
          "{c} × ({a} + {b}) = {c} × {a} + {c} × {b} = {c * (a + b)}"
        ],
        "checks": [
