      {
        "id": "c7-3",
        "status": "draft",
        "skill": "m7-operations",
        "idea": "When there are several operations, use BODMAS: Brackets, then Orders (powers), then Division and Multiplication, then Addition and Subtraction.",
        "vars": {
          "a": 4,
          "b": 3,
          "c": 5
        },
        "example": [
          "{a} + {b} × {c}: multiplication first.",
          "{b} × {c} = {b * c}, then {a} + {b * c} = {a + b * c}."
        ],
        "checks": [
          "a + b * c != (a + b) * c"
