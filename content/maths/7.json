  "questions": [
    {
      "id": "m7-power",
      "skill": "m7-powers",
      "type": "numeric",
      "level": 1,
      "vars": {
        "a": {
          "int": [
            2,
            9
          ]
        },
        "n": {
          "int": [
            2,
            4
          ]
        }
      },
      "where": "a ^ n <= 10000",
      "prompt": "Calculate {a}{sup(n)}.",
      "answer": "a ^ n",
      "verify": "answer == (n == 2 ? a * a : n == 3 ? a * a * a : a * a * a * a)",
      "misconceptions": [
        {
          "id": "times-exponent",
          "wrong": "a * n",
          "explain": "{a}{sup(n)} means {n} factors of {a} multiplied together, not {a} × {n}."
        },
        {
          "id": "plus-exponent",
          "wrong": "a + n",
          "explain": "{a}{sup(n)} is {a} multiplied by itself: {join(rep(a, n), ' × ')}."
        }
      ],
      "solution": [
        "{a}{sup(n)} = {join(rep(a, n), ' × ')} = {a ^ n}"
      ]
    },
    {
      "id": "m7-power-form",
      "skill": "m7-powers",
      "type": "mcq",
      "level": 1,
      "vars": {
        "a": {
          "int": [
            2,
            9
          ]
        },
        "n": {
          "int": [
            3,
            6
          ]
