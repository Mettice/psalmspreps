        },
        {
          "text": "{groupDigits(n, 4)}",
          "misconception": "group-size"
        }
      ],
      "verify": "answer == fmt(n)",
      "misconceptions": [
        {
          "id": "from-left",
          "explain": "Always start grouping from the right, at the units: {groupDigits(n, 3)}."
        },
        {
          "id": "group-size",
          "explain": "Each group has three digits: units, tens, hundreds. Count three digits at a time from the right."
        }
