   "distractors": [
    {
     "text": "{frPossWord(p, i, true)}",
     "misconception": "pluriel"
    },
    {
     "text": "{frPossWord((p + 1) % 6, i)}",
     "misconception": "personne"
    },
    {
     "text": "{frPossWord((p + 2) % 6, i)}",
     "misconception": "personne"
    },
    {
     "text": "{frFeminine(i) && !frVowel(i) ? frPossWord(p, 0) : frPossWord(p, 6)}",
     "misconception": "genre",
     "when": "p < 3"
    }
   ],
   "misconceptions": [
    {
     "id": "pluriel",
     "explain": "« {frNoun(i)} » est au singulier."
    },
    {
     "id": "personne",
     "explain": "Ce possessif n’est pas pour « {frOwner(p)} »."
    },
    {
     "id": "genre",
     "explain": "« {frNoun(i)} » est {frGender(i)}{frVowel(i) ? ' et commence par une voyelle' : ''}."
    }
   ],
   "solution": [
    "« {frNoun(i)} » est {frGender(i)}, singulier ; la chose est {frOwner(p)}.",
    "On écrit : {frPoss(p, i)}."
   ]
  },
