 "note": {
  "status": "draft",
  "text": "Humanisation (hominisation) is the long process by which humans developed, over millions of years. Dates are estimates:\n• Sahelanthropus (Toumaï, Chad): about 7 million years ago;\n• Australopithecus (“Lucy”, Ethiopia): about 3.2 million years ago; walked upright, small brain;\n• Homo habilis (“handy man”): about 2.4 million years ago; made the first simple stone tools;\n• Homo erectus (“upright man”): about 1.9 million years ago; used fire, travelled out of Africa;\n• Homo sapiens (“wise man”): about 300 000 years ago; modern humans.\nMain changes: walking upright on two legs, freeing the hands; a bigger brain; making better tools; using fire; language; living in organised groups.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {},
  "problem": "Put these in order, oldest first: Homo erectus, Australopithecus, Homo sapiens.",
  "steps": [
   "Australopithecus: {ago(homininAgo(1))}.",
   "Homo erectus: {ago(homininAgo(3))}.",
   "Homo sapiens: {ago(homininAgo(4))}."
  ],
  "answer": "Australopithecus → Homo erectus → Homo sapiens.",
  "checks": []
 },
