   {
    "id": "c15-1",
    "status": "draft",
    "idea": "The Present Perfect links a past action to now. Form: have or has + the past participle.",
    "vars": {},
    "example": [
     "I have {participle('finish')} my homework. (It is done now.)",
     "Ayuk has {participle('lose')} his pen. (He does not have it now.)"
    ],
    "checks": [],
    "check": {
     "ref": "e15-havehas"
    }
   },
