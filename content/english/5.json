 "questions": [
  {
   "id": "e5-timetable",
   "type": "mcq",
   "level": 1,
   "review": "rule",
   "sources": [
    "reading"
   ],
   "vars": {
    "day": {
     "pick": [
      "Monday",
      "Tuesday",
      "Wednesday",
      "Thursday",
      "Friday"
     ]
    },
    "times": {
     "expr": "['7:30', '8:30', '9:30', '10:30', '11:30']"
    },
    "subs": {
     "sample": [
      "['Mathematics', 'English', 'French', 'Biology', 'History', 'Geography', 'Computer Science', 'Physics', 'Chemistry', 'Citizenship', 'Sports']",
      5
     ]
    },
    "k": {
     "int": [
      0,
      4
     ]
    }
   },
   "prompt": "Form One timetable for {day}:\n{timetable(times, subs)}\nWhich lesson is at {times[k]}?",
   "correct": "{subs[k]}",
   "distractors": [
    {
     "text": "{subs[(k + 1) % 5]}",
     "misconception": "row"
    },
    {
     "text": "{subs[(k + 2) % 5]}",
     "misconception": "row"
    },
    {
     "text": "{subs[(k + 4) % 5]}",
     "misconception": "row"
    }
   ],
   "misconceptions": [
    {
     "id": "row",
     "explain": "That lesson is at another time. Find {times[k]} first, then read across."
    }
   ],
   "solution": [
    "Find {times[k]} in the timetable.",
    "Read across: at {times[k]} the lesson is {answer}."
   ]
  },
