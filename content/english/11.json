 "skills": [
  {
   "id": "e11",
   "name": "The Simple Past tense"
  }
 ],
 "note": {
  "status": "draft",
  "text": "We use the Simple Past tense for actions that finished in the past: yesterday, last week, last year, two days ago.\nRegular verbs add -ed: walk → walked, cook → cooked. Spelling: like → liked, carry → carried, stop → stopped, travel → travelled.\nIrregular verbs have their own past form: go → went, eat → ate, buy → bought, see → saw, take → took. Learn them by heart.\nThe past form is the same for every subject: I went, she went, they went. (Be: I, he, she, it was; we, you, they were.)\nNegative: didn't + the verb (no -ed): “Ayuk didn't go to school yesterday.” (Not: didn't went.)\nQuestion: Did + subject + the verb? “Did you see the match?” Short answers: “Yes, I did.” “No, I didn't.”",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "n": "Ebai",
   "v": "travel",
   "c": "to Douala",
   "w": "go"
  },
  "problem": "Put the verbs in the Simple Past: “Last week, {n} ({v}) {c}. He ({w}) by bus.”",
  "steps": [
   "{v} is regular. After one vowel, British English doubles the final l: {v} → {past(v)}.",
   "{w} is irregular: its past form is {past(w)}.",
   "The past form is the same for every subject."
  ],
  "answer": "Last week, {n} {past(v)} {c}. He {past(w)} by bus.",
  "checks": [
   "past(v) == 'travelled'",
   "past(w) == 'went'"
  ]
 },
