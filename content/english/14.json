 "skills": [
  {
   "id": "e14",
   "name": "Forming new words: conversion and compounding"
  }
 ],
 "note": {
  "status": "draft",
  "text": "We can make new words from old ones.\nCompounding: join two words to make a new word: foot + ball → football; air + port → airport; motor + bike → motorbike; rail + way → railway; bus + stop → bus stop; taxi + driver → taxi driver.\nSome compounds are written as one word (airport), some as two words (bus stop), and a few with a hyphen (mother-in-law). A dictionary tells you which.\nConversion: the same word changes its job in the sentence, but its spelling does not change.\n• “We walk to school.” (walk is a verb: an action.)\n• “It is a long walk to school.” (walk is a noun: a thing; it can take a or the.)\nOther examples: drink, ride, text, phone, park, water.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "a": "bus",
   "b": "stop",
   "c": "rail",
   "d": "way",
   "w": "ride"
  },
  "problem": "Make compound words from {a} + {b} and {c} + {d}. Then use “{w}” as a verb and as a noun.",
  "steps": [
   "{a} + {b} → {a} {b}: this compound is written as two words.",
   "{c} + {d} → {c}{d}: this compound is written as one word.",
   "As a verb (an action): “Ayuk can {w} a motorbike.”",
   "As a noun (a thing, after a or the): “The {w} to Buea was bumpy.”"
  ],
  "answer": "{a} {b}, {c}{d}; “Ayuk can {w} …” (verb), “The {w} …” (noun).",
  "checks": []
 },
 "teach": {
