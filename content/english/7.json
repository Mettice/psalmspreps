 "skills": [
  {
   "id": "e7",
   "name": "The Present continuous tense"
  }
 ],
 "note": {
  "status": "draft",
  "text": "We use the Present continuous tense for actions happening now, at the moment of speaking: “Look! Bih is carrying a basin of water.”\nForm: am / is / are + verb-ing. I am reading. She is cooking. They are playing.\nSpelling of -ing: most verbs add -ing (read → reading); drop a final e (make → making); double the last letter after one short vowel (run → running, sit → sitting); ie becomes y (lie → lying).\nNegative: am not / isn't / aren't + verb-ing: “Ayuk isn't sleeping.”\nQuestion: Am / Is / Are + subject + verb-ing? “Are you listening?” Short answers: “Yes, I am.” “No, it isn't.”\nSignal words: now, at the moment, Look!, Listen!\nCompare: “Mih sells oranges every day.” (a habit: Simple Present) and “Mih is selling oranges now.” (now: Present continuous)",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "n": "Ndi",
   "v": "make",
   "c": "puff-puff"
  },
  "problem": "{n} is in the kitchen with a bowl of dough. Say what she is doing now: ({v}) {c}.",
  "steps": [
   "{n} is one person (she), so we use is.",
   "{v} ends in e: drop the e and add -ing: {ing(v)}.",
   "Put it together: {n} is {ing(v)} {c}."
  ],
  "answer": "{n} is {ing(v)} {c} now.",
  "checks": [
   "ing(v) == 'making'"
  ]
 },
