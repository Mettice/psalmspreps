 "skills": [
  {
   "id": "e3",
   "name": "The Simple Present tense"
  }
 ],
 "note": {
  "status": "draft",
  "text": "We use the Simple Present tense for habits and for things that are always true: “I go to school every day.” “The sun rises in the east.”\nAffirmative: I, you, we, they + verb: “We sweep the yard.” He, she, it + verb + s: “Bih sweeps the yard.” Spelling: wash → washes, go → goes, carry → carries, have → has.\nNegative: don't or doesn't + verb: “I don't drink coffee.” “Ayuk doesn't play football.” (Not: doesn't plays.)\nInterrogative (a question): Do or Does + subject + verb: “Do you like fufu?” “Does Mih sell oranges?” Short answers: “Yes, I do.” “No, she doesn't.”\nSignal words: every day, always, usually, often, sometimes, never, on Saturdays.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "n": "Tabe",
   "v": "sweep",
   "c": "the classroom",
   "t": "every Monday"
  },
  "problem": "{n} {thirdPerson(v)} {c} {t}. Write this sentence in the negative and as a question.",
  "steps": [
   "{n} is one person (he), so the affirmative verb has -s: {n} {thirdPerson(v)} {c} {t}.",
   "Negative: doesn't + the verb without -s: {n} doesn't {v} {c} {t}.",
   "Question: Does + subject + the verb without -s: Does {n} {v} {c} {t}?"
  ],
  "answer": "{n} doesn't {v} {c} {t}. / Does {n} {v} {c} {t}?",
  "checks": [
   "thirdPerson(v) == 'sweeps'"
  ]
 },
 "teach": {
