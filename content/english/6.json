 "note": {
  "status": "draft",
  "text": "Numbers in words (British English):\n• One to twenty: one, two, … twelve, thirteen, … nineteen, twenty. Careful: four but forty; nine, nineteen but ninety; twelve.\n• Twenty-one to ninety-nine: the tens and the units are joined with a hyphen: twenty-one, forty-five, ninety-nine.\n• After hundred, say “and”: three hundred and five; two thousand four hundred and five.\n• Ordinal words show position: first, second, third, fourth, fifth, eighth, ninth, twelfth, twentieth, twenty-first.\n• Money: 2500 FCFA is read “two thousand five hundred francs”.\nIn figures, a 4-digit number has no space (2500); bigger numbers have a space between the groups: 12 500.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "n": 2405,
   "th": 2,
   "rest": 405
  },
  "problem": "Write {n} in words.",
  "steps": [
   "Split the number: {th} thousands and {rest}.",
   "The thousands: {words(th)} thousand.",
   "The rest: {rest} is {words(rest)}. After hundred we say “and”.",
   "Put them together, with no commas."
  ],
  "answer": "{words(n)}",
  "checks": [
   "th * 1000 + rest == n",
   "words(n) == 'two thousand four hundred and five'"
  ]
 },
