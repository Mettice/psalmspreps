 "skills": [
  {
   "id": "e10",
   "name": "Countable and uncountable nouns"
  }
 ],
 "note": {
  "status": "draft",
  "text": "Countable nouns are things we can count one by one: one orange, two oranges; a bucket, three buckets. They have a plural and can take a or an.\nUncountable nouns cannot be counted one by one: rice, water, salt, oil, sugar, sand, money, bread, advice. They have no plural and do not take a or an. We say some rice, a lot of water.\nTo count them, use a unit: a bag of rice, a bottle of oil, a bucket of water, a loaf of bread, a packet of salt, a bar of soap.\nHow many + countable: How many oranges? How much + uncountable: How much rice?\nA few + countable: a few eggs. A little + uncountable: a little salt.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "a": "egg",
   "b": "salt"
  },
  "problem": "Complete the questions with many or much: “How ___ {plural(a)} are in the basket?” “How ___ {b} do we need?”",
  "steps": [
   "{cap(a)} is countable: one {a}, two {plural(a)}. Countable nouns take many.",
   "{cap(b)} is uncountable: we cannot say two {b}s. Uncountable nouns take much."
  ],
  "answer": "How many {plural(a)} are in the basket? How much {b} do we need?",
  "checks": [
   "plural(a) == 'eggs'"
  ]
 },
