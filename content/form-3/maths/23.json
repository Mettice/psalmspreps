   "adj A: swap {A[0][0]} and {A[1][1]}, change the signs of {A[0][1]} and {A[1][0]}.",
   "adj A = {matStr(adj2(A))}."
  ],
  "answer": "|A| = {det2(A)}, adj A = {matStr(adj2(A))}",
  "checks": [
   "det2(A) == 14"
  ],
