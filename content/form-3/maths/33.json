     "misconceptions": [
      {
       "id": "add",
       "explain": "log a + log b is log (ab), not log (a + b)."
      },
      {
       "id": "sub",
       "explain": "log a − log b is log (a ÷ b): divide by {r}."
      },
      {
       "id": "mult",
       "explain": "Subtracting a log divides by the number: ÷ {r}, not × {r}."
      }
     ],
     "solution": [
      "Adding logs multiplies: log {p} + log {q} = log {p * q}.",
      "Subtracting divides: log {p * q} − log {r} = log ({p * q} ÷ {r}) = {answer}."
     ],
     "where": [
      "(p * q) % r == 0",
      "p * q / r != p + q - r",
      "p * q / r != p * q - r",
      "p + q - r > 0",
      "p * q - r != p + q - r"
     ]
    }
   },
