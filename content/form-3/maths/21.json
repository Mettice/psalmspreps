    ],
    [
     -2,
     0
    ]
   ]
  },
  "problem": "Given A and B in the figure, find {2}A − B.",
  "steps": [
   "{2}A = {matStr(matScale(2, A))}: every element doubled.",
   "{2}A − B: subtract corresponding elements.",
   "{2 * A[0][0]} − {B[0][0]} = {2 * A[0][0] - B[0][0]}, {2 * A[0][1]} − {B[0][1]} = {2 * A[0][1] - B[0][1]}, {2 * A[1][0]} − {br(B[1][0])} = {2 * A[1][0] - B[1][0]}, {2 * A[1][1]} − {B[1][1]} = {2 * A[1][1] - B[1][1]}."
  ],
  "answer": "{2}A − B = {matStr(matSub(matScale(2, A), B))}",
  "checks": [
   "2 * A[0][1] - B[0][1] == -6"
  ],
  "figure": "matFig([['A', A], ['B', B]])"
 },
