 "skills": [
  {
   "id": "m3-21",
   "name": "Add and subtract matrices; multiply by a scalar"
  }
 ],
 "note": {
  "status": "draft",
  "text": "• Add or subtract matrices of the same order by adding or subtracting corresponding elements.\n• Matrices of different orders cannot be added or subtracted.\n• Scalar multiplication: kA multiplies every element of A by the number k.\n• Combine them: 2A − 3B means double every element of A, triple every element of B, then subtract.\n• Matrix equations: A + X = B gives X = B − A.",
  "checks": []
 },
 "learn": {
  "status": "draft",
  "vars": {},
  "sections": [
   {
    "heading": "Adding element by element",
    "text": "To add two matrices, add the elements in the same position. The answer has the same order.\n{matStr([[1, 2], [3, 4]])} + {matStr([[5, 0], [1, 2]])} = {matStr([[6, 2], [4, 6]])}.\nSubtracting works the same way. Each element needs a partner in the same position, so the two matrices must have the same order. A {2} × {2} and a {2} × {3} matrix cannot be added."
   },
   {
    "heading": "Multiplying by a number",
    "text": "A scalar is an ordinary number. kA means multiply every element of A by k:\n{3} × {matStr([[2, -1], [0, 4]])} = {matStr([[6, -3], [0, 12]])}.\nIf two shops have the same price list matrix and prices rise by a factor, every price is multiplied: that is scalar multiplication."
   },
   {
    "heading": "Combining and solving",
    "text": "For {2}A − B, first double every element of A, then subtract B element by element.\nMatrix equations work like ordinary equations: A + X = B gives X = B − A, and {2}X = C gives X = ½C.\nAlways keep track of positions: row first, then column."
   }
  ],
  "key_words": [
   {
    "word": "corresponding elements",
    "meaning": "elements in the same row and column of two matrices"
   },
   {
    "word": "scalar",
    "meaning": "an ordinary number that multiplies a matrix"
   },
   {
    "word": "same order",
    "meaning": "the same number of rows and the same number of columns"
   }
  ],
  "examples": [
   "{matStr([[4, 1], [2, 0]])} − {matStr([[1, 3], [2, 5]])} = {matStr([[3, -2], [0, -5]])}",
   "{-2} × {matStr([[1, -3]])} = {matStr([[-2, 6]])}"
  ],
  "mistake": {
   "wrong": "{2} × {matStr([[1, 3], [4, 2]])} = {matStr([[2, 3], [4, 2]])}",
   "right": "{2} × {matStr([[1, 3], [4, 2]])} = {matStr([[2, 6], [8, 4]])}",
   "why": "A scalar multiplies every element, not just the first one."
  }
 },
 "worked_example": {
