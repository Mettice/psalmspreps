 "skills": [
  {
   "id": "k3-6",
   "name": "Relative atomic mass and the mole of atoms"
  }
 ],
 "note": {
  "status": "draft",
  "text": "Chemists count atoms by weighing them. A mole (mol) of atoms of an element is its relative atomic mass in grams:\n• 1 mol of carbon (C = 12) has a mass of 12 g; 1 mol of magnesium (Mg = 24) has a mass of 24 g.\n• This mass per mole is the molar mass, in g/mol.\nFormulas: number of moles = mass ÷ molar mass; mass = moles × molar mass.\nExample: 48 g of magnesium = 48 ÷ 24 = 2 mol.",
  "checks": []
 },
 "learn": {
  "status": "draft",
  "vars": {},
  "sections": [
   {
    "heading": "Counting by weighing",
    "text": "Atoms are far too small to count one by one. Market traders in Mokolo sell rice by the cup or the bag, not grain by grain; chemists count atoms by weighing them.\nThe unit chemists use for 'a certain number of particles' is the mole (mol)."
   },
   {
    "heading": "What a mole of atoms weighs",
    "text": "One mole of atoms of an element has a mass equal to its relative atomic mass in grams.\n• C = {12}: {1} mol of carbon atoms is {12} g.\n• Mg = {24}: {1} mol is {24} g.\n• Fe = {56}: {1} mol is {56} g.\nThis mass per mole is the molar mass (g/mol). One mole of any element contains the same number of atoms."
   },
   {
    "heading": "Two formulas",
    "text": "• moles = mass ÷ molar mass: {48} g of magnesium is {48} ÷ {24} = {2} mol.\n• mass = moles × molar mass: {0.5} mol of iron is {0.5} × {56} = {28} g.\nTo compare numbers of atoms in two samples, compare their moles, not their masses: {12} g of carbon has more atoms than {32} g of sulphur? Both are {1} mol, so they have the same number."
   }
  ],
  "key_words": [
   {
    "word": "mole (mol)",
    "meaning": "the chemist's unit for an amount of particles"
   },
   {
    "word": "molar mass",
    "meaning": "the mass of {1} mol, in g/mol: the RAM in grams"
   }
  ],
  "examples": [
   "{36} g of carbon = {3} mol",
   "{0.25} mol of calcium = {10} g",
   "{56} g of iron and {12} g of carbon: both {1} mol"
  ],
  "mistake": {
   "wrong": "{48} g of Mg = {48} × {24} mol",
   "right": "{48} g of Mg = {48} ÷ {24} = {2} mol",
   "why": "Divide the mass by the molar mass to get moles."
  }
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "r": 24,
   "m": 60
  },
  "problem": "How many moles of magnesium atoms are in {m} g of magnesium? (Mg = {r})",
  "steps": [
   "Molar mass of Mg = {r} g/mol.",
   "Moles = mass ÷ molar mass = {m} ÷ {r} = {m / r} mol."
  ],
  "answer": "{m / r} mol",
  "checks": [
   "m / r == 2.5"
  ]
 },
