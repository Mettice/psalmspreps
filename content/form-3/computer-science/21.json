   "prompt": "What is output? mark ← {m}; IF mark >= {p} THEN OUTPUT 'Pass' ELSE OUTPUT 'Fail' ENDIF",
   "correct": "{traceIf(m, p - 1, 'Pass', 'Fail')}",
   "distractors": [
    {
     "text": "{traceIf(m, p - 1, 'Fail', 'Pass')}",
     "misconception": "flip"
    },
    {
     "text": "{str(m)}",
     "misconception": "mark"
    },
    {
     "text": "{'Pass Fail'}",
     "misconception": "both"
    }
   ],
   "misconceptions": [
    {
     "id": "flip",
     "explain": "Check the condition: {m} >= {p} is {m >= p ? 'true' : 'false'}."
    },
    {
     "id": "mark",
     "explain": "The mark itself is not output; only Pass or Fail."
    },
    {
     "id": "both",
     "explain": "Only one branch of IF … ELSE runs."
    }
   ],
   "solution": [
    "Is {m} >= {p}? {m >= p ? 'Yes' : 'No'}.",
    "So {answer} is output."
   ]
