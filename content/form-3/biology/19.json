  "problem": "Classify maize, a fern and a mango tree.",
  "steps": [
   "Maize: flowering plant with one seed leaf → monocotyledon.",
   "Fern: no flowers or seeds; spores under its leaves → non-flowering (fern).",
   "Mango: flowering plant with two seed leaves → dicotyledon."
  ],
  "answer": "Maize: monocot; fern: non-flowering; mango: dicot",
  "checks": []
 },
