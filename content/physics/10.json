 "note": {
  "status": "draft",
  "text": "Scientists everywhere use the same units: the International System of Units (SI). Some SI base units:\n• length: metre (m) • mass: kilogram (kg) • time: second (s) • temperature: kelvin (K) • electric current: ampere (A).\nOther units come from these: area in m², volume in m³, speed in m/s.\nPrefixes make units bigger or smaller:\n• kilo (k) = 1000: 1 km = 1000 m, 1 kg = 1000 g\n• centi (c) = one hundredth: 1 m = 100 cm\n• milli (m) = one thousandth: 1 m = 1000 mm, 1 g = 1000 mg, 1 L = 1000 mL\nCareful: the SI unit of mass is the kilogram, not the gram.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "v": 2.5,
   "a": "kg",
   "b": "g"
  },
  "problem": "A bag of rice has a mass of {v} {a}. What is its mass in {b}?",
  "steps": [
   "Kilo means one thousand: 1 {a} = {factor(a, b)} {b}.",
   "{v} {a} = {v} × {factor(a, b)} = {convertUnit(v, a, b)} {b}."
  ],
  "answer": "{convertUnit(v, a, b)} {b}",
  "checks": [
   "convertUnit(v, a, b) == 2500"
  ]
 },
