 "note": {
  "status": "draft",
  "text": "Cameroon has ten regions. To compare how crowded they are, calculate each region's population density: population ÷ area.\nAreas are in km². The populations used here are rounded estimates (in thousands) for practice; the latest census figures may differ.\nThe West, Littoral and North-West regions are the most densely populated (small areas, many people, fertile highlands, towns and industries). The East and South are the least dense (large forested areas, few people).\nSteps: (1) change the population in thousands to people (× 1000); (2) divide by the area; (3) round to a whole number; (4) rank the regions.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "n": "West",
   "a": 13892,
   "t": 1900,
   "k": 1000
  },
  "problem": "The {n} Region has an area of {a} km² and about {t} thousand people. Calculate its density.",
  "steps": [
   "Population: {t} × {k} = {t * k} people.",
   "Density: {t * k} ÷ {a} = {round(t * k / a, 1)}, about {round(t * k / a)} people per km²."
  ],
  "answer": "About {round(t * k / a)} people per km²",
  "checks": [
   "round(t * k / a) == 137"
  ]
 },
