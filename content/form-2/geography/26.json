   "id": "g2-26",
   "name": "Relationships between towns and the countryside (socio-cultural and information)"
  }
 ],
 "note": {
  "status": "draft",
  "text": "Social and cultural links:\n• families are split between town and village: people go home for funerals, weddings, festivals and holidays;\n• elites from town build schools, health centres and roads in their villages (development associations);\n• townspeople keep their village traditions and languages; villages adopt town fashions, music and foods;\n• country children attend secondary schools and universities in towns.\nInformation links:\n• radio, television, newspapers, phones and the internet carry news, prices and ideas between town and village;\n• mobile money sends money instantly;\n• community radios broadcast in national languages.\nNegative effects: loss of some traditions, spread of diseases, rural exodus of the young.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {},
  "problem": "Give one way in which elites living in town help their home village.",
  "steps": [
   "Elites often join a village development association.",
   "They contribute money to build a school, a health centre or a water point in the village."
  ],
  "answer": "They fund schools, health centres or water points through development associations.",
  "checks": []
 },
