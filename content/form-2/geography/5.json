 "note": {
  "status": "draft",
  "text": "People are not spread evenly over the Earth. Population density is the average number of people per square kilometre:\ndensity = population ÷ area (people per km²).\nDensely populated areas: East Asia (eastern China, Japan), South Asia (India, Bangladesh), Western Europe, the north-east of the USA, the Nile valley, the coast of West Africa (southern Nigeria).\nSparsely populated areas: hot deserts (Sahara), cold lands (Greenland, Siberia, Antarctica, which has no permanent population), high mountains, dense equatorial forests (Amazon, Congo basin).\nMost people live in the Northern Hemisphere and less than a third of the land holds most of the people.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "p": 600000,
   "a": 4000
  },
  "problem": "A district has {p} people and an area of {a} km². What is its population density?",
  "steps": [
   "Density = population ÷ area.",
   "{p} ÷ {a} = {p / a} people per km²."
  ],
  "answer": "{p / a} people per km²",
  "checks": [
   "p / a == 150"
  ]
 },
