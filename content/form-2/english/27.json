 "note": {
  "status": "draft",
  "text": "Every verb has three main forms: the base (go), the simple past (went) and the past participle (gone), used after have, has and had.\nRegular verbs add -ed for both: visit, visited, visited. Spelling: stop → stopped, carry → carried, arrive → arrived, travel → travelled.\nIrregular verbs change in their own way, and must be learnt:\n• all three the same: put, put, put; cut, cut, cut;\n• past = participle: buy, bought, bought; bring, brought, brought; leave, left, left;\n• all three different: go, went, gone; see, saw, seen; write, wrote, written; begin, began, begun; speak, spoke, spoken.\nUse the simple past alone (I saw), and the participle after have, has or had (I have seen, she had gone).",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "v": "write",
   "w": "visit"
  },
  "problem": "Give the three forms of {v} and {w}, and use the participle of {v} in a sentence.",
  "steps": [
   "{w} is regular: {w}, {past(w)}, {participle(w)}.",
   "{v} is irregular: {v}, {past(v)}, {participle(v)}.",
   "After has: “Bih has {participle(v)} a letter to her uncle.”"
  ],
  "answer": "{w}, {past(w)}, {participle(w)}; {v}, {past(v)}, {participle(v)}",
  "checks": [
   "participle(v) == 'written'"
  ]
 },
