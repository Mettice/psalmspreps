  {
   "id": "e2-11",
   "name": "The Simple Past tense"
  }
 ],
 "note": {
  "status": "draft",
  "text": "We use the Simple Past for finished actions at a time in the past: yesterday, last week, in 2020, two days ago.\nRegular verbs add -ed: visit → visited, stay → stayed, stop → stopped, carry → carried, arrive → arrived.\nIrregular verbs have their own past forms: go → went, take → took, see → saw, feel → felt, buy → bought, catch → caught, drink → drank.\nThe past form is the same for every person: I went, she went, they went.\nNegative: didn't + the base verb: “She didn't go to school.” (not: didn't went)\nQuestions: Did + subject + base verb: “Did you take the medicine?” — “Yes, I did.”\nBe: I/he/she/it was; you/we/they were.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "n": "Ndi",
   "v": "catch",
   "c": "malaria",
   "t": "last month"
  },
  "problem": "Write in the Simple Past, then make it negative and a question: {n} / {v} / {c} / {t}.",
  "steps": [
   "{v} is irregular: its past is {past(v)}. {n} {past(v)} {c} {t}.",
   "Negative: didn't + the base verb: {n} didn't {v} {c} {t}.",
   "Question: Did + subject + base verb: Did {n} {v} {c} {t}?"
  ],
  "answer": "{n} {past(v)} {c} {t}. / {n} didn't {v} {c} {t}. / Did {n} {v} {c} {t}?",
  "checks": [
   "past(v) == 'caught'"
  ]
 },
