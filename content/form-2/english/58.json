 "note": {
  "status": "draft",
  "text": "• Capital letter: at the start of a sentence and for proper nouns.\n• Full stop (.): at the end of a statement.\n• Question mark (?): at the end of a direct question.\n• Exclamation mark (!): after a strong feeling or a sharp order: What a dirty street! Stop!\n• Comma (,): between items in a list (paper, plastic and glass), after an introductory word (However, …), around a name in direct address (Ayuk, come here.).\n• Apostrophe (’): for a missing letter (don't, it's = it is) and for possession (the council's trucks, the youths' campaign).",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {},
  "problem": "Punctuate: “ayuk did you see the councils truck it didnt come”",
  "steps": [
   "Capital A; comma after the name in direct address; question mark.",
   "Possession: council's; contraction: didn't."
  ],
  "answer": "Ayuk, did you see the council's truck? It didn't come.",
  "checks": []
 },
