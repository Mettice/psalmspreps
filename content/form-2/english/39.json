   "id": "e2-39",
   "name": "Abbreviations and acronyms"
  }
 ],
 "note": {
  "status": "draft",
  "text": "An abbreviation is a short form of a word or a group of words: Dr (Doctor), Mr (Mister), km (kilometre), e.g. (for example), i.e. (that is), etc. (and so on).\nAn initialism is made of first letters, each letter said separately: UN (United Nations), WHO (World Health Organization), NGO, GCE.\nAn acronym is made of first letters but read as one word: UNICEF (/ˈjuːnɪsef/), AIDS, NATO.\nWrite abbreviations of organisations in capital letters; use them only after the full name has been written once in a formal text.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {},
  "problem": "What do WHO and e.g. stand for, and how are they read?",
  "steps": [
   "WHO = World Health Organization: we say each letter, W-H-O.",
   "e.g. = for example (from Latin); we say “for example”."
  ],
  "answer": "World Health Organization; for example",
  "checks": []
 },
