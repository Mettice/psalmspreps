 "note": {
  "status": "draft",
  "text": "Silent c:\n• after s before e, i or y: scene, science, scissors, scent, muscle, fascinate.\nSilent l:\n• before k: walk, talk, chalk, folk, yolk;\n• before f, m: half, calf, calm, palm, salmon;\n• in could, should, would.\nBe careful: in “film”, “milk” and “help” the l IS pronounced.\nLearn these spellings well: you cannot hear the silent letter.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {},
  "problem": "Which letter is silent in “scissors” and in “chalk”?",
  "steps": [
   "In “scissors”, the c after s is not pronounced.",
   "In “chalk”, the l before k is not pronounced."
  ],
  "answer": "c in scissors; l in chalk",
  "checks": []
 },
