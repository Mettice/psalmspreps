  {
   "id": "e2-79",
   "name": "Adverbs of time, place and manner"
  }
 ],
 "note": {
  "status": "draft",
  "text": "An adverb tells us more about a verb.\n• Adverbs of time answer “When?”: now, today, yesterday, tomorrow, soon, later, already, early, late.\n• Adverbs of place answer “Where?”: here, there, everywhere, outside, inside, upstairs, nearby, abroad.\n• Adverbs of manner answer “How?”: carefully, quickly, slowly, clearly, well, badly, hard. Many are made from adjectives + -ly: careful → carefully; easy → easily.\nOrder when there are several: manner, place, time: “She worked hard at the hospital yesterday.”",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {},
  "problem": "In “The nurse spoke kindly to the patients yesterday”, find the adverbs and say what they tell us.",
  "steps": [
   "“kindly” answers How did she speak? — manner.",
   "“yesterday” answers When? — time."
  ],
  "answer": "kindly (manner), yesterday (time)",
  "checks": []
 },
