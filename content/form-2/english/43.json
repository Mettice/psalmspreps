 "note": {
  "status": "draft",
  "text": "The imperative gives orders, instructions, advice or warnings. It uses the bare infinitive, usually without a subject: Wash your hands. Take two tablets a day.\nNegative: Don't (Do not) + verb: Don't drink dirty water.\nPolite requests: add please or use Let's for suggestions: Please sit down. Let's go to the clinic.\nHealth instructions are often imperatives: Shake well before use. Keep out of reach of children. Do not exceed the stated dose.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {},
  "problem": "Turn these into imperatives: “You should wash your hands.” “You must not touch the wound.”",
  "steps": [
   "Use the bare verb at the start: Wash your hands.",
   "Negative: Don't touch the wound."
  ],
  "answer": "Wash your hands. Don't touch the wound.",
  "checks": []
 },
