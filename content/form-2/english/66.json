 "note": {
  "status": "draft",
  "text": "A syllable is a part of a word with one vowel sound. Clap as you say the word: each clap is a syllable.\ntree (1), for-est (2), en-er-gy (3), en-vi-ron-ment (4).\nCount vowel SOUNDS, not vowel letters: “drought” has two vowel letters but one sound, so one syllable; a silent final e does not count (cli-mate).\nDividing words into syllables helps with spelling and with breaking a word at the end of a line (use a hyphen between syllables: envi-ronment).",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {},
  "problem": "How many syllables in “temperature” and “greenhouse”?",
  "steps": [
   "Clap: tem-per-a-ture → four claps.",
   "green-house → two claps."
  ],
  "answer": "four; two",
  "checks": []
 },
