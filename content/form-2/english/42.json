   "id": "e2-42",
   "name": "Affixes: prefixes and suffixes"
  }
 ],
 "note": {
  "status": "draft",
  "text": "An affix is a group of letters added to a word to make a new word.\n• A prefix goes at the beginning and often changes the meaning: un- (unhappy), dis- (dishonest), im- (impossible), in- (incorrect), re- (again: rewrite), mis- (wrongly: misunderstand), pre- (before: prepay).\n• A suffix goes at the end and often changes the class of word: -ful (careful), -less (without: hopeless), -ment (treatment), -ness (illness), -er / -ist (a person: teacher, scientist).\nHealth words with affixes: unhealthy, illness, treatment, careless, painful, painless.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {},
  "problem": "Make words from “health” and “treat” with affixes.",
  "steps": [
   "health + -y = healthy; un- + healthy = unhealthy.",
   "treat + -ment = treatment; mis- + treat = mistreat."
  ],
  "answer": "healthy, unhealthy, treatment, mistreat",
  "checks": []
 },
