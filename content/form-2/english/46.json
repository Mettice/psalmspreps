   "id": "e2-46",
   "name": "Masculine, feminine, neuter and common gender"
  }
 ],
 "note": {
  "status": "draft",
  "text": "Nouns have gender:\n• masculine: male persons or animals — postman, king, uncle, bull, cock;\n• feminine: female — postwoman, queen, aunt, cow, hen;\n• neuter: things with no sex — letter, parcel, stamp, post office;\n• common: either male or female — teacher, doctor, clerk, child, parent, friend.\nFeminine forms are made with -ess (waiter → waitress, host → hostess), with another word (postman → postwoman), or are a different word (king → queen, nephew → niece).",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {},
  "problem": "Give the gender of: clerk, queen, parcel, bull.",
  "steps": [
   "clerk: male or female → common.",
   "queen: female → feminine.",
   "parcel: a thing → neuter.",
   "bull: a male animal → masculine."
  ],
  "answer": "common, feminine, neuter, masculine",
  "checks": []
 },
