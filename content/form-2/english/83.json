   "id": "e2-83",
   "name": "Silent letters: b and p"
  }
 ],
 "note": {
  "status": "draft",
  "text": "Some letters are written but not pronounced: they are silent.\nSilent b:\n• after m at the end of a word: climb, comb, thumb, lamb, bomb, tomb, limb, numb;\n• before t: debt, doubt, subtle.\nNote: climber, plumber, bomber keep the silent b.\nSilent p:\n• at the start before s or n: psychology, psalm, pneumonia;\n• in: receipt, cupboard, raspberry.\nLearn to spell these words carefully: you cannot hear the silent letter.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {},
  "problem": "Which letter is silent in “climb” and in “receipt”?",
  "steps": [
   "In “climb”, the b after m at the end is not pronounced.",
   "In “receipt”, the p is not pronounced."
  ],
  "answer": "b in climb; p in receipt",
  "checks": []
 },
