 "note": {
  "status": "draft",
  "text": "Synonyms are words with the same or nearly the same meaning: big and large, start and begin, quick and fast, happy and glad.\nWe use synonyms so as not to repeat the same word, and to choose the best word for the situation.\nSome synonyms are more formal: buy → purchase, help → assist, enough → sufficient, end → finish or conclude.\nSynonyms are not always used in the same way: we say “a big brother”, not “a large brother”; “fast food”, not “quick food”.\nAntonyms are opposites: big and small, start and finish. Do not mix them up with synonyms.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "a": "big",
   "b": "large",
   "c": "begin"
  },
  "problem": "Rewrite the sentence without repeating a word: “The big market has a big hall, and the market starts early.”",
  "steps": [
   "Replace the second big with its synonym: {b}.",
   "Replace starts with a synonym: {thirdPerson(c)}.",
   "“The big market has a {b} hall, and it {thirdPerson(c)} early.”"
  ],
  "answer": "The big market has a {b} hall, and it {thirdPerson(c)} early.",
  "checks": []
 },
