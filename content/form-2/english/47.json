   "id": "e2-47",
   "name": "Common and proper nouns"
  }
 ],
 "note": {
  "status": "draft",
  "text": "A common noun names any person, place or thing of a kind: town, post office, river, month, teacher. It starts with a small letter (except at the start of a sentence).\nA proper noun names one particular person, place or thing: Nkeng, Kumbo, the Wouri, January, Monday, Cameroon, CAMPOST. It always starts with a capital letter.\nDays, months, countries, towns, rivers, mountains, people's names and the names of organisations are proper nouns.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {},
  "problem": "Find the proper nouns: “Last january, nkeng sent a parcel from buea to her aunt in kumbo.”",
  "steps": [
   "Names of a month, a person and towns are proper nouns.",
   "January, Nkeng, Buea, Kumbo need capital letters."
  ],
  "answer": "January, Nkeng, Buea, Kumbo",
  "checks": []
 },
