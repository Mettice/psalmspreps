  {
   "id": "e2-63",
   "name": "The indefinite and definite articles"
  }
 ],
 "note": {
  "status": "draft",
  "text": "Indefinite articles: a / an, for one thing that is not yet known: a robot, an invention.\nUse an before a vowel SOUND, a before a consonant SOUND: an engineer, an hour (h is silent), an honest man; but a university, a uniform, a European (they start with the sound /j/), a one-way street.\nDefinite article: the, for something already known or the only one: I saw a robot. The robot was carrying medicine. The sun, the internet, the best doctor.\nNo article before most uncountable nouns used in general (Science is useful) or before names of people, towns and countries (Cameroon, Buea).",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {},
  "problem": "Choose a or an: ___ hour, ___ university, ___ engineer.",
  "steps": [
   "Listen to the first sound: hour starts with a vowel sound (h is silent) → an.",
   "university starts with /j/ → a. engineer starts with a vowel sound → an."
  ],
  "answer": "an hour, a university, an engineer",
  "checks": []
 },
