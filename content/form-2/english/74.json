 "note": {
  "status": "draft",
  "text": "Causes: pollutants, exhaust fumes, smoke, sewage, chemicals, pesticides, litter, plastic, noise.\nConsequences: toxic (poisonous) water, contaminated food, diseases (asthma, cholera), global warming, loss of fish and wildlife.\nPrevention: to recycle, to reduce, to reuse, to treat waste water, to plant trees, biodegradable bags, to raise awareness.\nThe three Rs: reduce (use less), reuse (use again), recycle (make new things from waste).",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {},
  "problem": "Sort into cause, consequence, prevention: sewage, asthma, recycling.",
  "steps": [
   "Sewage pollutes water: a cause.",
   "Asthma is an illness: a consequence.",
   "Recycling reduces waste: prevention."
  ],
  "answer": "cause, consequence, prevention",
  "checks": []
 },
