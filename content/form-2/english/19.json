 "skills": [
  {
   "id": "e2-19",
   "name": "The Simple Future tense"
  }
 ],
 "note": {
  "status": "draft",
  "text": "We talk about the future in several ways:\n• will + the base verb, for predictions, promises and decisions made now: “It will rain tomorrow.” “I'll call you tonight.” (I'll = I will)\n• am / is / are going to + the base verb, for plans already made and for what we can see coming: “I'm going to buy a phone on Saturday.” “Look at the clouds: it's going to rain.”\n• Shall I / Shall we, for offers and suggestions: “Shall I carry your bag?” “Shall we go?”\nWill is the same for every person: I will, she will, they will.\nNegative: will not = won't: “He won't come.” Questions: “Will you help me?” — “Yes, I will.”\nAfter will, use the base verb: “She will buy”, not “She will buys”.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "n": "Manyi",
   "v": "buy",
   "c": "a new phone",
   "t": "next month"
  },
  "problem": "Write in the future with will, then make it negative and a question: {n} / {v} / {c} / {t}.",
  "steps": [
   "will + the base verb, the same for every person: {n} will {v} {c} {t}.",
   "Negative: won't + the base verb: {n} won't {v} {c} {t}.",
   "Question: Will + subject + the base verb: Will {n} {v} {c} {t}?"
  ],
  "answer": "{n} will {v} {c} {t}. / {n} won't {v} {c} {t}. / Will {n} {v} {c} {t}?",
  "checks": []
 },
