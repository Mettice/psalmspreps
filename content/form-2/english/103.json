  {
   "id": "e2-103",
   "name": "Consolidation: the Simple Past tense"
  }
 ],
 "note": {
  "status": "draft",
  "text": "The Simple Past is used for finished actions at a definite time in the past: yesterday, last week, in 2020, two days ago.\nRegular verbs add -ed: play → played, dance → danced (just -d), stop → stopped (double the consonant), study → studied (y → ied).\nIrregular verbs have special forms: go → went, see → saw, sing → sang, write → wrote, buy → bought, begin → began, win → won, take → took, meet → met.\nNegative: did not (didn't) + base verb: “We didn't see the film.”\nQuestion: Did + subject + base verb: “Did you enjoy the concert?”\nBe: I/he/she/it was; you/we/they were.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "v": "sing"
  },
  "problem": "Write “{v}” in the Simple Past, then make a negative sentence with it.",
  "steps": [
   "“{v}” is irregular: {past(v)}.",
   "Negative: didn't + base verb: “The choir didn't {v} yesterday.”"
  ],
  "answer": "{past(v)}; The choir didn't {v} yesterday.",
  "checks": []
 },
