  {
   "id": "e2-30",
   "name": "Word formation: prefixes and suffixes"
  }
 ],
 "note": {
  "status": "draft",
  "text": "We can make new words by adding a part at the beginning (a prefix) or at the end (a suffix).\nPrefixes change the meaning: un- (unhappy), dis- (disagree), im- (impossible, before m and p), in- (incorrect), re- (rewrite: write again), mis- (misunderstand: understand wrongly).\nSuffixes change the kind of word:\n• verb → noun: celebrate → celebration, govern → government, decorate → decoration, enjoy → enjoyment, sing → singer;\n• adjective → noun: happy → happiness, kind → kindness, free → freedom;\n• noun → adjective: care → careful (with care) or careless (without care), peace → peaceful, joy → joyful, nation → national;\n• adjective → adverb: quick → quickly, happy → happily.\nSpelling: y after a consonant becomes i (happy → happiness), and a final e often drops before -ion (celebrate → celebration).",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "a": "celebrate",
   "b": "peace",
   "c": "kind"
  },
  "problem": "Make a noun from {a}, an adjective from {b} and a noun from {c}, and use them in one sentence.",
  "steps": [
   "{a} + -ion, dropping the e: celebration.",
   "{b} + -ful: peaceful. {c} + -ness: kindness.",
   "“The National Day celebration was peaceful, and everyone showed kindness.”"
  ],
  "answer": "celebration, peaceful, kindness",
  "checks": []
 },
 "teach": {
  "cards": [
