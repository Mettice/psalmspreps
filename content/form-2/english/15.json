 "skills": [
  {
   "id": "e2-15",
   "name": "The Present Perfect tense"
  }
 ],
 "note": {
  "status": "draft",
  "text": "We use the Present Perfect for:\n• past actions whose result matters now: “It has rained, so the ground is wet.”\n• experiences, with ever and never: “Have you ever seen snow?” — “No, I have never seen snow.”\n• actions that started in the past and go on now, with since and for: “It has rained since Monday.” “I have lived here for two years.”\nForm: have / has + past participle. I have seen, she has seen. Participles: visit → visited, see → seen, eat → eaten, write → written, go → gone.\nNegative: haven't / hasn't: “He hasn't finished yet.” Questions: “Have you finished?” — “Yes, I have.”\nSince + a point in time (since Monday, since 2020); for + a length of time (for three days).\nDo not use it with a finished time: say “I saw him yesterday”, not “I have seen him yesterday”.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "n": "Bih",
   "v": "lose",
   "c": "her umbrella"
  },
  "problem": "Write in the Present Perfect, then make it negative and a question: {n} / {v} / {c}.",
  "steps": [
   "{n} is one person: has + the past participle of {v}, {participle(v)}: {n} has {participle(v)} {c}.",
   "Negative: hasn't + participle: {n} hasn't {participle(v)} {c}.",
   "Question: Has + subject + participle: Has {n} {participle(v)} {c}?"
  ],
  "answer": "{n} has {participle(v)} {c}. / {n} hasn't {participle(v)} {c}. / Has {n} {participle(v)} {c}?",
  "checks": [
   "participle(v) == 'lost'"
  ]
 },
