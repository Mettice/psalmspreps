 "skills": [
  {
   "id": "e2-7",
   "name": "The Present Continuous tense"
  }
 ],
 "note": {
  "status": "draft",
  "text": "We use the Present Continuous for actions happening now (“The nurse is checking my temperature”), for things happening around now (“I am reading a book about health this week”) and for plans already fixed (“I am seeing the dentist on Friday”).\nForm: am / is / are + verb-ing. I am waiting. She is waiting. They are waiting.\nSpelling: write → writing, sit → sitting, lie → lying.\nNegative: am not / isn't / aren't + -ing: “He isn't sleeping.”\nQuestion: Am / Is / Are + subject + -ing: “Are you coming?” — “Yes, I am.”\nState verbs (know, like, want, need, believe, own) are not used with -ing: say “I need a doctor”, not “I am needing”.\nSignal words: now, right now, at the moment, today, this week, Look!, Listen!",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "n": "The nurse",
   "v": "take",
   "c": "my temperature"
  },
  "problem": "Write a sentence in the Present Continuous: {n} / {v} / {c} / now. Then make it negative and a question.",
  "steps": [
   "{n} is one person: is + {ing(v)}: {n} is {ing(v)} {c} now.",
   "Negative: isn't + {ing(v)}: {n} isn't {ing(v)} {c} now.",
   "Question: Is + subject + {ing(v)}: Is {low(n)} {ing(v)} {c} now?"
  ],
  "answer": "{n} is {ing(v)} {c} now. / {n} isn't {ing(v)} {c} now. / Is {low(n)} {ing(v)} {c} now?",
  "checks": [
   "ing(v) == 'taking'"
  ]
 },
