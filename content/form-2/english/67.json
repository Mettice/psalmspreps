  {
   "id": "e2-67",
   "name": "Comparison of adjectives: short and long forms"
  }
 ],
 "note": {
  "status": "draft",
  "text": "To compare two things, use the comparative + than; for three or more, the superlative with the.\n• Short adjectives (one syllable): add -er / -est: tall → taller → the tallest. Spelling: big → bigger (double the last letter after one short vowel), large → larger, happy → happier (y → i).\n• Long adjectives (two or more syllables, not ending in -y): more / most: dangerous → more dangerous → the most dangerous.\n• Irregular: good → better → the best; bad → worse → the worst; far → farther → the farthest.\nNever use both: not “more hotter”.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "a": "hot",
   "b": "dangerous"
  },
  "problem": "Compare: “This year is ___ (hot) than last year. Floods are ___ (dangerous) than droughts.”",
  "steps": [
   "hot is short, with one short vowel: double the t: {comparative(a)}.",
   "dangerous is long: {comparative(b)}."
  ],
  "answer": "{comparative(a)}; {comparative(b)}",
  "checks": []
 },
