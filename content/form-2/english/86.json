   "name": "WH- words and their uses"
  }
 ],
 "note": {
  "status": "draft",
  "text": "WH- words ask questions and join sentences:\n• who (a person): Who plays the balafon?\n• whom (a person, as object, formal): To whom did you give the drum?\n• whose (owner): Whose flute is this?\n• what (a thing or action): What is a masquerade?\n• which (a choice): Which song do you prefer?\n• when (time), where (place), why (reason), how (manner), how many / how much (number, amount).\nThey also introduce relative clauses: “The man who plays the drum is my uncle.” “The village where I was born is near Kumbo.”",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {},
  "problem": "Ask the question that has this answer: “The concert starts at eight o'clock.”",
  "steps": [
   "The answer gives a time.",
   "A time question uses “When” (or “What time”): “When does the concert start?”"
  ],
  "answer": "When does the concert start?",
  "checks": []
 },
