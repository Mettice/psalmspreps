  {
   "id": "fi2-47",
   "name": "Identifier les points grammaticaux et les temps verbaux étudiés"
  }
 ],
 "note": {
  "status": "draft",
  "text": "Pour reconnaître le temps d’un verbe, on regarde sa forme :\n• présent : je chante, nous finissons, il fait ;\n• imparfait : terminaisons -ais, -ais, -ait, -ions, -iez, -aient (je chantais, nous finissions) ;\n• passé composé : deux mots, avoir ou être au présent + participe passé (j’ai chanté, elle est venue) ;\n• passé simple : -a, -èrent (il chanta, ils chantèrent) ; -it, -irent (il finit, ils finirent) ; formes irrégulières (il fut, il eut, il fit, il vint).\nRappel des points de grammaire : adjectif épithète ou attribut ; conjonctions de coordination ; expansions du nom ; participe présent et gérondif (en + -ant) ; adverbes de lieu et de manière.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "v": "venir",
   "p": 6
  },
  "problem": "À quel temps est « {fr2Form(v, p, 'passé simple')} » ?",
  "steps": [
   "Un seul mot : ce n’est pas le passé composé.",
   "La terminaison n’est pas -aient : ce n’est pas l’imparfait.",
   "« vinrent » est la forme irrégulière de « venir » au passé simple."
  ],
  "answer": "au passé simple",
  "checks": []
 },
