   "id": "fi2-74",
   "name": "Le lexique des violences faites aux femmes et aux enfants"
  }
 ],
 "note": {
  "status": "draft",
  "text": "Une violence est un acte qui fait du mal à une personne, dans son corps ou dans son esprit.\n• Violences physiques : frapper, battre, blesser, maltraiter.\n• Violences verbales et psychologiques : insulter, humilier, menacer, crier, isoler.\n• Violences contre les droits de l’enfant : le travail des enfants, le mariage précoce (forcé), l’abandon, le refus de l’école.\n• Pratiques néfastes : les mutilations génitales féminines, le repassage des seins.\nMots utiles : une victime, un agresseur, maltraiter, protéger, dénoncer, porter plainte, les droits de l’enfant, l’égalité, le respect.\nUne victime ou un témoin peut en parler à un adulte de confiance, à un enseignant, à un travailleur social ou à la police.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {},
  "problem": "Un enfant de dix ans vend des beignets dans la rue au lieu d’aller à l’école. Quelle violence subit-il ?",
  "steps": [
   "Il travaille au lieu d’être à l’école.",
   "C’est le travail des enfants, une violation de ses droits."
  ],
  "answer": "le travail des enfants",
  "checks": []
 },
