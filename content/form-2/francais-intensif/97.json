 "note": {
  "status": "draft",
  "text": "Pour reconnaître un temps :\n• présent : je chante ; imparfait : -ais, -ait, -aient (je chantais) ;\n• passé composé : auxiliaire au présent + participe (j’ai chanté) ; plus-que-parfait : auxiliaire à l’imparfait + participe (j’avais chanté) ;\n• futur simple : -ai, -as, -a, -ons, -ez, -ont (je chanterai) ; conditionnel : radical du futur + -ais, -ait (je chanterais) ;\n• subjonctif : après « il faut que », « je veux que » (que je chante).\nPoints de grammaire du trimestre : la phrase interro-négative, la phrase composée, les pronoms et adjectifs indéfinis, les noms composés, la liaison.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "v": "venir",
   "p": 6
  },
  "problem": "À quel temps est « {fr2Form2(v, p, 'conditionnel présent')} » ?",
  "steps": [
   "Un seul mot, avec le radical du futur viendr-.",
   "La terminaison -aient est celle de l’imparfait : c’est le conditionnel présent."
  ],
  "answer": "au conditionnel présent",
  "checks": []
 },
