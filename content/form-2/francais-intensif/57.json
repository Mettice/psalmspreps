  "vars": {},
  "problem": "Relève une comparaison dans le poème et explique-la.",
  "steps": [
   "Une comparaison utilise « comme ».",
   "« Rouge comme le cœur qui bat » : le rouge du drapeau est comparé au cœur, symbole de vie et de courage."
  ],
  "answer": "« Rouge comme le cœur qui bat » : le rouge est comparé au cœur.",
  "checks": []
 },
