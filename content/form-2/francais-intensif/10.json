  "vars": {
   "v": "sortir",
   "p": 7
  },
  "problem": "Conjugue « {v} » au passé composé avec « {fr2Pronoun(p)} ».",
  "steps": [
   "« sortir » se conjugue avec être.",
   "Le participe passé est « sorti » ; il s’accorde avec « elles » : sorties."
  ],
  "answer": "{fr2PasseCompose(v, p)}",
  "checks": []
 },
