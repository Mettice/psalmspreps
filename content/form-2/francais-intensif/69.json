   "id": "fi2-69",
   "name": "Le lexique des conflits sociaux"
  }
 ],
 "note": {
  "status": "draft",
  "text": "Un conflit social est une opposition entre des personnes ou des groupes dans la société.\nDes comportements qui créent des conflits :\n• la discrimination : traiter quelqu’un plus mal à cause de son origine, sa langue, son sexe, sa religion ou son handicap ;\n• la ségrégation raciale : séparer les gens selon leur « race » (l’apartheid en Afrique du Sud, aboli au début des années 1990) ;\n• le racisme : croire qu’un groupe humain est supérieur à un autre ;\n• le tribalisme : favoriser les gens de sa tribu ou de son ethnie et rejeter les autres ;\n• le népotisme : donner des places ou des avantages à sa famille plutôt qu’aux plus compétents.\nPour la paix : la tolérance, l’égalité, le dialogue, la justice, le vivre-ensemble, l’unité nationale.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {},
  "problem": "Un directeur donne un emploi à son neveu moins qualifié que les autres candidats. Comment appelle-t-on ce comportement ?",
  "steps": [
   "Il favorise un membre de sa famille.",
   "Ce n’est pas le plus compétent qui est choisi : c’est le népotisme."
  ],
  "answer": "le népotisme",
  "checks": []
 },
