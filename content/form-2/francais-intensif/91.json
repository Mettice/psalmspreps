   "name": "Les noms composés"
  }
 ],
 "note": {
  "status": "draft",
  "text": "Un nom composé est formé de plusieurs mots qui désignent une seule chose : un chou-fleur, un arc-en-ciel, une machine à coudre, un porte-monnaie.\nFormation : avec un trait d’union (un chef-d’œuvre), sans trait d’union (une pomme de terre), ou en un seul mot (un portefeuille).\nLe pluriel (règle traditionnelle) : seuls les noms et les adjectifs prennent la marque du pluriel ; les verbes, les adverbes et les prépositions restent invariables.\n• nom + nom : des choux-fleurs ; nom + adjectif : des coffres-forts ;\n• verbe + nom : des tire-bouchons, des ouvre-boîtes ;\n• adverbe + nom : des arrière-boutiques ;\n• nom + préposition + nom : seul le premier nom varie : des machines à coudre, des chefs-d’œuvre, des pommes de terre.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {},
  "problem": "Écris le pluriel de « un chef-d’œuvre ».",
  "steps": [
   "C’est nom + préposition + nom : seul le premier nom varie.",
   "On écrit : des chefs-d’œuvre."
  ],
  "answer": "des chefs-d’œuvre",
  "checks": []
 },
