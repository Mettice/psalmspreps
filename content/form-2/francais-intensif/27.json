  {
   "id": "fi2-27",
   "name": "Le pluriel des noms en -al, -ail, -ou, -eau, -eu"
  }
 ],
 "note": {
  "status": "draft",
  "text": "En général, on forme le pluriel d’un nom en ajoutant -s. Mais :\n• les noms en -al font -aux : un cheval → des chevaux, un journal → des journaux (sauf bal, carnaval, festival, chacal, récital, régal : -s) ;\n• les noms en -ail prennent -s : des détails, des éventails, des rails (sauf bail, corail, émail, soupirail, travail, vitrail : -aux) ;\n• les noms en -ou prennent -s : des trous, des clous (sauf sept noms qui prennent -x : bijou, caillou, chou, genou, hibou, joujou, pou) ;\n• les noms en -au, -eau, -eu prennent -x : des tuyaux, des bateaux, des cheveux (sauf landau, sarrau, pneu, bleu : -s).",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "n": "travail"
  },
  "problem": "Quel est le pluriel de « {n} » ?",
  "steps": [
   "« travail » est un nom en -ail ; en général, ils prennent -s.",
   "Mais « travail » est une exception : il fait -aux."
  ],
  "answer": "des {fr2NounPlural(n)}",
  "checks": []
 },
