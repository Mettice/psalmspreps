   "id": "fi2-35",
   "name": "Les adverbes de lieu et de manière"
  }
 ],
 "note": {
  "status": "draft",
  "text": "L’adverbe est un mot invariable qui précise le sens d’un verbe, d’un adjectif ou d’un autre adverbe.\n• Adverbes de lieu (où ?) : ici, là, là-bas, partout, ailleurs, dehors, dedans, loin, près, devant, derrière, dessus, dessous.\n• Adverbes de manière (comment ?) : bien, mal, vite, ensemble, et beaucoup d’adverbes en -ment.\nFormer un adverbe en -ment : on ajoute -ment au féminin de l’adjectif (lent → lente → lentement ; doux → douce → doucement ; heureux → heureusement) ; après une voyelle, on ajoute -ment au masculin (poli → poliment, vrai → vraiment) ; -ant → -amment (bruyant → bruyamment), -ent → -emment (prudent → prudemment). Exception : gentil → gentiment.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "a": "patient"
  },
  "problem": "Forme l’adverbe en -ment de « {a} ».",
  "steps": [
   "« {a} » se termine par -ent.",
   "-ent devient -emment."
  ],
  "answer": "{fr2Adverb(a)}",
  "checks": []
 },
