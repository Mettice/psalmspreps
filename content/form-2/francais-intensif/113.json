 "note": {
  "status": "draft",
  "text": "Le passé antérieur est un temps composé surtout employé dans les récits écrits. Il se forme avec avoir ou être au passé simple, suivi du participe passé : j’eus fini, elle fut partie. Avec être, le participe s’accorde avec le sujet : elles furent parties.\nIl peut marquer une action achevée avant une autre action au passé simple : Quand elle eut fini son article, elle le publia. Ne le confonds pas avec le plus-que-parfait, dont l’auxiliaire est à l’imparfait : elle avait fini.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "v": "finir",
   "p": 4
  },
  "problem": "Conjugue « {v} » au passé antérieur avec nous.",
  "steps": [
   "Le sujet est nous.",
   "La forme complète est {fr2Form2(v, p, 'passé antérieur')}."
  ],
  "answer": "{fr2Form2(v, p, 'passé antérieur')}",
  "checks": []
 },
