   "id": "fi2-36",
   "name": "Le participe présent et le gérondif"
  }
 ],
 "note": {
  "status": "draft",
  "text": "Le participe présent se forme sur le radical de « nous » au présent + -ant : nous chantons → chantant ; nous finissons → finissant ; nous faisons → faisant ; nous mangeons → mangeant ; nous commençons → commençant.\nExceptions : être → étant ; avoir → ayant ; savoir → sachant.\nLe participe présent est invariable : des enfants chantant dans la cour.\nLe gérondif = en + participe présent : en chantant, en finissant. Il dit qu’une action se passe en même temps qu’une autre, ou comment elle se fait. Le sujet des deux actions est le même : Paul siffle en marchant (c’est Paul qui siffle et qui marche).",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "v": "commencer"
  },
  "problem": "Forme le participe présent et le gérondif de « {v} ».",
  "steps": [
   "Au présent : nous {fr2Present(v, 4)}.",
   "On remplace -ons par -ant : {fr2ParticipePresent(v)} (la cédille reste).",
   "Gérondif : en + participe présent."
  ],
  "answer": "{fr2ParticipePresent(v)} ; {fr2Gerondif(v)}",
  "checks": []
 },
