   "name": "Les pluriels des noms en -ou, -au, -eau, -eu"
  }
 ],
 "note": {
  "status": "draft",
  "text": "Rappel des règles :\n• -ou → -ous : des trous, des clous, des cous, des sous, des fous ;\n  sauf sept noms en -oux : bijou, caillou, chou, genou, hibou, joujou, pou.\n• -au, -eau, -eu → -x : des tuyaux, des bateaux, des jeux, des feux, des cheveux ;\n  sauf : landau → landaus, sarrau → sarraus, pneu → pneus, bleu → bleus.\nDans une phrase, le nom pluriel entraîne l’accord du déterminant, de l’adjectif et du verbe : « Les vieux bateaux rentrent au port. »",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "n": "pneu"
  },
  "problem": "Écris le pluriel de « {n} ».",
  "steps": [
   "Les noms en -eu prennent -x, mais « {n} » est une exception.",
   "Donc : des {fr2NounPlural(n)}."
  ],
  "answer": "des {fr2NounPlural(n)}",
  "checks": []
 },
