 "skills": [
  {
   "id": "k2-10",
   "name": "Using valencies to write chemical formulae"
  }
 ],
 "note": {
  "status": "draft",
  "text": "To write the formula of a compound from a table of valencies:\n1. Write the symbols (metal or positive part first): Al O.\n2. Write each valency above its symbol: Al 3, O 2.\n3. Swap the valencies and write them as small numbers: Al₂O₃.\n4. Simplify if both numbers can be divided by the same number: Mg 2, O 2 → Mg₂O₂ → MgO.\n5. Put a radical in brackets when there is more than one of it: Ca 2, OH 1 → Ca(OH)₂.\nA number 1 is not written.\nCheck: the total valency of each part is the same (Al₂O₃: 2 × 3 = 6 and 3 × 2 = 6).",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "p": "Al",
   "n": "SO4"
  },
  "problem": "Write the formula of {compoundName(p, n)} from the valencies.",
  "steps": [
   "Valencies: {p} {valency(p)}, {formula(n)} {valency(n)}.",
   "Swap: {valency(n)} {p} and {valency(p)} {formula(n)}; the radical goes in brackets.",
   "Formula: {formula(compoundFormula(p, n))}."
  ],
  "answer": "{formula(compoundFormula(p, n))}",
  "checks": [
   "compoundFormula(p, n) == 'Al2(SO4)3'"
  ]
 },
