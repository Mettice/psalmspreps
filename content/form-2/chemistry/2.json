 "note": {
  "status": "draft",
  "text": "An atom has a tiny central nucleus and electrons around it.\n• Protons: in the nucleus, positive charge (+1), relative mass 1.\n• Neutrons: in the nucleus, no charge (0), relative mass 1.\n• Electrons: moving around the nucleus in shells, negative charge (−1), very small mass (about 1/1840).\nAlmost all the mass of an atom is in its nucleus; most of the atom is empty space.\nAn atom has as many electrons as protons, so the charges cancel: the atom is neutral (no overall charge).",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "p": 11,
   "z": 0
  },
  "problem": "A sodium atom has {p} protons. How many electrons does it have, and what is its overall charge?",
  "steps": [
   "An atom is neutral: electrons = protons = {p}.",
   "Charge: +{p} from the protons and −{p} from the electrons add up to {z}."
  ],
  "answer": "{p} electrons; the atom has no overall charge.",
  "checks": []
 },
