   "id": "k2-44",
   "name": "Sublimation, melting point and boiling point"
  }
 ],
 "note": {
  "status": "draft",
  "text": "Melting point: the temperature at which a solid turns into a liquid. Ice melts at 0 °C.\nBoiling point: the temperature at which a liquid boils, turning into a gas throughout. Pure water boils at 100 °C at sea level (lower on a high mountain such as Mount Cameroon, where the air pressure is lower).\nSublimation: a solid turns directly into a gas without melting, and the gas turns back to a solid on cooling. Examples: iodine, ammonium chloride, camphor (naphthalene balls), solid carbon dioxide (dry ice).\nSublimation separates a solid that sublimes from one that does not, for example ammonium chloride from salt: heat the mixture; ammonium chloride sublimes and collects on a cool surface; the salt stays.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "m": "ammonium chloride and common salt"
  },
  "problem": "How can {m} be separated?",
  "steps": [
   "Heat the mixture with a cold funnel or dish above it.",
   "Ammonium chloride sublimes and forms a solid on the cold surface; salt does not sublime."
  ],
  "answer": "By sublimation.",
  "checks": []
 },
