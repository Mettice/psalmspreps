 "note": {
  "status": "draft",
  "text": "A radical is a group of atoms that stays together and acts like one unit in many compounds. It carries a charge.\nCommon radicals:\n• hydroxide OH (−1)   • nitrate NO₃ (−1)   • hydrogencarbonate HCO₃ (−1)\n• sulfate SO₄ (−2)   • carbonate CO₃ (−2)\n• phosphate PO₄ (−3)\n• ammonium NH₄ (+1), the only common positive radical.\nNames ending in -ate contain oxygen. When a compound has more than one radical, put the radical in brackets: Ca(OH)₂, Al₂(SO₄)₃.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "r": "SO4",
   "four": 4
  },
  "problem": "How many atoms of each element are in one {partName(r)} radical, {formula(r)}?",
  "steps": [
   "{formula(r)}: S has no number after it, so one sulfur atom.",
   "O has the small number {four}: four oxygen atoms."
  ],
  "answer": "One sulfur atom and four oxygen atoms.",
  "checks": [
   "atomCount(r, 'O') == four"
  ]
 },
