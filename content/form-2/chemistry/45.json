  {
   "id": "k2-45",
   "name": "Criteria for purity"
  }
 ],
 "note": {
  "status": "draft",
  "text": "A pure substance contains only one substance. Tests of purity:\n• A pure solid melts at one sharp, fixed temperature. An impure solid melts over a range of temperatures, below the true melting point.\n• A pure liquid boils at one fixed temperature. Impurities raise the boiling point (salt water boils above 100 °C) and lower the freezing point (salt water freezes below 0 °C).\n• A pure substance gives a single spot in chromatography; a mixture gives several spots.\nPurity matters for medicines, foods and drinking water: impurities can be harmful.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "x": "a sample of water boils at 102 °C"
  },
  "problem": "What does it show that {x}?",
  "steps": [
   "Pure water boils at exactly {100} °C at sea level.",
   "Dissolved impurities raise the boiling point."
  ],
  "answer": "The water is not pure (it contains dissolved substances).",
  "checks": []
 },
