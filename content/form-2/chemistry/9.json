 "questions": [
  {
   "id": "k2-9-count",
   "type": "numeric",
   "level": 1,
   "review": "rule",
   "sources": [
    "symbols-valency"
   ],
   "vars": {
    "f": {
     "pick": [
      "H2O",
      "CO2",
      "CaCO3",
      "H2SO4",
      "NH3",
      "C6H12O6",
      "KNO3",
      "Na2CO3",
      "MgO",
      "Al2O3"
     ]
    },
    "e": {
     "expr": "symbolsIn(f)[symbolsIn(f).length - 1]"
    }
   },
   "prompt": "How many {nameOf(e)} atoms are in one unit of {formula(f)}?",
   "answer": "atomCount(f, e)",
   "solution": [
    "{formula(f)}: {atomList(f)}.",
    "So {answer} {nameOf(e)} atoms."
   ]
  },
  {
   "id": "k2-9-bracket",
   "type": "numeric",
   "level": 1,
   "review": "rule",
   "sources": [
    "symbols-valency"
   ],
   "vars": {
    "f": {
     "pick": [
      "Ca(OH)2",
      "Al2(SO4)3",
      "Mg(NO3)2",
      "Ca3(PO4)2",
      "(NH4)2SO4"
     ]
    },
    "e": {
     "pick": [
      "O",
      "H",
      "N"
     ]
    }
   },
   "prompt": "How many {nameOf(e)} atoms are in one unit of {formula(f)}?",
   "answer": "atomCount(f, e)",
   "misconceptions": [
    {
     "id": "no-multiply",
     "wrong": "atomCount(f, e) / (f == 'Al2(SO4)3' ? 3 : 2)",
     "explain": "Multiply by the number after the bracket.",
     "when": "isInt(atomCount(f, e) / (f == 'Al2(SO4)3' ? 3 : 2))"
    }
   ],
   "solution": [
    "The number after the bracket multiplies everything inside it.",
    "{formula(f)}: {atomList(f)}, so {answer}."
   ],
   "where": [
    "atomCount(f, e) > 0"
   ]
  },
  {
   "id": "k2-9-kind",
   "type": "mcq",
   "level": 1,
   "review": "rule",
   "sources": [
    "symbols-valency"
   ],
   "vars": {
    "f": {
     "pick": [
      "O2",
      "N2",
      "Fe",
      "Cu",
      "H2",
      "Cl2",
      "H2O",
      "NaCl",
      "CO2",
      "MgO",
      "NH3"
     ]
    }
   },
   "prompt": "Is {formula(f)} an element or a compound?",
   "correct": "{elementCount(f) == 1 ? 'an element' : 'a compound'}",
   "distractors": [
    {
     "text": "{elementCount(f) == 1 ? 'a compound' : 'an element'}",
     "misconception": "flip"
    }
   ],
   "misconceptions": [
    {
     "id": "flip",
     "explain": "Count the different elements: one kind of atom is an element; two or more is a compound."
    }
   ],
   "solution": [
    "{formula(f)} contains {elementCount(f) == 1 ? 'only ' + nameOf(symbolsIn(f)[0]) : elementNames(f)}.",
    "So it is {answer}."
   ],
   "show": 2
  },
  {
   "id": "k2-9-total",
   "type": "numeric",
   "level": 2,
   "review": "rule",
   "sources": [
    "symbols-valency"
   ],
   "vars": {
    "f": {
     "pick": [
      "H2O",
      "CO2",
      "NaCl",
      "CaCO3",
      "H2SO4",
      "NaOH",
      "Ca(OH)2",
      "Al2O3",
      "MgO",
      "HCl",
      "NH3",
      "C6H12O6",
      "Al2(SO4)3",
      "KNO3",
      "CuSO4",
      "Na2CO3"
     ]
    }
   },
   "prompt": "How many atoms in total are in one unit of {formula(f)}?",
   "answer": "totalAtoms(f)",
   "misconceptions": [
    {
     "id": "elements",
     "wrong": "elementCount(f)",
     "explain": "That counts the elements; count every atom.",
     "when": "elementCount(f) != totalAtoms(f)"
    }
   ],
   "solution": [
    "{formula(f)}: {atomList(f)}.",
    "Total: {answer} atoms."
   ]
  },
  {
   "id": "k2-9-many",
   "type": "numeric",
   "level": 3,
   "review": "rule",
   "sources": [
    "symbols-valency"
   ],
   "vars": {
    "n": {
     "int": [
      2,
      5
     ]
    },
    "f": {
     "pick": [
      "H2O",
      "NH3",
      "CH4",
      "H2SO4",
      "HCl",
      "NaOH"
     ]
    }
   },
   "prompt": "How many hydrogen atoms are in {n}{formula(f)}?",
   "answer": "n * atomCount(f, 'H')",
   "misconceptions": [
    {
     "id": "one",
     "wrong": "atomCount(f, 'H')",
     "explain": "The big number {n} counts whole units: multiply."
    }
   ],
   "solution": [
    "One unit of {formula(f)} has {atomCount(f, 'H')} hydrogen atoms.",
    "{n} units: {n} × {atomCount(f, 'H')} = {answer}."
   ]
  }
 ]
