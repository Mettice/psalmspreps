 "skills": [
  {
   "id": "k2-9",
   "name": "Chemical symbols and formulae"
  }
 ],
 "note": {
  "status": "draft",
  "text": "A chemical formula shows which elements are in a substance and how many atoms of each are in one unit of it.\n• The small number after a symbol counts the atoms of that element: H₂O has 2 hydrogen atoms and 1 oxygen atom.\n• No number means one atom.\n• A number after a bracket multiplies everything inside: Ca(OH)₂ has 1 Ca, 2 O and 2 H.\n• A big number in front counts whole units: 3H₂O means three water molecules (6 H and 3 O).\nElements: one kind of atom (O₂, Fe). Compounds: two or more elements joined (H₂O, NaCl).",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "f": "Al2(SO4)3"
  },
  "problem": "How many atoms of each element are in {formula(f)}, and how many atoms in total?",
  "steps": [
   "Al₂: {atomCount(f, 'Al')} aluminium atoms.",
   "(SO₄) three times: {atomCount(f, 'S')} sulfur and {atomCount(f, 'O')} oxygen atoms.",
   "Total: {totalAtoms(f)} atoms."
  ],
  "answer": "{atomList(f)}; {totalAtoms(f)} atoms in all.",
  "checks": [
   "totalAtoms(f) == 17"
  ]
 },
 "teach": {
  "cards": [
   {
    "id": "c9-1",
    "status": "draft",
    "idea": "The small number after a symbol counts that element's atoms; no number means one.",
    "vars": {
