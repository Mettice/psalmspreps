   "solution": [
    "{atomicNumber(s) == 2 ? 'Helium has a full shell: it is a noble gas, group 8' : 'The outer shell has ' + outerElectrons(atomicNumber(s)) + ' electrons'}.",
    "So it is in group {answer}."
   ],
   "where": [
    "s != 'H'"
