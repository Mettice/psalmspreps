 "note": {
  "status": "draft",
  "text": "In the modern periodic table:\n• Elements are in order of atomic number.\n• Columns are groups (1 to 8; group 8 is also called group 0). Elements in a group have the same number of outer electrons, so they react in similar ways.\n• Rows are periods. The period number is the number of electron shells.\nExample: sodium, 2, 8, 1: group 1 (one outer electron), period 3 (three shells).\nMetals are on the left and in the middle; non-metals are on the right; metalloids (silicon, boron) are between them.\nHydrogen is often placed on its own at the top.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "z": 17
  },
  "problem": "Find the group and period of chlorine (atomic number {z}).",
  "steps": [
   "Arrangement: {shells(z)}.",
   "Outer electrons: {outerElectrons(z)}, so group {groupOf(z)}.",
   "Shells: {periodOf(z)}, so period {periodOf(z)}."
  ],
  "answer": "Group {groupOf(z)}, period {periodOf(z)}.",
  "checks": [
   "groupOf(z) == 7 && periodOf(z) == 3"
  ]
 },
