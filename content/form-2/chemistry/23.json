 "note": {
  "status": "draft",
  "text": "A symbolic (chemical) equation uses symbols and formulae instead of names.\nSteps:\n1. Write the word equation.\n2. Write the correct formula of each substance (use valencies).\n3. Balance the equation (next lessons).\nGases like hydrogen, oxygen, nitrogen and chlorine exist as molecules of two atoms: H₂, O₂, N₂, Cl₂.\nExample: hydrogen + oxygen → water becomes H₂ + O₂ → H₂O (not yet balanced).\nState symbols may be added: (s) solid, (l) liquid, (g) gas, (aq) dissolved in water.\nAtoms are counted from the formula: in Ca(OH)₂ there is one Ca, two O and two H.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "f": "Ca(OH)2"
  },
  "problem": "How many atoms of each element are in {formula(f)}?",
  "steps": [
   "The bracket (OH) is taken twice.",
   "Ca: {1}, O: {1} × {2} = {2}, H: {1} × {2} = {2}."
  ],
  "answer": "{atomList(f)}",
  "checks": []
 },
