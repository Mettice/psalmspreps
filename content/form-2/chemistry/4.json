   "name": "Atomic number and mass number"
  }
 ],
 "note": {
  "status": "draft",
  "text": "The atomic number (Z) is the number of protons. It identifies the element: every atom with 6 protons is carbon.\nIn a neutral atom, the number of electrons = the atomic number.\nThe mass number (A) is the number of protons + neutrons (the particles in the nucleus).\nNumber of neutrons = A − Z.\nNotation: the mass number is written at the top left of the symbol and the atomic number at the bottom left, for example ²³₁₁Na: 11 protons, 11 electrons, 23 − 11 = 12 neutrons.\nIsotopes are atoms of the same element (same Z) with different numbers of neutrons (different A), such as chlorine-35 and chlorine-37.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "s": "Cl"
  },
  "problem": "Chlorine has atomic number {atomicNumber(s)} and mass number {massNumber(s)}. Find its protons, electrons and neutrons.",
  "steps": [
   "Protons = atomic number = {atomicNumber(s)}.",
   "Electrons = protons = {atomicNumber(s)} (a neutral atom).",
   "Neutrons = {massNumber(s)} − {atomicNumber(s)} = {neutrons(s)}."
  ],
  "answer": "{atomicNumber(s)} protons, {atomicNumber(s)} electrons, {neutrons(s)} neutrons.",
  "checks": [
   "neutrons(s) == 18"
  ]
 },
