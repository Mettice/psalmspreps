  {
   "id": "k2-11-formula",
   "type": "mcq",
   "level": 3,
   "review": "rule",
   "sources": [
    "symbols-valency"
   ],
   "vars": {
    "p": {
     "pick": [
      "Mg",
      "Ca",
      "Al",
      "Na",
      "K",
      "Zn"
     ]
    },
    "n": {
     "pick": [
      "Cl",
      "O",
      "S",
      "OH",
      "NO3",
      "SO4",
      "CO3"
     ]
    }
   },
   "prompt": "What is the formula of {compoundName(p, n)}?",
   "correct": "{formula(compoundFormula(p, n))}",
   "distractors": [
    {
     "text": "{formula(unsimplified(p, n))}",
     "misconception": "unsimplified"
    },
    {
     "text": "{formula(p + n)}",
     "misconception": "ones"
    },
    {
     "text": "{formula(n + p)}",
     "misconception": "order"
    },
    {
     "text": "{formula((p + (valency(p) > 1 ? valency(p) : '') + n + (valency(n) > 1 ? valency(n) : '')))}",
     "misconception": "noswap"
    }
   ],
   "misconceptions": [
    {
     "id": "unsimplified",
     "explain": "Simplify: both numbers can be divided by the same number."
    },
    {
     "id": "ones",
     "explain": "Swap the valencies."
    },
    {
     "id": "order",
     "explain": "The positive part comes first."
    },
    {
     "id": "noswap",
     "explain": "Swap the valencies: each one goes to the other part."
    }
   ],
   "solution": [
    "Valencies: {p} {valency(p)}, {n} {valency(n)}.",
    "Swap{needsSimplifying(p, n) ? ' and simplify' : ''}: {answer}."
   ],
   "where": [
    "!(p == 'H' && (n == 'OH' || n == 'HCO3' || n == 'N'))",
    "!(p == 'NH4' && (n == 'OH' || n == 'N' || n == 'HCO3'))",
    "!(valency(p) == 1 && valency(n) == 1)",
    "compoundFormula(p, n) != unsimplified(p, n) || p != n"
   ]
  }
 ]
