 "note": {
  "status": "draft",
  "text": "Naming a compound of two parts: the metal (or ammonium, or hydrogen) first, then the other part.\n• Two elements: the second name changes its ending to -ide: oxygen → oxide, chlorine → chloride, sulfur → sulfide, nitrogen → nitride, iodine → iodide. NaCl: sodium chloride. MgO: magnesium oxide.\n• With a radical, use the radical's name: Na₂CO₃ sodium carbonate, CuSO₄ copper sulfate, KNO₃ potassium nitrate, NaOH sodium hydroxide, (NH₄)₂SO₄ ammonium sulfate.\n• -ate names contain oxygen; -ide names (except hydroxide) contain only the two elements.\nSome common names: H₂O water, NH₃ ammonia, CH₄ methane.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "f": "CaCl2",
   "p": "Ca",
   "n": "Cl"
  },
  "problem": "Name {formula(f)}.",
  "steps": [
   "The metal comes first: {p} is {nameOf(p)}.",
   "The second element, {nameOf(n)}, changes its ending to -ide: {partName(n)}."
  ],
  "answer": "{compoundName(p, n)}",
  "checks": []
 },
