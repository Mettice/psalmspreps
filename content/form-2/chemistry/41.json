 "note": {
  "status": "draft",
  "text": "Mixtures are separated by physical methods that use a difference in properties:\n• Picking or sieving: different sizes (stones from beans, sand from gravel).\n• Decanting: pouring a liquid off a settled solid.\n• Filtration: an insoluble solid from a liquid (sand from water). The solid left is the residue; the liquid through is the filtrate.\n• Evaporation: a dissolved solid from a solution (salt from salt water).\n• Crystallisation: heating a solution until saturated, then cooling to form crystals (sugar, copper sulphate).\n• Magnetic separation: iron filings from sulphur or sand.\n• Separating funnel: two liquids that do not mix (oil and water).\n• Winnowing: chaff from grain using wind.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "m": "sand and salt"
  },
  "problem": "How can {m} be separated?",
  "steps": [
   "Add water and stir: the salt dissolves, the sand does not.",
   "Filter to remove the sand (residue), then evaporate the filtrate to get the salt."
  ],
  "answer": "Dissolve, filter, then evaporate.",
  "checks": []
 },
