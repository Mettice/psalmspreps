 "note": {
  "status": "draft",
  "text": "A word equation shows a reaction using the names of the substances:\nreactants → products\n• The arrow means “react to form” or “give”.\n• A plus sign (+) on the left means “reacts with”; on the right it means “and”.\n• Reactants are on the left, products on the right.\nExample: magnesium + oxygen → magnesium oxide.\nNaming products: a metal with a non-metal gives a compound ending in -ide (sodium + chlorine → sodium chloride). Burning a substance in oxygen gives its oxide. An acid + metal gives a salt + hydrogen.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "r": "Zinc reacts with hydrochloric acid to give zinc chloride and hydrogen."
  },
  "problem": "Write a word equation: {r}",
  "steps": [
   "The reactants (left) are zinc and hydrochloric acid.",
   "The products (right) are zinc chloride and hydrogen."
  ],
  "answer": "zinc + hydrochloric acid → zinc chloride + hydrogen",
  "checks": []
 },
