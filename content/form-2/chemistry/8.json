   "id": "k2-8",
   "name": "Valency of elements and radicals"
  }
 ],
 "note": {
  "status": "draft",
  "text": "Valency is the combining power of an element or radical: the number of hydrogen atoms (or other atoms of valency 1) it can combine with.\nFor elements, the valency comes from the outer electrons:\n• groups 1, 2, 3 (metals): valency 1, 2, 3 (they lose these electrons);\n• group 4: valency 4;\n• groups 5, 6, 7 (non-metals): valency 3, 2, 1 (8 minus the outer electrons);\n• group 8 (noble gases): valency 0, they hardly combine.\nExamples: Na 1, Mg 2, Al 3, C 4, N 3, O 2, Cl 1. Hydrogen has valency 1.\nSome metals have more than one valency (iron 2 or 3; copper 1 or 2): the name shows it, iron(III) oxide.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "z": 16,
   "eight": 8
  },
  "problem": "Find the valency of sulfur (atomic number {z}) from its electron arrangement.",
  "steps": [
   "Arrangement: {shells(z)}, so {outerElectrons(z)} outer electrons (group {groupOf(z)}).",
   "A non-metal: valency = {eight} − {outerElectrons(z)} = {eight - outerElectrons(z)}."
  ],
  "answer": "Valency {eight - outerElectrons(z)}.",
  "checks": [
   "eight - outerElectrons(z) == 2"
  ]
 },
