 "note": {
  "status": "draft",
  "text": "L’imparfait exprime une habitude ou une description dans le passé : autrefois, nous téléphonions le soir ; l’écran était petit.\nOn part de nous au présent, on enlève -ons, puis on ajoute -ais, -ais, -ait, -ions, -iez, -aient. Exception : être utilise le radical ét-. Nous envoyons donne j’envoyais ; nous finissons donne je finissais. Avec -ger : je mangeais, mais nous mangions. Avec -cer : je commençais, mais nous commencions.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "v": "parler",
   "p": 4
  },
  "problem": "Conjugue « {v} » au imparfait avec nous.",
  "steps": [
   "Le sujet est nous.",
   "La forme complète est {fr2Form2(v, p, 'imparfait')}."
  ],
  "answer": "{fr2Form2(v, p, 'imparfait')}",
  "checks": []
 },
