  {
   "id": "fr2-27",
   "name": "L’accord des adjectifs de couleur"
  }
 ],
 "note": {
  "status": "draft",
  "text": "Un adjectif de couleur simple s’accorde avec le nom, comme les autres adjectifs : une robe verte, des pagnes bleus, des chaussures noires, une chemise blanche.\nMais quand la couleur est un nom de chose (un fruit, une fleur, une matière …), elle reste invariable : des chemises orange (la couleur de l’orange), des pantalons marron (le marron est un fruit), des tenues kaki.\nExceptions : rose, mauve, pourpre, fauve s’accordent : des robes roses.\nPour savoir : on se demande si la couleur est d’abord un nom d’objet (orange, marron, crème, olive …).",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {},
  "problem": "Accorde : « des chemises ___ (orange) » et « des fleurs ___ (jaune) ».",
  "steps": [
   "« orange » est d’abord un fruit : il reste invariable : des chemises orange.",
   "« jaune » est un adjectif de couleur simple : il s’accorde : des fleurs jaunes."
  ],
  "answer": "des chemises orange ; des fleurs jaunes",
  "checks": []
 },
