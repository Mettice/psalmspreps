 "note": {
  "status": "draft",
  "text": "Au présent, ces verbes du module ont des formes à bien retenir :\n• voir : je vois, tu vois, il voit, nous voyons, vous voyez, ils voient ;\n• envoyer : j’envoie, tu envoies, il envoie, nous envoyons, vous envoyez, ils envoient ;\n• recevoir : je reçois, tu reçois, il reçoit, nous recevons, vous recevez, ils reçoivent (ç devant o) ;\n• prendre : je prends, il prend, nous prenons, ils prennent ;\n• acheter : j’achète, nous achetons, ils achètent.\nAu futur proche : aller au présent + infinitif : je vais envoyer, nous allons recevoir, ils vont voir.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "v": "recevoir",
   "p": 6
  },
  "problem": "Conjugue « {v} » au présent puis au futur proche avec « {fr2Pronoun(p)} ».",
  "steps": [
