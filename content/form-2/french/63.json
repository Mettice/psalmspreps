  "vars": {
   "a": 12,
   "b": 4
  },
  "problem": "Lis en toutes lettres et calcule : {a} ÷ {b}.",
  "steps": [
   "« ÷ » se lit « divisé par » ; le résultat s’appelle le quotient.",
   "Douze divisé par quatre égale trois."
  ],
  "answer": "Douze divisé par quatre égale trois ; le quotient est {a / b}.",
  "checks": []
 },
