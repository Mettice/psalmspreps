  {
   "id": "fr2-60",
   "name": "Les adjectifs à formes particulières : beau, nouveau, vieux, fou"
  }
 ],
 "note": {
  "status": "draft",
  "text": "Certains adjectifs ont une forme spéciale devant un nom masculin singulier qui commence par une voyelle ou un h muet :\n• beau → bel : un beau pagne, mais un bel arbre, un bel homme ;\n• nouveau → nouvel : un nouveau métier, mais un nouvel emploi ;\n• vieux → vieil : un vieux tailleur, mais un vieil ouvrier ;\n• fou → fol : un fou rire, mais un fol espoir.\nLeurs autres formes :\nbeau, belle, beaux, belles ; nouveau, nouvelle, nouveaux, nouvelles ; vieux, vieille, vieux, vieilles ; fou, folle, fous, folles.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {},
  "problem": "Complète avec « nouveau » : « Mon frère a un ___ emploi au port. »",
  "steps": [
   "« emploi » est masculin singulier et commence par une voyelle.",
   "Devant une voyelle, « nouveau » devient « nouvel »."
  ],
  "answer": "Mon frère a un nouvel emploi au port.",
  "checks": []
 },
