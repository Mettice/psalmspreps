 ],
 "note": {
  "status": "draft",
  "text": "Un métier est un travail qu’on apprend et qu’on exerce pour gagner sa vie.\n• Métiers de la santé : le médecin, l’infirmier, la sage-femme, le pharmacien.\n• Métiers de l’éducation : l’enseignant (le professeur, l’instituteur).\n• Métiers manuels : le maçon (construit les maisons), le menuisier (travaille le bois), le tailleur / la couturière (coud les vêtements), le mécanicien (répare les véhicules), le forgeron (travaille le fer), le cordonnier (répare les chaussures).\n• Métiers de la terre et de l’eau : l’agriculteur, l’éleveur, le pêcheur.\n• Autres : le commerçant, le chauffeur, le policier, le juge, l’avocat, le journaliste, l’informaticien.\nLe lieu de travail : l’hôpital, l’école, le chantier, l’atelier, le garage, le champ, le bureau.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {},
  "problem": "Qui répare les chaussures ? Où travaille-t-il ?",
  "steps": [
   "Le métier qui répare les chaussures est celui de cordonnier.",
   "Il travaille dans un atelier ou au bord de la route."
  ],
  "answer": "Le cordonnier, dans son atelier.",
  "checks": []
 },
