 "note": {
  "status": "draft",
  "text": "Le point termine une phrase déclarative. La phrase suivante commence par une majuscule. La virgule sépare les éléments d’une énumération ou détache un groupe : Le soir, Bih écrit. On ne sépare normalement pas le sujet de son verbe par une virgule. Les deux-points annoncent notamment une liste ou une explication : Elle utilise trois outils : un clavier, une souris et un écran.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {},
  "problem": "Quelle phrase est bien ponctuée ?",
  "steps": [
