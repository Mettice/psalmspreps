  {
   "id": "fr2-3",
   "name": "Le présent des verbes en -ger, -cer, -eler, -eter"
  }
 ],
 "note": {
  "status": "draft",
  "text": "Certains verbes du premier groupe changent un peu leur radical au présent, pour garder le même son.\n• Verbes en -ger : on garde le e devant -ons : nous mangeons, nous nageons, nous rangeons.\n• Verbes en -cer : le c devient ç devant -ons : nous commençons, nous lançons, nous avançons.\n• Verbes en -eler et -eter : la consonne double devant un e muet : j’appelle, tu jettes, ils appellent (mais nous appelons, vous jetez).\n• Acheter, lever, peser : le e prend un accent grave devant un e muet : j’achète, il lève (mais nous achetons).\n• Préférer, espérer, répéter : le é devient è devant un e muet : je préfère, ils répètent (mais vous préférez).\nLes terminaisons restent celles du premier groupe : -e, -es, -e, -ons, -ez, -ent.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "v": "commencer"
  },
  "problem": "Conjugue « {v} » au présent avec « nous » et avec « ils ».",
  "steps": [
   "C’est un verbe en -cer.",
   "Devant -ons, le c devient ç : nous {fr2Present(v, 4)}.",
   "Devant -ent, pas de changement : ils {fr2Present(v, 6)}."
  ],
  "answer": "nous {fr2Present(v, 4)}, ils {fr2Present(v, 6)}",
  "checks": []
 },
