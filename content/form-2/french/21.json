  {
   "id": "fr2-21",
   "name": "L’accord des adjectifs en -al"
  }
 ],
 "note": {
  "status": "draft",
  "text": "L’adjectif s’accorde en genre et en nombre avec le nom qu’il accompagne.\nLes adjectifs en -al :\n• au féminin, on ajoute -e : national → nationale ; au féminin pluriel -es : nationales ;\n• au masculin pluriel, -al devient -aux : un jeu national → des jeux nationaux ; un cas spécial → des cas spéciaux ; un conseil amical → des conseils amicaux.\nExceptions : banal, final, natal, naval prennent -s au masculin pluriel : des matchs finals, des propos banals, mes villages natals, des chantiers navals.\nLe féminin pluriel ne change jamais en -aux : des fêtes nationales.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "X": {
    "pick": [
     {
      "n": "les problèmes",
      "g": "m",
      "pl": true,
      "a": "principal"
     }
    ]
   }
  },
  "problem": "Accorde l’adjectif « {X.a} » avec « {X.n} ».",
  "steps": [
   "« problèmes » est masculin pluriel.",
   "Au masculin pluriel, -al devient -aux.",
   "On écrit : les problèmes {fr2Adj(X.a, X.g, X.pl)}."
  ],
  "answer": "les problèmes {fr2Adj(X.a, X.g, X.pl)}",
  "checks": []
 },
