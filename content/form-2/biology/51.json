   "id": "b2-51",
   "name": "Management of liquid waste: latrines"
  }
 ],
 "note": {
  "status": "draft",
  "text": "Human liquid waste (urine) and faeces must be disposed of safely, because they contain germs that cause cholera, typhoid, dysentery and worms. Open defecation spreads these diseases through flies, water and soil.\nA latrine is a place built to collect human waste safely.\nTypes:\n• simple pit latrine: a deep hole covered with a slab with a squat hole;\n• VIP latrine (ventilated improved pit): has a vent pipe with a fly screen, so it smells less and traps flies;\n• pour-flush latrine: a water seal (bend) is flushed with a bucket of water;\n• water closet (WC, flush toilet): uses piped water to flush waste into a septic tank or sewer;\n• ecological (eco-san) latrine: separates urine and faeces to make manure.\nA latrine should be at least 30 m from a well or spring and downhill from it.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {},
  "problem": "Why must a pit latrine be built far from a well and downhill from it?",
  "steps": [
   "Germs from the waste can soak through the soil.",
   "If the latrine is close to or above the well, the germs can reach the drinking water."
  ],
  "answer": "So that germs from the waste do not reach the drinking water.",
  "checks": []
 },
