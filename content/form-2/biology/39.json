 "note": {
  "status": "draft",
  "text": "Exercise is physical activity that makes the body work harder than at rest: running, football, dancing, swimming, skipping, farm work, walking to school.\nImportance:\n• strengthens the heart and lungs, so blood and oxygen reach the body better;\n• builds strong muscles and bones and keeps joints flexible;\n• uses energy and helps prevent obesity, diabetes and high blood pressure;\n• improves sleep, mood and concentration; reduces stress;\n• team sports build friendship and discipline.\nTeenagers should be active for about one hour a day.\nExercise safely: warm up first and cool down after, drink water, wear suitable shoes, rest when tired or ill, and increase slowly.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "a": "walk to school every day"
  },
  "problem": "Give two benefits for a pupil who decides to {a}.",
  "steps": [
   "Walking makes the heart and lungs work, so they get stronger.",
   "It uses energy, which helps keep a healthy weight."
  ],
  "answer": "A stronger heart and lungs, and a healthy weight.",
  "checks": []
 },
