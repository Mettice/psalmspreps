   "name": "Rest and sleep"
  }
 ],
 "note": {
  "status": "draft",
  "text": "Rest is a time when the body and mind relax after work or exercise. Sleep is the deepest form of rest.\nImportance:\n• the body repairs tissues and grows (growth hormone is released in sleep);\n• muscles recover from tiredness;\n• the brain sorts and stores what was learned, so memory and concentration improve;\n• it strengthens the body's defence against disease;\n• it improves mood.\nTeenagers need about 8–10 hours of sleep each night.\nToo little sleep causes tiredness, poor marks, bad temper, accidents and illness.\nGood habits: a regular bedtime, no phone or screen just before bed, a quiet dark room, no coffee or energy drinks in the evening, and short rests between study periods.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "x": "a pupil plays on a phone until two in the morning before an exam"
  },
  "problem": "What may happen if {x}?",
  "steps": [
   "He gets far less than {8} hours of sleep.",
   "His brain has not rested to store what he learned, so he is tired and cannot concentrate."
  ],
  "answer": "Tiredness and poor concentration in the exam.",
  "checks": []
 },
