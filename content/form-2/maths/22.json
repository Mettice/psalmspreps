      },
      "u": {
       "expr": "op == '≤' ? k + 5 : k - 5"
      }
     },
     "prompt": "Which value of x satisfies {ineq('x', op, k)}?",
     "correct": "{v}",
     "distractors": [
      {
       "text": "{w}",
       "misconception": "other"
      },
      {
