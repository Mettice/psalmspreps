 "skills": [
  {
   "id": "m2-22",
   "name": "Inequalities: the signs <, >, ≤ and ≥"
  }
 ],
 "note": {
  "status": "draft",
  "text": "An inequality compares two numbers or expressions that may not be equal.\n• < means “is less than”: 3 < 7.   • > means “is greater than”: 7 > 3.\n• ≤ means “is less than or equal to”. • ≥ means “is greater than or equal to”.\nThe point of the sign always points to the smaller number.\nWith negative numbers, look at the number line: −5 < −2, because −5 is further left.\nx < 3 means x can be any number less than 3 (but not 3). x ≥ 3 means 3 or any number above it.\nWords: “at least 18” means ≥ 18; “at most 40” means ≤ 40; “more than 5” means > 5; “fewer than 10” means < 10.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "a": -4,
   "b": -1,
   "k": 3
  },
  "problem": "Put the right sign, < or >, between {a} and {b}. Then say whether x = {k} satisfies x ≥ {k}.",
  "steps": [
   "On the number line {a} is to the left of {b}, so {a} is smaller: {a} < {b}.",
   "x ≥ {k} means “x is greater than or equal to {k}”. {k} is equal to {k}, so x = {k} satisfies it."
  ],
  "answer": "{a} < {b}, and yes, x = {k} satisfies x ≥ {k}.",
  "checks": [
   "a < b"
  ]
 },
 "teach": {
