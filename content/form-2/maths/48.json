 "note": {
  "status": "draft",
  "text": "A polygon is a closed figure with straight sides. Names: triangle (3 sides), quadrilateral (4), pentagon (5), hexagon (6), heptagon (7), octagon (8), nonagon (9), decagon (10), dodecagon (12).\nSpecial quadrilaterals: a trapezium has one pair of parallel sides; a parallelogram has two pairs.\nA regular polygon has all its sides equal and all its angles equal (regular hexagon, regular octagon).\nThe interior angles of a polygon with n sides add up to (n − 2) × 180°: a pentagon 540°, a hexagon 720°.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "n": 6
  },
  "problem": "Find the sum of the interior angles of a hexagon, and each angle of a regular hexagon.",
  "steps": [
   "A hexagon has {n} sides: ({n} − {2}) × {180} = {angleSum(n)}°.",
   "Regular: {angleSum(n)} ÷ {n} = {interiorRegular(n)}°."
  ],
  "answer": "{angleSum(n)}° and {interiorRegular(n)}°",
  "checks": [],
  "figure": "regularFig(n)"
 },
