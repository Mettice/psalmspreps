 "note": {
  "status": "draft",
  "text": "The net of a pyramid is made of its base and its triangular lateral faces, each attached to one side of the base.\n• Square pyramid: a square with an isosceles triangle on each side (like a star with four points).\n• Triangular pyramid (tetrahedron): a triangle with a triangle on each side.\nWhen the net is folded, the tips of the triangles meet at the apex.\nThe area of the net is the total surface area of the pyramid.\nFor a square pyramid with base side b and slant height s: total area = b² + 4 × ½ × b × s = b² + 2bs.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "b": 6,
   "s": 5
  },
  "problem": "A square pyramid has base side {b} cm and slant height {s} cm. Find the area of its net.",
  "steps": [
   "Base: {b} × {b} = {b * b} cm². Each triangle: ½ × {b} × {s} = {b * s / 2} cm².",
   "Total: {b * b} + {4} × {b * s / 2} = {sqPyramidArea(b, s)} cm²."
  ],
  "answer": "{sqPyramidArea(b, s)} cm²",
  "checks": [],
  "figure": "pyramidFig(4)"
 },
