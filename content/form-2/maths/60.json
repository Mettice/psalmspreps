   "id": "m2-60",
   "name": "Representing data: pictogram, bar chart, pie chart, line graph"
  }
 ],
 "note": {
  "status": "draft",
  "text": "• Pictogram (ideograph): each symbol stands for a number of items (a key says how many).\n• Bar chart: bars of equal width; the height of each bar is the frequency. Bars are separated by gaps.\n• Pie chart: a circle divided into sectors; each angle = frequency ÷ total × 360°.\n• Line graph: points joined by lines, to show how a quantity changes over time (temperature during a day, sales each month).\nEvery chart needs a title, labels and, for a pictogram, a key.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "f": 15,
   "T": 60
  },
  "problem": "In a survey of {T} pupils, {f} prefer football. What angle represents football in a pie chart?",
  "steps": [
   "Angle = frequency ÷ total × {360}°.",
   "{f} ÷ {T} × {360} = {pieAngle(f, T)}°."
  ],
  "answer": "{pieAngle(f, T)}°",
  "checks": []
 },
