 "note": {
  "status": "draft",
  "text": "A frequency distribution table organises raw data. The frequency of a value is how many times it occurs.\nSteps: list the values in order in the first column; go through the data and make a tally mark for each one (bundle tallies in fives: 卌); count the tallies to get each frequency.\nThe total of the frequencies equals the number of data.\nExample: marks 2, 3, 3, 4, 2, 3, 5, 4, 3 → value 2: frequency 2; 3: 4; 4: 2; 5: 1; total 9.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "a": 2,
   "b": 3,
   "c": 3,
   "d": 4,
   "e": 3
  },
  "problem": "Make a frequency table for the data {a}, {b}, {c}, {d}, {e}.",
  "steps": [
   "Values in order: {2}, {3}, {4}.",
   "Frequencies: {2} → {1}; {3} → {3}; {4} → {1}; total {5}."
  ],
  "answer": "{2} → {1}, {3} → {3}, {4} → {1}",
  "checks": []
 },
