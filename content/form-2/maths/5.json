 "questions": [
  {
   "id": "m2-5-product",
   "type": "mcq",
   "level": 1,
   "review": "rule",
   "sources": [
    "primes"
   ],
   "vars": {
    "i": {
     "int": [
      1,
      3
     ]
    },
    "j": {
     "int": [
      1,
      2
     ]
    },
    "k": {
     "int": [
      0,
      1
     ]
    },
    "n": {
     "expr": "2 ^ i * 3 ^ j * 5 ^ k"
    },
    "f": {
     "expr": "3"
    }
   },
   "prompt": "Which is the prime factorisation of {n}?",
   "correct": "{factorProduct(n)}",
   "distractors": [
    {
     "text": "{n / f} × {f}",
     "misconception": "not-prime"
    },
    {
     "text": "{factorProduct(n / 2)}",
     "misconception": "missing"
    },
    {
     "text": "{factorProduct(n * 3)}",
     "misconception": "extra"
    }
   ],
   "misconceptions": [
    {
     "id": "not-prime",
     "explain": "{n / f} is not a prime number: it can be broken down further ({factorProduct(n / f)})."
    },
    {
     "id": "missing",
     "explain": "Multiply it back: {factorProduct(n / 2)} gives {n / 2}, not {n}."
    },
    {
     "id": "extra",
     "explain": "Multiply it back: {factorProduct(n * 3)} gives {n * 3}, not {n}."
    }
   ],
   "solution": [
    "{join(ladder(n), '; ')}",
    "So {n} = {answer}."
   ],
   "where": [
    "n >= 24"
   ]
  },
