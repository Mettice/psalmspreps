       "when": "!isSquare(n * 10)"
      }
     ],
     "misconceptions": [
      {
       "id": "plus",
       "explain": "{n * n + 1} is not a square: {n}² = {n * n} and {n + 1}² = {(n + 1) ^ 2}."
      },
      {
       "id": "minus",
       "explain": "{n * n - 1} is not a square: {n - 1}² = {(n - 1) ^ 2} and {n}² = {n * n}."
      },
      {
       "id": "doubled",
       "explain": "{n * 2} is {n} × {two}, not a number times itself."
      },
      {
       "id": "ten",
       "explain": "{n * 10} is not a whole number times itself."
      }
     ],
     "solution": [
      "{n} × {n} = {n * n}.",
      "So {answer} is a square number."
     ]
    }
