    }
   },
   {
    "id": "c47-3",
    "status": "draft",
    "idea": "A commission of p % is taken off the money changed.",
    "vars": {
     "p": 2,
     "f": 65500
    },
    "example": [
     "{p} % of {f} = {f * p / 100} FCFA"
    ],
    "checks": [],
    "check": {
     "id": "m2-47-comm-card",
     "type": "numeric",
     "level": 1,
     "review": "rule",
     "sources": [
      "money"
     ],
     "vars": {
      "r": {
       "pick": [
        650,
        655,
        656,
        660
       ]
      },
      "e": {
       "pick": [
        10,
        20,
        50,
        100,
        150,
        200,
        500
       ]
      },
      "p": {
       "pick": [
        1,
        2,
        4,
        5
       ]
      }
     },
     "prompt": "1 € = {r} FCFA. An exchange office takes a {p} % commission. How many FCFA do you receive for {e} €?",
     "answer": "e * r * (100 - p) / 100",
     "misconceptions": [
      {
       "id": "nocomm",
       "wrong": "e * r",
       "explain": "Take the commission off."
      }
     ],
     "solution": [
      "Without commission: {e} × {r} = {e * r} FCFA.",
      "Commission: {p} % of {e * r} = {e * r * p / 100} FCFA.",
      "You receive {e * r} − {e * r * p / 100} = {answer} FCFA."
     ],
     "where": [
      "isInt(e * r * p / 100)"
     ],
     "unit": "FCFA"
    }
   }
  ]
 },
