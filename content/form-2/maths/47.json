 "note": {
  "status": "draft",
  "text": "An exchange rate tells how much one currency is worth in another. Example: 1 euro (€) = 656 FCFA (the CFA franc is tied to the euro at about 656 FCFA).\nEuros → FCFA: multiply by the rate. FCFA → euros: divide by the rate.\nBanks and exchange offices often take a commission (a percentage) for changing money.\nIn this lesson the rate is always given in the question: rates for other currencies (US dollar, naira) change every day.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "r": 656,
   "e": 50
  },
  "problem": "{1} € = {r} FCFA. Change {e} € into FCFA and {r * 10} FCFA into euros.",
  "steps": [
   "{e} × {r} = {e * r} FCFA.",
   "{r * 10} ÷ {r} = {10} €."
  ],
  "answer": "{e * r} FCFA; {10} €",
  "checks": []
 },
 "teach": {
  "cards": [
   {
    "id": "c47-1",
    "status": "draft",
    "idea": "Foreign money → FCFA: multiply by the rate.",
    "vars": {
