   "name": "Profit and loss; percentage gain or loss"
  }
 ],
 "note": {
  "status": "draft",
  "text": "Cost price (CP): what the trader paid. Selling price (SP): what the trader sells for.\nProfit = SP − CP (when SP > CP); loss = CP − SP (when SP < CP).\nPercentage profit (or loss) is always worked out on the cost price: % profit = profit ÷ CP × 100.\nTo find the selling price for a given profit: SP = CP + p% of CP = CP × (100 + p) ÷ 100.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "c": 8000,
   "s": 10000,
   "hund": 100
  },
  "problem": "A trader buys a radio for {c} FCFA and sells it for {s} FCFA. Find the percentage profit.",
  "steps": [
   "Profit: {s} − {c} = {s - c} FCFA.",
   "% profit: {s - c} ÷ {c} × {hund} = {pctChange(c, s)} %."
  ],
  "answer": "{pctChange(c, s)} %",
  "checks": []
 },
