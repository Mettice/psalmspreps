 "note": {
  "status": "draft",
  "text": "Two quantities are in direct proportion when they increase in the same ratio: twice as many → twice the cost. Their quotient is constant (y = kx).\nUnitary method: find the value of ONE first, then multiply. If 4 exercise books cost 1 200 FCFA, one costs 1 200 ÷ 4 = 300 FCFA, so 7 cost 7 × 300 = 2 100 FCFA.\nIn a table of direct proportion, every y ÷ x gives the same number.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "k": 4,
   "P": 1200,
   "m": 7
  },
  "problem": "{k} exercise books cost {P} FCFA. How much do {m} cost?",
  "steps": [
   "One book: {P} ÷ {k} = {P / k} FCFA.",
   "{m} books: {m} × {P / k} = {m * P / k} FCFA."
  ],
  "answer": "{m * P / k} FCFA",
  "checks": []
 },
