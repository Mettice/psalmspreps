 "note": {
  "status": "draft",
  "text": "A tetrahedron is a pyramid with a triangular base: it has 4 faces, all triangles (“tetra” means four).\nIn a regular tetrahedron, all four faces are identical equilateral triangles and all six edges are equal.\nAny face can be taken as the base.\nIt has 4 faces, 6 edges and 4 vertices: 4 + 4 − 6 = 2 (Euler).\nIts net is made of 4 equilateral triangles, for example one triangle with a triangle on each of its sides.\nTotal edge length = 6 × edge; surface area = 4 × area of one face.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "a": 5
  },
  "problem": "A regular tetrahedron has edges of {a} cm. What is the total length of its edges?",
  "steps": [
   "A tetrahedron has {6} edges, all equal.",
   "{6} × {a} = {6 * a} cm."
  ],
  "answer": "{6 * a} cm",
  "checks": [],
  "figure": "pyramidFig(3)"
 },
