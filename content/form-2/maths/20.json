 "skills": [
  {
   "id": "m2-20",
   "name": "Expanding brackets: a(b + c)"
  }
 ],
 "note": {
  "status": "draft",
  "text": "To expand a bracket, multiply every term inside by the term outside: a(b + c) = ab + ac.\n3(x + 4) = 3 × x + 3 × 4 = 3x + 12. Do not stop after the first term: 3(x + 4) is not 3x + 4.\nWith a minus inside: 5(2y − 3) = 10y − 15.\nWith a negative number outside, every sign inside changes: −2(x − 3) = −2x + 6, because (−2) × (−3) = 6.\nWith a letter outside: x(x + 4) = x² + 4x.\nExpand, then simplify: 3(x + 2) + 2(x − 1) = 3x + 6 + 2x − 2 = 5x + 4.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "a": 3,
   "b": 2,
   "c": 2,
   "d": -1
  },
  "problem": "Expand and simplify {bracket(a, [1, 'x'], [b, ''])} + {bracket(c, [1, 'x'], [d, ''])}.",
  "steps": [
   "{bracket(a, [1, 'x'], [b, ''])} = {a} × x + {a} × {b} = {poly([a, 'x'], [a * b, ''])}.",
   "{bracket(c, [1, 'x'], [d, ''])} = {c} × x + {c} × {br(d)} = {poly([c, 'x'], [c * d, ''])}.",
   "Collect like terms: {poly([a, 'x'], [a * b, ''], [c, 'x'], [c * d, ''])} = {poly([a + c, 'x'], [a * b + c * d, ''])}."
  ],
  "answer": "{poly([a + c, 'x'], [a * b + c * d, ''])}",
  "checks": [
   "a * b + c * d == 4"
  ]
 },
