   "id": "m2-17",
   "name": "Like and unlike terms"
  }
 ],
 "note": {
  "status": "draft",
  "text": "Like terms have exactly the same letters, each with the same power. Only the coefficients may differ.\nLike: 3x and −5x; 2ab and 7ba (ab = ba: the order of the letters does not matter); 4x² and x².\nUnlike: 3x and 3y (different letters); 2x and 2x² (different powers); 5 and 5x (one has no letter).\nLike terms can be added or subtracted by adding or subtracting their coefficients: 3x + 5x = 8x, 7y − 2y = 5y.\nUnlike terms cannot be joined: 3x + 5y stays as it is (it is not 8xy).",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "a": 6,
   "b": -4,
   "c": 3
  },
  "problem": "Group the terms {mono(a, 'x')}, {mono(c, 'y')}, {mono(b, 'x')} and {mono(c, 'x²')} into like terms, and add the like terms.",
  "steps": [
   "{mono(a, 'x')} and {mono(b, 'x')} both have the letter x on its own: they are like terms.",
   "{mono(c, 'y')} has a different letter, and {mono(c, 'x²')} has x squared: they are unlike the others.",
   "{mono(a, 'x')} + {br(b)}x: add the coefficients, {a} + {br(b)} = {a + b}, so the sum is {mono(a + b, 'x')}."
  ],
  "answer": "{mono(a + b, 'x')}, {mono(c, 'y')} and {mono(c, 'x²')}",
  "checks": [
   "a + b == 2"
  ]
 },
