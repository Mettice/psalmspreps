   "id": "m2-59",
   "name": "Qualitative and quantitative data"
  }
 ],
 "note": {
  "status": "draft",
  "text": "Data are pieces of information collected about something.\n• Qualitative (categorical) data are words or categories: favourite fruit, colour, region of birth, means of transport.\n• Quantitative data are numbers obtained by counting or measuring: number of brothers, height, mass, marks.\n  – discrete data are counted and take separate values (number of pupils: 0, 1, 2, …);\n  – continuous data are measured and can take any value in a range (height 1.53 m, time 12.4 s).\nData are collected by a survey, a questionnaire, an interview, observation or an experiment. Raw data are the data as collected, before they are organised.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {},
  "problem": "A pupil records, for each classmate: favourite sport, number of brothers and height. Classify each.",
  "steps": [
   "Favourite sport is a word: qualitative.",
   "Number of brothers is counted: quantitative discrete. Height is measured: quantitative continuous."
  ],
  "answer": "sport: qualitative; brothers: discrete; height: continuous",
  "checks": []
 },
