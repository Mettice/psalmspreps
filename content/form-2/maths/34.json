 "note": {
  "status": "draft",
  "text": "To round to the nearest 10, 100 or 1 000, look at the next digit to the right: 5 or more → round up; less than 5 → round down. 3 472 → 3 470 (nearest 10), 3 500 (nearest 100), 3 000 (nearest 1 000).\nTo round to decimal places, count the digits after the decimal point: 3.456 → 3.46 (2 d.p.), 3.5 (1 d.p.).\nTo estimate a calculation, round each number to one significant figure first: 48 × 21 ≈ 50 × 20 = 1 000. An estimate checks that an answer is sensible.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "a": 48,
   "b": 21
  },
  "problem": "Estimate {a} × {b}.",
  "steps": [
   "Round each number to one significant figure: {a} ≈ {sigFig(a, 1)}, {b} ≈ {sigFig(b, 1)}.",
   "{sigFig(a, 1)} × {sigFig(b, 1)} = {sigFig(a, 1) * sigFig(b, 1)}."
  ],
  "answer": "about {sigFig(a, 1) * sigFig(b, 1)}",
  "checks": []
 },
