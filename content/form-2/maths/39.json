       ]
      }
     },
     "prompt": "Write x {ca ? '≥' : '>'} {a} as an interval.",
     "correct": "{interval(a, 'inf', ca, false)}",
     "distractors": [
      {
       "text": "{ca ? '[' : '('}{a}, +∞]",
       "misconception": "inf"
      },
      {
       "text": "{interval('-inf', a, false, ca)}",
       "misconception": "dir"
      },
      {
       "text": "{interval(a, 'inf', !ca, false)}",
       "misconception": "end"
      }
     ],
     "misconceptions": [
      {
       "id": "inf",
       "explain": "∞ is never reached: it always gets a round bracket."
      },
      {
       "id": "dir",
       "explain": "x is bigger than {a}: the interval goes towards +∞."
      },
      {
       "id": "end",
       "explain": "{ca ? '≥ includes the end: [' : '> leaves the end out: ('}."
      }
     ],
     "solution": [
      "x goes from {a} up to +∞; ∞ always gets a round bracket.",
      "So {answer}."
     ]
    }
   }
  ]
 },
