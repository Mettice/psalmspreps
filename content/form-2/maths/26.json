 "note": {
  "status": "draft",
  "text": "Two angles are complementary when they add up to 90°: 30° and 60° are complementary. The complement of an angle a is 90° − a.\nTwo angles are supplementary when they add up to 180°: 110° and 70° are supplementary. The supplement of a is 180° − a.\nTip: Complementary → Corner (a right angle, 90°); Supplementary → Straight line (180°).",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "a": 35,
   "st": 180,
   "rt": 90,
   "pt": 360
  },
  "problem": "Find the complement and the supplement of {a}°.",
  "steps": [
   "Complement: {rt} − {a} = {rt - a}°.",
   "Supplement: {st} − {a} = {st - a}°."
  ],
  "answer": "complement {rt - a}°, supplement {st - a}°",
  "checks": []
 },
