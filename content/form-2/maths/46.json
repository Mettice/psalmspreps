 "note": {
  "status": "draft",
  "text": "The amount is what you have (or owe) at the end: amount = principal + interest.\nWith simple interest: A = P + P × R × T ÷ 100.\nTo find the principal when you know the interest: P = 100 × I ÷ (R × T).\nExample: 60 000 FCFA at 5 % for 2 years: I = 6 000, A = 66 000 FCFA.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "P": 60000,
   "R": 5,
   "T": 2
  },
  "problem": "Find the amount after {T} years on {P} FCFA at {R} % simple interest.",
  "steps": [
   "I = {P} × {R} × {T} ÷ {100} = {simpleInterest(P, R, T)}.",
   "A = {P} + {simpleInterest(P, R, T)} = {P + simpleInterest(P, R, T)} FCFA."
  ],
  "answer": "{P + simpleInterest(P, R, T)} FCFA",
  "checks": []
 },
