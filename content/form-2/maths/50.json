 "note": {
  "status": "draft",
  "text": "Area of a parallelogram = base × height (the height is perpendicular to the base, not the slanting side).\nArea of a trapezium = ½ × (sum of the parallel sides) × height = ½ (a + b) h.\nExample: a trapezium with parallel sides 9 cm and 5 cm and height 4 cm: ½ × (9 + 5) × 4 = 28 cm².",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "a": 9,
   "b": 5,
   "h": 4
  },
  "problem": "Find the area of a trapezium with parallel sides {a} cm and {b} cm, {h} cm apart.",
  "steps": [
   "Add the parallel sides: {a} + {b} = {a + b}.",
   "½ × {a + b} × {h} = {(a + b) * h / 2} cm²."
  ],
  "answer": "{(a + b) * h / 2} cm²",
  "checks": [],
  "figure": "trapeziumFig(a, b, h)"
 },
