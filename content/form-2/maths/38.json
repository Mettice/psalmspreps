    "checks": [],
    "check": {
     "id": "m2-38-cmp-card",
     "type": "mcq",
     "level": 1,
     "review": "rule",
     "sources": [
      "real-numbers"
     ],
     "vars": {
      "n": {
       "int": [
        3,
        40
       ]
      },
      "t": {
       "int": [
        1,
        9
       ]
      },
      "d": {
       "expr": "round(sqrt(n), 0) + (t - 5) / 10"
      }
     },
     "prompt": "Which is greater: √{n} or {d}?",
     "correct": "{sqrt(n) > d ? '√' + n : '' + d}",
     "distractors": [
      {
       "text": "{sqrt(n) > d ? '' + d : '√' + n}",
       "misconception": "w"
      },
      {
       "text": "They are equal",
       "misconception": "eq"
      }
     ],
     "misconceptions": [
      {
       "id": "w",
       "explain": "√{n} ≈ {round(sqrt(n), 2)}: compare the decimals."
      },
      {
       "id": "eq",
       "explain": "√{n} ≈ {round(sqrt(n), 2)}, which is not {d}."
      }
     ],
     "solution": [
      "√{n} ≈ {round(sqrt(n), 2)}.",
      "So the greater is {answer}."
     ],
     "where": [
      "!isPerfectSquare(n)",
      "abs(sqrt(n) - d) > 0.03"
     ],
     "min_distractors": 1
    }
   }
  ]
 },
