 "skills": [
  {
   "id": "m2-38",
   "name": "The set ℝ of real numbers and the number line"
  }
 ],
 "note": {
  "status": "draft",
  "text": "ℕ = natural numbers {0, 1, 2, …}; ℤ = integers {…, −2, −1, 0, 1, 2, …}; ℚ = rational numbers (fractions); ℝ = real numbers: all the rational and irrational numbers.\nℕ ⊂ ℤ ⊂ ℚ ⊂ ℝ: every natural number is an integer, every integer is rational, every rational number is real.\nEvery real number is a point on the number line, and every point is a real number. To place √2, use √2 ≈ 1.41; to compare numbers, compare their decimals.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "two": 2,
   "h": 1.5,
   "m": -0.5
  },
  "problem": "Put in order from smallest: √{two}, {h}, {m}, π.",
  "steps": [
   "Write decimals: √{two} ≈ {1.41}, π ≈ {3.14}.",
   "Order: {m}, √{two}, {h}, π."
  ],
  "answer": "{m} < √{two} < {h} < π",
  "checks": []
 },
 "teach": {
  "cards": [
   {
    "id": "c38-1",
    "status": "draft",
    "idea": "ℕ ⊂ ℤ ⊂ ℚ ⊂ ℝ.",
