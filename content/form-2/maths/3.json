     "explain": "The base is negative but the index {n} is even, so the answer is positive.",
     "when": "n % 2 == 0"
    },
    {
     "id": "times-index",
     "wrong": "a * n",
     "explain": "{pw(a, n)} is not {br(a)} × {n}: it is {powExpand(a, n)}."
    }
   ],
   "solution": [
    "{pw(a, n)} = {powExpand(a, n)}.",
    "The index {n} is {n % 2 == 0 ? 'even, so the answer is positive' : 'odd, so the answer is negative'}: {pw(a, n)} = {answer}."
   ],
   "signed": true,
   "where": [
    "abs(a ^ n) <= 1300"
   ]
  },
