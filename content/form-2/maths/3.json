     "id": "one-less",
     "wrong": "b ^ (n - 1)",
     "explain": "Count the factors: {b} must appear {n} times."
    }
   ],
   "solution": [
    "{pw(b, n)} = {powExpand(b, n)} = {answer}"
   ],
   "where": [
    "b ^ n <= 2000"
