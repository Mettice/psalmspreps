  {
   "id": "m2-3-write",
   "type": "mcq",
   "level": 1,
   "review": "rule",
   "sources": [
    "powers"
   ],
   "vars": {
    "b": {
     "int": [
      2,
      9
     ]
    },
    "n": {
     "int": [
      2,
      6
     ]
    }
   },
   "prompt": "Write {powExpand(b, n)} as a power.",
   "correct": "{pw(b, n)}",
   "distractors": [
    {
     "text": "{pw(n, b)}",
     "misconception": "swapped"
    },
    {
     "text": "{b} × {n}",
     "misconception": "times"
    },
    {
     "text": "{pw(b, n + 1)}",
     "misconception": "count"
    }
   ],
   "misconceptions": [
    {
     "id": "swapped",
     "explain": "The base is the number that is multiplied ({b}); the index counts how many times ({n})."
    },
    {
     "id": "times",
     "explain": "{b} × {n} is a multiplication, not a power. {b} appears {n} times: {pw(b, n)}."
    },
    {
     "id": "count",
     "explain": "Count again: {b} appears {n} times, not {n + 1}."
    }
   ],
   "solution": [
    "{b} appears {n} times, so the base is {b} and the index is {n}.",
    "{powExpand(b, n)} = {answer}"
   ],
   "where": [
    "b != n"
   ]
  },
  {
