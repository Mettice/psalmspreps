 "note": {
  "status": "draft",
  "text": "When you save or borrow money, interest is paid for the use of the money.\nSimple interest: I = P × R × T ÷ 100, where P is the principal (the amount), R the rate per cent per year, T the time in years.\nRearranged: R = 100 × I ÷ (P × T) and T = 100 × I ÷ (P × R).\nWith simple interest, the interest is the same every year.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "P": 50000,
   "R": 5,
   "T": 3,
   "hund": 100
  },
  "problem": "Find the simple interest on {P} FCFA at {R} % per year for {T} years.",
  "steps": [
   "I = P × R × T ÷ {hund}.",
   "I = {P} × {R} × {T} ÷ {hund} = {simpleInterest(P, R, T)} FCFA."
  ],
  "answer": "{simpleInterest(P, R, T)} FCFA",
  "checks": []
 },
