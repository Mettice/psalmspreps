 "note": {
  "status": "draft",
  "text": "For a sphere of radius r (take π = 3.14):\n• surface area A = 4πr²;\n• volume of the ball V = (4/3)πr³.\nExample: r = 3 cm: A = 4 × 3.14 × 9 = 113.04 cm²; V = 4 × 3.14 × 27 ÷ 3 = 113.04 cm³.\nIf you know the diameter, halve it first to get the radius.\nUnits: area in cm² (or m²); volume in cm³ (or m³).",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "r": 5
  },
  "problem": "Find the surface area of a sphere of radius {r} cm. Take π = {3.14}.",
  "steps": [
   "A = {4} × π × r² = {4} × {3.14} × {r * r}.",
   "= {sphereArea(r)} cm²."
  ],
  "answer": "{sphereArea(r)} cm²",
  "checks": [],
  "figure": "sphereFig(r)"
 },
