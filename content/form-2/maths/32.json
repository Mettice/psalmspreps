 "note": {
  "status": "draft",
  "text": "Area of a triangle = ½ × base × height, where the height is perpendicular to the base.\nAny side can be the base, as long as you use the height that goes with it.\nIn a right-angled triangle, the two sides next to the right angle are a base and its height: area = ½ × a × b.\nTo find a height: height = 2 × area ÷ base.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "b": 12,
   "h": 7
  },
  "problem": "A triangle has a base of {b} cm and a height of {h} cm. Find its area.",
  "steps": [
   "Area = ½ × base × height.",
   "½ × {b} × {h} = {b * h / 2} cm²."
  ],
  "answer": "{b * h / 2} cm²",
  "checks": []
 },
