 "note": {
  "status": "draft",
  "text": "When two straight lines cross, they make four angles.\n• Vertically opposite angles (across the crossing point) are equal.\n• Two angles next to each other on a straight line add up to 180° (they are supplementary).\n• All the angles around a point add up to 360°.\nExample: if one angle is 70°, the opposite angle is 70° and each angle next to it is 180° − 70° = 110°.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "a": 70,
   "st": 180,
   "rt": 90,
   "pt": 360
  },
  "problem": "Two straight lines cross. One angle is {a}°. Find the other three angles.",
  "steps": [
   "The angle opposite it is vertically opposite: {a}°.",
   "The angles next to it are on a straight line: {st}° − {a}° = {st - a}°.",
   "Check: {a} + {st - a} + {a} + {st - a} = {pt}°."
  ],
  "answer": "{a}°, {st - a}° and {st - a}°",
  "checks": [],
  "figure": "crossFig(a, 1)"
 },
