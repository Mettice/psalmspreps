 "skills": [
  {
   "id": "m2-43",
   "name": "Discount (reduction) and percentage"
  }
 ],
 "note": {
  "status": "draft",
  "text": "A discount (reduction) is an amount taken off the marked price. Discount = p % of the marked price.\nSale price = marked price − discount = marked price × (100 − p) ÷ 100.\nPercentage discount = discount ÷ marked price × 100.\nTo find the marked price from the sale price: marked price = sale price × 100 ÷ (100 − p).",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "m": 12000,
   "p": 15,
   "hund": 100
  },
  "problem": "A pair of shoes marked {m} FCFA is sold with a {p} % discount. Find the sale price.",
  "steps": [
   "Discount: {p} % of {m} = {m * p / 100} FCFA.",
   "Sale price: {m} − {m * p / 100} = {m * (100 - p) / 100} FCFA."
  ],
  "answer": "{m * (100 - p) / 100} FCFA",
  "checks": []
 },
