  {
   "id": "m2-27",
   "name": "Angles formed by a transversal to two parallel lines"
  }
 ],
 "note": {
  "status": "draft",
  "text": "A transversal is a line that cuts two parallel lines. It makes eight angles: four at each crossing.\n• Corresponding angles (in the same position at each crossing, an F shape) are equal.\n• Alternate angles (between the parallel lines, on opposite sides of the transversal, a Z shape) are equal.\n• Co-interior angles (between the parallel lines, on the same side, a C or U shape) add up to 180°.\n• Vertically opposite angles are still equal and angles on a straight line still add up to 180°.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "a": 70,
   "g": 70,
   "P": [
    5,
    2
   ],
   "st": 180,
   "rt": 90,
   "pt": 360
  },
  "problem": "Two parallel lines are cut by a transversal. One angle is {g}°. Find x.",
  "steps": [
   "x and the {g}° angle are between the parallel lines, on opposite sides of the transversal: they are alternate.",
   "Alternate angles are equal: x = {g}°."
  ],
  "answer": "x = {g}°",
  "checks": [],
  "figure": "parallelFig(g, P[0], P[1])"
 },
