 "note": {
  "status": "draft",
  "text": "Two quantities are in inverse proportion when one increases as the other decreases in the same ratio: twice as many workers → half the time. Their product is constant (x × y = k).\nMethod: find the total (the product), then divide. 6 workers build a wall in 10 days: the job is 6 × 10 = 60 worker-days. 4 workers need 60 ÷ 4 = 15 days.\nThe same works for speed and time on a fixed journey: speed × time = distance.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "n": 6,
   "d": 10,
   "m": 4
  },
  "problem": "{n} workers build a wall in {d} days. How long would {m} workers take?",
  "steps": [
   "The job is {n} × {d} = {n * d} worker-days.",
   "{m} workers: {n * d} ÷ {m} = {n * d / m} days."
  ],
  "answer": "{n * d / m} days",
  "checks": []
 },
