   "id": "m2-35",
   "name": "Significant figures"
  }
 ],
 "note": {
  "status": "draft",
  "text": "Significant figures (s.f.) are the digits that carry meaning, counted from the first non-zero digit.\n• Zeros at the start of a decimal are not significant: 0.0305 has 3 s.f. (3, 0, 5).\n• Zeros between non-zero digits are significant: 506 has 3 s.f.\n• Zeros at the end of a decimal are significant: 4.50 has 3 s.f.\nTo round to k s.f., keep k digits from the first non-zero digit and round the last one; fill with zeros to keep the place value: 45 678 → 46 000 (2 s.f.); 0.004563 → 0.00456 (3 s.f.).",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "x": 0.004563
  },
  "problem": "Round {x} to {3} significant figures.",
  "steps": [
   "The first non-zero digit is {4}: count {4}, {5}, {6}.",
   "The next digit is {3}, less than {5}: keep {6}.",
   "{x} → {sigFig(x, 3)}."
  ],
  "answer": "{sigFig(x, 3)}",
  "checks": []
 },
