   "name": "The sphere: centre, radius, diameter"
  }
 ],
 "note": {
  "status": "draft",
  "text": "A sphere is the set of all points in space at the same distance from a fixed point called the centre. It is a round, hollow surface, like the skin of a ball.\nA ball (boule) is the solid sphere: the sphere and all the points inside it.\n• The radius r is the distance from the centre to any point on the sphere.\n• The diameter d is a segment through the centre joining two points of the sphere: d = 2r.\n• A great circle is a circle on the sphere whose centre is the centre of the sphere (like the Equator on the Earth).\nExamples: a football, an orange, the Earth (approximately), a marble.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "d": 22
  },
  "problem": "A football has a diameter of {d} cm. What is its radius?",
  "steps": [
   "The diameter is twice the radius: d = {2}r.",
   "r = {d} ÷ {2} = {d / 2} cm."
  ],
  "answer": "{d / 2} cm",
  "checks": [],
  "figure": "sphereFig(d / 2)"
 },
