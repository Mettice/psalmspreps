        },
        {
         "w": "vertices"
        }
       ]
      }
     },
     "prompt": "How many {X.w} does a {baseName(n, 'prism')} prism have?",
     "answer": "X.w == 'edges' ? prismEdges(n) : prismVertices(n)",
     "misconceptions": [
      {
       "id": "swap",
       "wrong": "X.w == 'edges' ? prismVertices(n) : prismEdges(n)",
       "explain": "Edges are lines; vertices are corners: count the right ones."
      },
      {
       "id": "half",
       "wrong": "n",
       "explain": "Count both bases."
      }
     ],
     "solution": [
      "{X.w == 'edges' ? 'Edges: ' + str(n) + ' on each base and ' + str(n) + ' lateral edges.' : 'Vertices: ' + str(n) + ' on each base.'}",
      "So there are {answer} {X.w}."
     ],
     "figure": "prismFig(n)"
    }
   },
   {
    "id": "c56-3",
    "status": "draft",
    "idea": "Euler's relation: F + V − E = {2}.",
    "vars": {},
    "example": [
     "Cuboid: {6} + {8} − {12} = {2}."
    ],
    "checks": [],
    "check": {
