     "type": "numeric",
     "level": 1,
     "review": "rule",
     "sources": [
      "prisms"
     ],
     "vars": {
      "n": {
       "pick": [
        3,
        4,
        5,
        6,
        7,
        8
       ]
      },
      "f": {
       "expr": "prismFaces(n)"
      },
      "v": {
       "expr": "prismVertices(n)"
      }
     },
     "prompt": "A prism has {f} faces and {v} vertices. Use F + V − E = 2 to find its number of edges.",
     "answer": "f + v - 2",
     "misconceptions": [
      {
       "id": "plus",
       "wrong": "f + v + 2",
       "explain": "E = F + V − {2}: subtract {2}."
      },
      {
       "id": "sum",
       "wrong": "f + v",
       "explain": "Subtract {2}."
      }
     ],
     "solution": [
      "F + V − E = {2}, so E = F + V − {2}.",
      "E = {f} + {v} − {2} = {answer}."
     ]
    }
   }
  ]
 },
