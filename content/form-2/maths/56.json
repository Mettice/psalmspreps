 "note": {
  "status": "draft",
  "text": "For a prism whose base has n sides:\n• lateral faces: n; total faces: n + 2 (n lateral faces and 2 bases);\n• edges: 3n (n on each base and n lateral edges);\n• vertices: 2n (n on each base).\nExample: a pentagonal prism (n = 5) has 5 lateral faces, 7 faces, 15 edges and 10 vertices.\nEuler's relation for these solids: faces + vertices − edges = 2. For the pentagonal prism: 7 + 10 − 15 = 2.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "n": 6
  },
  "problem": "How many faces, edges and vertices does a hexagonal prism have?",
  "steps": [
   "A hexagon has {n} sides: n = {n}.",
   "Faces = n + {2} = {prismFaces(n)}; edges = {3}n = {prismEdges(n)}; vertices = {2}n = {prismVertices(n)}."
  ],
  "answer": "{prismFaces(n)} faces, {prismEdges(n)} edges, {prismVertices(n)} vertices",
  "checks": [],
  "figure": "prismFig(n)"
 },
 "teach": {
  "cards": [
   {
    "id": "c56-1",
    "status": "draft",
    "idea": "A prism with an n-sided base has n lateral faces and n + {2} faces in all.",
    "vars": {},
    "example": [
     "Triangular prism: {3} + {2} = {5} faces."
    ],
    "checks": [],
    "figure": "prismFig(3)",
