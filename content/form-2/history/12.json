  "vars": {
   "r": "Idris Alooma"
  },
  "problem": "Give two reasons why {r} made Kanem-Bornu strong.",
  "steps": [
   "He bought firearms and hired Turkish musketeers, so his army was stronger than its enemies.",
   "He ruled by Islamic law and organised the government well."
  ],
  "answer": "Firearms for the army, and good government under Islamic law.",
  "checks": []
 },
