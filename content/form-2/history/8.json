  "vars": {
   "a": "Bamum",
   "b": "Beti"
  },
  "problem": "Compare the political organisation of the {a} and the {b}.",
  "steps": [
   "{a}: one powerful sultan with a palace, officials, an army and tribute.",
   "{b}: no single ruler; family heads and councils of elders shared authority, villages were independent."
  ],
  "answer": "{a}: centralised under a sultan; {b}: egalitarian, with elders and family heads.",
  "checks": []
 },
