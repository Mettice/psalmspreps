   "id": "y2-7",
   "name": "Egalitarian (stateless) societies of pre-colonial Cameroon"
  }
 ],
 "note": {
  "status": "draft",
  "text": "Egalitarian (segmentary or stateless) societies had no single ruler over everyone. Authority was shared:\n• each family or clan was led by its head (often the eldest man);\n• councils of elders settled disputes and decided important matters;\n• age groups, secret societies and diviners also had roles;\n• villages were independent but linked by family ties and marriage.\nExamples: the Beti (Ewondo, Bulu, Eton), the Bassa, the Bakweri and many coastal and forest peoples; the Mafa and other peoples of the northern mountains.\nComparison: centralised societies have one strong ruler, taxes and an army; egalitarian societies share power among family heads and elders, with no taxes or standing army.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "s": "a Beti village"
  },
  "problem": "How was a dispute settled in {s} without a king?",
  "steps": [
   "The heads of the families involved met in a council of elders.",
   "The elders listened to both sides and decided, using custom; the decision was respected because of the elders' authority."
  ],
  "answer": "By the council of elders, following custom.",
  "checks": []
 },
