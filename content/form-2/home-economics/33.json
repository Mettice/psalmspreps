   "id": "h2-33",
   "name": "Kitchen accidents: causes and prevention"
  }
 ],
 "note": {
  "status": "draft",
  "text": "Causes: carelessness and hurry; poor lighting; wet or oily floors; pot handles sticking out over the cooker; blunt or badly stored knives; children playing in the kitchen; damaged wires and wet hands; gas leaks; chemicals in food bottles; loose clothes near flames.\nPrevention:\n• turn pot handles inwards; use oven gloves;\n• wipe spills at once; keep the floor clear;\n• keep knives sharp, store them safely, cut away from the body;\n• keep children away from the cooker; store chemicals and medicines high and labelled, never in food bottles;\n• dry hands before touching switches; repair damaged wires;\n• never leave hot oil alone; turn off gas; keep a fire blanket or sand;\n• good lighting and ventilation; a first aid box.\nFirst aid for a small burn or scald: cool it under clean running water for about 20 minutes; do not apply oil or toothpaste.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "x": "a small burn on the hand"
  },
  "problem": "What first aid should be given for {x}?",
  "steps": [
   "Cool the burn under clean running water for about {20} minutes.",
   "Cover it loosely with a clean cloth; do not put oil, butter or toothpaste on it."
  ],
  "answer": "Cool with running water for about {20} minutes and cover loosely.",
  "checks": []
 },
