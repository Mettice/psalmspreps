   "name": "Kitchen accidents: notion and types"
  }
 ],
 "note": {
  "status": "draft",
  "text": "A kitchen accident is an unexpected event in the kitchen that causes injury or damage.\nTypes:\n• burns (from flames, hot pots, hot oil) and scalds (from boiling water or steam);\n• cuts (knives, broken glass, tin lids);\n• falls (wet or oily floors, objects on the floor, climbing on chairs);\n• electric shocks (wet hands, damaged wires);\n• fires (hot oil, gas leaks, cloth near flames);\n• poisoning (cleaning chemicals, spoiled food, kerosene in drink bottles);\n• suffocation from smoke or carbon monoxide; gas explosions.\nYoung children and old people are most at risk.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "x": "boiling water spills on a child's arm"
  },
  "problem": "What type of accident is it when {x}?",
  "steps": [
   "Boiling water or steam causes a scald.",
   "Dry heat or flames cause a burn."
  ],
  "answer": "A scald.",
  "checks": []
 },
