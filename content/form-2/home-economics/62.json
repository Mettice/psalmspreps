   "id": "h2-62",
   "name": "Types of irons"
  }
 ],
 "note": {
  "status": "draft",
  "text": "An iron removes creases from clothes using heat and pressure.\n• Traditional (charcoal or box) iron: a hollow metal iron filled with hot charcoal; no electricity needed; heat is hard to control and ash can soil clothes. Flat irons heated on a fire are also traditional.\n• Dry electric iron: a heating element and a thermostat with a temperature dial.\n• Steam iron: has a water tank; steam is pushed through holes in the soleplate to relax creases.\n• Steam generator iron: a separate water tank (station) produces a lot of steam under pressure; irons faster.\n• Automatic iron: switches itself off when left still or lying down (auto shut-off), for safety.\nChoose an iron according to the electricity available, the fabrics, the price and safety.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {},
  "problem": "A family in a village without electricity needs an iron. Which type should they use?",
  "steps": [
   "Electric irons need electricity.",
   "A traditional charcoal iron works without electricity."
  ],
  "answer": "A traditional charcoal (box) iron.",
  "checks": []
 },
