   "id": "h2-50",
   "name": "Rickets and osteomalacia"
  }
 ],
 "note": {
  "status": "draft",
  "text": "Rickets (in children) and osteomalacia (in adults) are diseases of soft, weak bones.\nCause: a lack of vitamin D, calcium or phosphorus. Vitamin D helps the body absorb calcium; the skin makes it in sunlight.\nSigns of rickets: bowed legs (legs curved outwards) or knock knees, swollen wrists and ankles, delayed walking and teething, a chest that sticks out (pigeon chest), weak muscles.\nSigns of osteomalacia: bone pain, muscle weakness, bones that break easily.\nSources: vitamin D — sunlight, egg yolk, oily fish (sardines, mackerel), liver, fortified milk; calcium — milk, cheese, small fish eaten with bones (crayfish), green vegetables, beans.\nPrevention: let babies and children play in the morning sun; give milk, eggs, fish and crayfish; breastfeed.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {},
  "problem": "A two-year-old has bowed legs and swollen wrists and stays indoors all day. What disease may the child have, and what would help?",
  "steps": [
   "Bowed legs and swollen wrists are signs of rickets (lack of vitamin D or calcium).",
   "Let the child play in the morning sun, and give milk, eggs and fish."
  ],
  "answer": "Rickets: sunlight, milk, eggs and fish.",
  "checks": []
 },
