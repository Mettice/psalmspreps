 "note": {
  "status": "draft",
  "text": "Labour-saving equipment are appliances that reduce the time and effort needed for kitchen work.\n• Microwave oven: heats, cooks and defrosts food quickly.\n• Pressure cooker: cooks food (beans, tough meat, corn chaff) much faster than an ordinary pot.\n• Blender (liquidiser): blends, purées and grinds (tomatoes, pepper, juice, egusi).\n• Mixer: beats, whisks and mixes (cakes, eggs, dough).\n• Vacuum flask: keeps food or drinks hot or cold for many hours.\n• Others: food processor, electric kettle, toaster, rice cooker, electric grinder, kitchen scale.\nMost use electricity; the pressure cooker and vacuum flask do not.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "t": "a pressure cooker"
  },
  "problem": "How does {t} save labour when cooking dry beans?",
  "steps": [
   "Beans take hours in an ordinary pot.",
   "A pressure cooker cooks them in a fraction of the time, saving fuel and effort."
  ],
  "answer": "It cooks the beans much faster, saving time and fuel.",
  "checks": []
 },
