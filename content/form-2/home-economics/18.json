   "id": "h2-18",
   "name": "Advantages, disadvantages and care of a traditional kitchen"
  }
 ],
 "note": {
  "status": "draft",
  "text": "Advantages: built with cheap local materials; uses local fuels; the smoke rack preserves food; a separate hut keeps smoke and fire away from the house; a place where the family gathers.\nDisadvantages: smoke irritates the eyes and lungs; walls and pots get dirty with soot; risk of fire (thatched roofs); hard work fetching firewood; cutting trees harms the environment; less hygienic floors.\nCare of a traditional kitchen:\n• sweep daily and remove ashes when the fire is cold;\n• keep firewood dry and stacked away from the fire;\n• wash pots and utensils after use and store them on a shelf;\n• cover food and water; keep animals out;\n• clean soot from walls and the smoke rack regularly;\n• put the fire out after cooking and keep water or sand near for emergencies.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "r": "a thatched roof"
  },
  "problem": "A traditional kitchen has {r}. Give two safety rules.",
  "steps": [
   "Never leave the fire burning when nobody is in the kitchen, and put it out after cooking.",
   "Keep a bucket of water or sand near, and keep the fire low under the roof."
  ],
  "answer": "Put the fire out after cooking; keep water or sand nearby.",
  "checks": []
 },
