   "id": "h2-49",
   "name": "Obesity: causes, signs and prevention"
  }
 ],
 "note": {
  "status": "draft",
  "text": "Obesity is a condition in which a person has too much body fat for their height, enough to harm health.\nCauses: eating more energy (calories) than the body uses — too much fried food, sugar, sweet drinks, snacks and large portions; little physical activity (sitting a lot, screens); some hormonal problems and family habits.\nSigns and symptoms: excess weight, large waist, tiredness and breathlessness when walking, joint pain, snoring, low self-esteem; a high BMI (30 or more for adults).\nEffects: high blood pressure, heart disease, diabetes, joint problems.\nPrevention: a balanced diet with plenty of fruit and vegetables; fewer fried foods, sugar and sweet drinks; drink water; eat regular meals of reasonable size; exercise every day; limit screen time; check weight regularly.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {},
  "problem": "A pupil drinks two sodas and eats fried snacks every afternoon while watching television. Give two changes to prevent obesity.",
  "steps": [
   "Replace sodas and fried snacks with water and fruit.",
   "Replace some television time with physical activity such as football or walking."
  ],
  "answer": "Drink water and eat fruit instead; exercise instead of watching television.",
  "checks": []
 },
