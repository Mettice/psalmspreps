   "id": "h2-38",
   "name": "Moist methods of cooking"
  }
 ],
 "note": {
  "status": "draft",
  "text": "Moist methods cook food in water, another liquid or steam.\n• Boiling: in water at 100 °C, bubbling (yams, rice, eggs, plantain).\n• Simmering: just below boiling, gentle bubbles (soups, sauces).\n• Stewing: slowly in a little liquid in a covered pot (meat stew, ndolé).\n• Steaming: in the steam from boiling water (koki, moi-moi, bobolo, fish in leaves).\n• Poaching: gently in liquid below boiling (eggs, fish).\n• Braising: browning first, then cooking slowly in a little liquid.\nAdvantages: food does not burn easily; tough meat becomes tender; little fat is used, so it is healthy; the liquid can be eaten as soup; steaming keeps more nutrients.\nDisadvantages: vitamins B and C and minerals dissolve into the water (lost if it is thrown away); long cooking can make food soft and tasteless; it takes time and fuel.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "v": "vegetables boiled for a long time in a lot of water"
  },
  "problem": "What happens to the nutrients of {v}?",
  "steps": [
   "Vitamins B and C and minerals dissolve into the cooking water.",
   "Long heating destroys vitamin C, and the water is often thrown away."
  ],
  "answer": "Many vitamins and minerals are lost.",
  "checks": []
 },
