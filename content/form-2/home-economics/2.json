  "vars": {
   "f": "garri"
  },
  "problem": "Explain why hot water makes {f} swell into eba.",
  "steps": [
   "Garri is mainly starch, from cassava.",
   "In hot water the starch grains take in water, swell and burst: gelatinisation.",
   "This makes the mixture thick and soft."
  ],
  "answer": "The starch gelatinises: its grains swell and thicken in hot water.",
  "checks": []
 },
