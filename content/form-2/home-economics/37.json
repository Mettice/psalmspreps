   "m": "koki steamed in leaves"
  },
  "problem": "Is {m} a moist or a dry method? Why?",
  "steps": [
   "Steaming cooks food with the steam from boiling water.",
   "Steam is moist heat."
  ],
  "answer": "A moist method.",
  "checks": []
 },
