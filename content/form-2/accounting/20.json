   "id": "a2-20",
   "name": "Business finance: types, contributions and subsidies"
  }
 ],
 "note": {
  "status": "draft",
  "text": "A business needs money (finance) to start and to grow. Sources:\n• Own funds (internal): the owner's contributions (capital), profits kept in the business (reserves).\n• Borrowed funds (external): loans from banks and others, leasing, credit from suppliers.\n• Subsidies: money given by the State or another body, without repayment, for a purpose (an investment subsidy to buy equipment; an operating subsidy to help run the business).\nContributions: the owner (or partners) bring cash, goods or fixed assets into the business; this is recorded as capital (account 101 or 103). Contribution in cash: debit 521 Bank or 571 Cash, credit 101 Capital.\nInvestment subsidies are recorded in account 14; operating subsidies in account 71.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "c": 2000000
  },
  "problem": "Mr Tabe starts a shop by paying {c} FCFA into the business bank account. Which accounts are used?",
  "steps": [
   "Money goes into the bank: debit {521} Bank.",
   "It is the owner's contribution: credit {101} Capital."
  ],
  "answer": "Debit {521} Bank, credit {101} Capital: {c} FCFA.",
  "checks": []
 },
