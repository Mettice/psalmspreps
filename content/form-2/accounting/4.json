 "note": {
  "status": "draft",
  "text": "The accounting (balance sheet) equation is: Assets = Liabilities + Owner's equity.\nIt can be turned round:\n• Owner's equity = Assets − Liabilities;\n• Liabilities = Assets − Owner's equity.\nExample: assets 5 000 000 FCFA, liabilities 1 500 000 FCFA, so owner's equity = 3 500 000 FCFA.\nEvery transaction changes the equation, but it always stays balanced: buying equipment with cash changes two assets (equipment up, cash down); buying goods on credit raises an asset (stock) and a liability (creditors) by the same amount.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "a": 5000000,
   "l": 1500000
  },
  "problem": "A business has assets of {a} FCFA and liabilities of {l} FCFA. Find the owner's equity.",
  "steps": [
   "Owner's equity = Assets − Liabilities.",
   "{a} − {l} = {a - l} FCFA."
  ],
  "answer": "{a - l} FCFA",
  "checks": [
   "a - l == 3500000"
  ]
 },
