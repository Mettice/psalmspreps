 "note": {
  "status": "draft",
  "text": "Single entry: each transaction is recorded only once, usually in a cash book. It is simple, but incomplete: it does not show all assets and debts and makes errors hard to find.\nDouble entry: every transaction affects at least two accounts; it is recorded on the debit side of one account and on the credit side of another, for the same amount.\n“For every debit there is a corresponding credit.” So, at any time, total debits = total credits in the whole ledger.\nExamples:\n• Cash sale of 60 000: debit Cash 60 000, credit Sales 60 000.\n• Equipment bought by cheque for 400 000: debit Equipment 400 000, credit Bank 400 000.\nDouble entry is the system used by OHADA accounting and by businesses everywhere.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "a": 250000
  },
  "problem": "Record by double entry: goods bought on credit from Fon Traders for {a} FCFA.",
  "steps": [
   "Purchases (goods received) is debited {a}.",
   "Fon Traders, a creditor, is credited {a}.",
   "Total debit = total credit = {a}."
  ],
  "answer": "Debit Purchases {a}; credit Fon Traders {a}.",
  "checks": []
 },
