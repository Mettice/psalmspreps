 "note": {
  "status": "draft",
  "text": "Flows are drawn as arrows between boxes: the business in the middle, partners around it. A solid arrow for real flows and a dashed arrow for financial flows, each labelled with the amount.\nExample: goods (real) → from the supplier to the shop; cash (financial) → from the shop to the supplier.\nAccounting analysis then uses accounts. For each transaction ask:\n1. Which accounts are affected?\n2. Does each one increase or decrease?\n3. Which account is debited and which credited?\nRule for flows: the account that receives (the destination of the flow) is debited; the account that gives (the origin) is credited.\nExample: buying equipment for cash: Equipment receives (debit), Cash gives (credit).",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "r": 100000
  },
  "problem": "Analyse: the business pays rent of {r} FCFA in cash.",
  "steps": [
   "Accounts affected: Rent (an expense) and Cash.",
   "Rent receives the value (the service of the premises): debit Rent.",
   "Cash gives the money: credit Cash."
  ],
  "answer": "Debit Rent {r}; credit Cash {r}.",
  "checks": []
 },
