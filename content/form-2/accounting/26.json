 "note": {
  "status": "draft",
  "text": "Cash transactions are receipts (money in) and payments (money out) using cash in hand (571) or the bank (521).\n• Money received: debit 571 Cash or 521 Bank; credit the account that explains it (701 Sales for a cash sale, 411 Customers when a customer pays a debt).\n• Money paid: credit 571 or 521; debit the account that explains it (601 Purchases, 401 Suppliers, 661 Salaries, 605 Electricity).\n• Transfers between cash and bank: depositing cash into the bank (debit 521, credit 571), withdrawing (debit 571, credit 521).\nPayment methods: cash, cheque, bank transfer, mobile money.\nCash balance = opening balance + receipts − payments. The cash book records each movement in order of date.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "o": 150000,
   "r": 320000,
   "p": 210000
  },
  "problem": "The cash balance is {o} FCFA. Receipts are {r} FCFA and payments {p} FCFA. Find the closing balance.",
  "steps": [
   "Closing balance = opening + receipts − payments.",
   "{o} + {r} − {p} = {o + r - p} FCFA."
  ],
  "answer": "{o + r - p} FCFA",
  "checks": []
 },
