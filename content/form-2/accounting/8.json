 "note": {
  "status": "draft",
  "text": "Recording transactions in accounts lets the business know at any time how much it has in each item.\nBalance sheet accounts follow their side of the balance sheet:\n• Asset accounts (left side of the balance sheet): an increase is debited, a decrease is credited. Their opening balance is a debit.\n• Capital and liability accounts (right side): an increase is credited, a decrease is debited. Their opening balance is a credit.\nExamples: cash received → debit Cash; cash paid → credit Cash. A loan received → credit Bank loan; part of the loan repaid → debit Bank loan.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "a": 1000000
  },
  "problem": "Record: the business borrows {a} FCFA from the bank, paid into its bank account.",
  "steps": [
   "Bank (an asset) increases: debit Bank {a}.",
   "Bank loan (a liability) increases: credit Bank loan {a}."
  ],
  "answer": "Debit Bank; credit Bank loan.",
  "checks": []
 },
