   "id": "a2-7",
   "name": "The nature and layout of ledger accounts"
  }
 ],
 "note": {
  "status": "draft",
  "text": "An account is a record of all the changes in one item (Cash, Bank, Equipment, Sales, Capital …). All the accounts together form the ledger.\nThe simplest form is the T-account: the name of the account at the top, the left side for debits (Dr) and the right side for credits (Cr).\nEach entry shows the date, the details (the name of the other account, or a short description) and the amount.\nExample: Cash account. Debit side: 1 June, Capital, 500 000. Credit side: 3 June, Rent, 100 000.\nDebit means the left side; credit means the right side. The words do not mean good or bad.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "c": 500000,
   "r": 100000,
   "d1": 1,
   "d3": 3
  },
  "problem": "Show in a Cash T-account: on {d1} June the owner brought {c} FCFA in cash; on {d3} June rent of {r} FCFA was paid in cash.",
  "steps": [
   "Cash received ({c}, from Capital) goes on the debit (left) side.",
   "Cash paid ({r}, for Rent) goes on the credit (right) side.",
   "Each entry shows the date, the other account and the amount."
  ],
  "answer": "Dr: {d1} June Capital {c} | Cr: {d3} June Rent {r}",
  "checks": []
 },
