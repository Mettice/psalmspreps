   "id": "a2-13",
   "name": "The OHADA accounting system: definition, objectives and structure"
  }
 ],
 "note": {
  "status": "draft",
  "text": "OHADA (Organisation pour l'Harmonisation en Afrique du Droit des Affaires, the Organisation for the Harmonisation of Business Law in Africa) was created by a treaty signed in Port Louis in 1993. It has 17 member states, including Cameroon.\nIts accounting system, SYSCOHADA (revised in 2017), gives all member states the same accounting rules.\nObjectives: common rules so that accounts can be compared; reliable information for owners, banks, the State and investors; easier trade and investment between member states; legal security for businesses.\nDomain: it applies to businesses (traders, companies, cooperatives) in member states.\nStructure: accounts are arranged in classes numbered 1 to 9.\n• Classes 1–5: balance sheet accounts.\n• Classes 6–8: income statement (management) accounts.\n• Class 9: commitments and cost (analytical) accounts.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "x": "a trader in Douala and a trader in Dakar"
  },
  "problem": "Why does OHADA help {x}?",
  "steps": [
   "Both countries are OHADA members and use the same accounting rules (SYSCOHADA).",
   "Their accounts can be read and compared in the same way by banks and partners."
  ],
  "answer": "They use the same accounting rules, so their accounts are comparable.",
  "checks": []
 },
