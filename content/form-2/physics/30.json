 "note": {
  "status": "draft",
  "text": "Global warming is the slow rise in the average temperature of the Earth, caused mainly by the extra greenhouse gases that people add to the atmosphere.\nConsequences: melting glaciers and ice, rising sea levels (flooding of coasts such as Limbé and Kribi), more droughts in the Sahel and the north of Cameroon, heavier rains and floods, loss of crops and animals, the spread of diseases like malaria to new areas.\nSolutions: plant trees, use renewable energy, save energy, stop bush fires, use public transport, reduce waste.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {},
  "problem": "Give one consequence of global warming for the north of Cameroon and one for the coast.",
  "steps": [
   "North: longer droughts dry up wells and crops.",
   "Coast: rising sea levels flood low land."
  ],
  "answer": "droughts in the north; flooding on the coast",
  "checks": []
 },
