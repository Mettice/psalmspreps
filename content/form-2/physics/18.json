 "note": {
  "status": "draft",
  "text": "A simple circuit has a source (cell, battery or mains), connecting wires, a switch and a load (bulb, motor). Current flows only when the circuit is closed (complete).\nSymbols: cell —| |—, bulb ⊗, switch, wire.\nIn the home: the mains supply (220 V in Cameroon), the meter, fuses or circuit breakers (they cut the current if it is too large), sockets, switches and earthing for safety.\nPower P = V × I (watts = volts × amperes). Energy used in kWh = power (kW) × time (h); cost = kWh × price per kWh.\nSafety: never touch switches with wet hands, do not overload sockets, do not repair wiring yourself.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "P": 100,
   "h": 5,
   "c": 80
  },
  "problem": "A {P} W bulb is on for {h} hours. Electricity costs {c} FCFA per kWh. Find the cost.",
  "steps": [
   "Energy: {P} W = {P / 1000} kW; {P / 1000} × {h} = {kWh(P, h)} kWh.",
   "Cost: {kWh(P, h)} × {c} = {elecCost(P, h, c)} FCFA."
  ],
  "answer": "{elecCost(P, h, c)} FCFA",
  "checks": []
 },
