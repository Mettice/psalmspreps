 ],
 "note": {
  "status": "draft",
  "text": "Matter is anything that has mass and takes up space. It exists in three main states:\n• solid: stone, ice, wood, iron, salt;\n• liquid: water, palm oil, petrol, milk, kerosene;\n• gas: air, oxygen, steam (water vapour), cooking gas, carbon dioxide.\nThe same substance can exist in all three states: ice (solid), water (liquid), steam (gas).\nA substance changes state when it is heated or cooled: melting (solid → liquid), evaporation or boiling (liquid → gas), condensation (gas → liquid), freezing (liquid → solid), sublimation (solid → gas, for example naphthalene balls).",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "s": "water"
  },
  "problem": "Name the three states of {s} and the change of state from each one to the next when it is heated.",
  "steps": [
   "Solid: ice. Heating it: melting, it becomes liquid water.",
   "Liquid: water. Heating it more: boiling, it becomes steam.",
   "Gas: steam (water vapour)."
  ],
  "answer": "ice → (melting) → water → (boiling) → steam",
  "checks": []
 },
