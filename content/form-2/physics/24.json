 "note": {
  "status": "draft",
  "text": "During exercise, muscles contract and need more energy and oxygen, so the heart beats faster and we breathe faster. The pulse rate (beats per minute) rises.\nTo find the pulse rate: count the beats for 15 seconds and multiply by 4 (or count for 30 s and multiply by 2).\nBenefits of regular exercise: a stronger heart and muscles, lower blood pressure, healthy weight, better sleep and mood.\nMuscle stress and injuries: warm up before exercise, stretch after, drink water, rest; too much exercise without rest causes strains and cramps.\nA common guide for the maximum heart rate is 220 − age (beats per minute).",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "b": 22,
   "s": 15
  },
  "problem": "Ngum counts {b} beats in {s} seconds. What is her pulse rate?",
  "steps": [
   "A minute has {60} s: {60} ÷ {s} = {60 / s}.",
   "{b} × {60 / s} = {pulseRate(b, s)} beats per minute."
  ],
  "answer": "{pulseRate(b, s)} beats per minute",
  "checks": []
 },
