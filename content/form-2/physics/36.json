 "note": {
  "status": "draft",
  "text": "A technical drawing shows exactly how to make an object, with its shape and sizes.\nTools: a pencil (HB, 2H), a ruler, a set square, a protractor, compasses, an eraser.\nLines: thick continuous lines for visible edges; dashed lines for hidden edges; thin chain lines (long and short dashes) for centre lines; dimension lines with arrows and the size written above.\nViews (orthographic projection): the front view (elevation), the side view and the top view (plan).\nScale: the ratio of the size on the drawing to the real size. Scale 1 : 10 means 1 cm on the drawing is 10 cm in reality.\nReal length = drawing length × scale number; drawing length = real length ÷ scale number.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "d": 4,
   "k": 20
  },
  "problem": "On a drawing at scale {1} : {k}, a table leg is {d} cm long. What is its real length?",
  "steps": [
   "1 cm on the drawing is {k} cm in reality.",
   "Real length = {d} × {k} = {d * k} cm."
  ],
  "answer": "{d * k} cm",
  "checks": []
 },
