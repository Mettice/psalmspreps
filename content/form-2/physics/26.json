 "note": {
  "status": "draft",
  "text": "Sustainable management means using natural resources (forests, water, soil, energy, fish) so that they are still available for future generations.\nGood practices: replanting trees after cutting (reforestation), saving energy and water, using renewable energy, reducing, reusing and recycling waste, protecting rivers from pollution, controlled fishing and hunting, protected areas (national parks such as Korup, Waza and Dja).\nBad practices: bush fires, cutting trees without replanting, dumping waste in rivers, overfishing, wasting electricity.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {},
  "problem": "Is cutting a forest for timber sustainable?",
  "steps": [
   "It depends: if as many trees are replanted as are cut, the forest stays.",
   "If trees are cut and none are replanted, the forest disappears: not sustainable."
  ],
  "answer": "Only if trees are replanted.",
  "checks": []
 },
