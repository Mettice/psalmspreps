   "id": "p2-23",
   "name": "Pressure in liquids and blood pressure"
  }
 ],
 "note": {
  "status": "draft",
  "text": "Pressure is force per unit area: pressure (Pa) = force (N) ÷ area (m²).\nIn a liquid, pressure increases with depth and acts in all directions: p = density × g × depth (with g ≈ 10 N/kg).\nBlood pressure is the pressure of blood on the walls of the arteries, caused by the pumping of the heart. It is written as two numbers in millimetres of mercury (mmHg), for example 120/80: the higher (systolic) when the heart contracts, the lower (diastolic) when it relaxes. A doctor measures it with a sphygmomanometer.\nHigh blood pressure (hypertension) is dangerous; it is linked to too much salt, obesity, lack of exercise, smoking and stress.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "rho": 1000,
   "h": 3
  },
  "problem": "Find the pressure of water ({rho} kg/m³) at a depth of {h} m (g = {10} N/kg).",
  "steps": [
   "p = density × g × depth.",
   "{rho} × {10} × {h} = {liquidPressure(rho, h)} Pa."
  ],
  "answer": "{liquidPressure(rho, h)} Pa",
  "checks": []
 },
