 "note": {
  "status": "draft",
  "text": "A light receiver is something that detects or uses light: the eye, a camera (film or sensor), a solar cell, a photosensitive paper, a plant leaf (photosynthesis).\nMaterials and light:\n• transparent: light passes through and we see clearly (clear glass, water, air);\n• translucent: some light passes but we cannot see clearly (frosted glass, tracing paper, oiled paper);\n• opaque: no light passes (wood, metal, stone, cardboard); opaque objects make shadows.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {},
  "problem": "Classify: clear glass, frosted glass, a wooden door.",
  "steps": [
   "Clear glass lets light through and we see clearly: transparent.",
   "Frosted glass lets some light through: translucent.",
   "A wooden door lets no light through: opaque."
  ],
  "answer": "transparent, translucent, opaque",
  "checks": []
 },
