  {
   "id": "p2-1-mean",
   "type": "numeric",
   "level": 1,
   "review": "rule",
   "sources": [
    "scientific-method"
   ],
   "vars": {
    "a": {
     "int": [
      10,
      40
     ]
    },
    "d1": {
     "int": [
      -2,
      2
     ]
    },
    "d2": {
     "int": [
      -2,
      2
     ]
    },
    "b": {
     "expr": "a + d1"
    },
    "c": {
     "expr": "a + d2"
    },
    "n": 3
   },
   "prompt": "The readings are {readings([a, b, c])}. What is their mean?",
   "answer": "mean([a, b, c])",
   "misconceptions": [
    {
     "id": "sum",
     "wrong": "a + b + c",
     "explain": "That is the total. Divide it by {n}."
    },
    {
     "id": "middle",
     "wrong": "max(a, max(b, c))",
     "explain": "The mean is not the largest reading: add them and divide by {n}.",
     "when": "max(a, max(b, c)) != mean([a, b, c])"
    }
   ],
   "solution": [
    "Add: {a} + {b} + {c} = {a + b + c}.",
    "Divide by the number of readings: {a + b + c} ÷ {n} = {answer}."
   ],
   "where": [
    "isInt((a + b + c) / 3)"
   ]
  },
