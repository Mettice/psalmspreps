 "note": {
  "status": "draft",
  "text": "Speed is the distance travelled in one unit of time. Speed = distance ÷ time.\nUnits: metres per second (m/s), the SI unit, or kilometres per hour (km/h) for vehicles.\nA car at 60 km/h would travel 60 km in one hour.\nConverting: 1 km/h = 1000 m ÷ 3600 s, so divide km/h by 3.6 to get m/s: 72 km/h = 20 m/s. Multiply m/s by 3.6 to get km/h.\nMeasuring speed: mark a distance with a tape measure, time the object over it with a stopwatch, then divide. This gives the average speed: the object may go faster and slower along the way.\nA speedometer shows a vehicle's speed at each moment.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "d": 100,
   "t": 20
  },
  "problem": "Ewane runs {d} m in {t} s. What is his average speed?",
  "steps": [
   "Speed = distance ÷ time.",
   "Speed = {d} ÷ {t} = {d / t} m/s."
  ],
  "answer": "{d / t} m/s",
  "checks": [
   "d / t == 5"
  ]
 },
