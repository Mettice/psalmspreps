 "note": {
  "status": "draft",
  "text": "A videoconference is a live meeting with sound and video between people in different places, over the internet.\nTools: Zoom, Google Meet, Microsoft Teams, WhatsApp video calls, Skype.\nNeeded: a device with a camera and microphone (or headset), an internet connection with enough data, and the app or a browser.\nJoining: open the link or enter the meeting ID and passcode; check your name; join with microphone muted.\nFeatures: mute/unmute, camera on/off, chat, raise hand, share screen, record (with permission), breakout rooms.\nEtiquette: be on time, choose a quiet place with light in front of you, mute when not speaking, raise your hand to speak, dress properly, do not record others without permission.\nUses: online classes, meetings, interviews, talking to family abroad.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {},
  "problem": "Why should you mute your microphone when you are not speaking in an online class?",
  "steps": [
   "Background noise from your room is heard by everyone.",
   "Muting keeps the class quiet so the speaker can be heard."
  ],
  "answer": "To avoid background noise disturbing the class.",
  "checks": []
 },
