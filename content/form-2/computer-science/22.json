 "note": {
  "status": "draft",
  "text": "A web browser is a program used to open web pages: Google Chrome, Mozilla Firefox, Microsoft Edge, Safari, Opera.\nParts: the address bar (type the URL), tabs, back and forward buttons, refresh (reload), home, bookmarks (favourites), history, downloads, the menu.\nA URL is the address of a page, for example https://www.minesec.gov.cm. Its parts: the protocol (https://), the domain name (minesec.gov.cm) and sometimes a path. “https” and a padlock show a secure connection.\nA search engine (Google, Bing) finds pages using keywords. Tips: use exact keywords, put a phrase in quotes, check several sources, and judge who wrote the page and when.\nSafety: do not download from unknown sites, do not click strange pop-ups, log out on shared computers.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "u": "https://www.minesec.gov.cm"
  },
  "problem": "Name the parts of the URL {u}.",
  "steps": [
   "“https://” is the protocol; the “s” means the connection is secure.",
   "“www.minesec.gov.cm” is the domain name; “.cm” shows Cameroon."
  ],
  "answer": "Protocol: https://; domain name: www.minesec.gov.cm.",
  "checks": []
 },
