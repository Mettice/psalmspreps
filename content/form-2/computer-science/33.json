  {
   "id": "s2-33",
   "name": "Types of sensors"
  }
 ],
 "note": {
  "status": "draft",
  "text": "A sensor is a device that detects a change in the environment (a physical quantity) and turns it into a signal a computer can use.\nTypes:\n• temperature sensor (thermistor): fridges, air conditioners, thermometers;\n• light sensor (LDR): street lights that switch on at night, phone screen brightness;\n• motion (infrared, PIR) sensor: automatic doors, security alarms, lights in corridors;\n• sound sensor (microphone): voice assistants, clap switches;\n• pressure / touch sensor: touchscreens, weighing scales, car seat-belt alarms;\n• humidity and moisture sensors: weather stations, smart irrigation of farms;\n• gas and smoke sensors: smoke alarms, gas leak detectors;\n• proximity sensor: phone screen turns off near the ear; parking sensors;\n• GPS (position) and accelerometer: maps, step counters, screen rotation.\nMany sensors in phones: camera, microphone, fingerprint, GPS, accelerometer, light, proximity.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "x": "a street light switches on by itself at night"
  },
  "problem": "Which sensor makes {x}?",
  "steps": [
   "The light sensor detects that the light level has fallen.",
   "The controller then switches the lamp on."
  ],
  "answer": "A light sensor.",
  "checks": []
 },
