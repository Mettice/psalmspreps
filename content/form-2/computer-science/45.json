   "id": "s2-45",
   "name": "Communication and collaboration tools"
  }
 ],
 "note": {
  "status": "draft",
  "text": "Communication tools let people exchange messages; collaboration tools let them work together on the same task.\n• Communication: e-mail (Gmail, Outlook), chat and instant messaging (WhatsApp, Telegram, Messenger), voice and video calls (WhatsApp, Zoom, Google Meet, Teams), forums, SMS.\n• Collaboration: shared documents (Google Docs, Microsoft 365), shared folders (Google Drive, OneDrive), online whiteboards, calendars, task boards, learning platforms (Google Classroom).\nSynchronous tools work in real time (calls, chat); asynchronous tools do not need people to be online at the same time (e-mail, forums).\nRules (netiquette): be polite, write clearly, respect privacy, do not share others' messages without permission, check information before forwarding.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {},
  "problem": "Five pupils must write one report together from their homes. Which tool helps most?",
  "steps": [
   "They need to work on the same document at the same time or at different times.",
   "A shared online document (Google Docs) lets everyone edit and see changes."
  ],
  "answer": "A shared online document such as Google Docs.",
  "checks": []
 },
