 "note": {
  "status": "draft",
  "text": "A chat tool (instant messaging) sends short messages instantly: WhatsApp, Telegram, Messenger, Signal, SMS.\nFeatures: one-to-one chats, group chats, voice notes, photos and videos, stickers and emojis, status updates, read receipts (ticks), voice and video calls, end-to-end encryption (only sender and receiver can read).\nUses at school: class groups for homework announcements, sharing notes, organising club meetings.\nGood practice: stay on the topic of the group, be polite, do not spam or forward false news, ask before adding people to groups, think before sharing photos, report and block bullies, do not chat with strangers or share your location.\nChat language (abbreviations like “pls”, “4” for “for”) is fine with friends but not in school work or formal messages.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {},
  "problem": "A message in the class group says schools will close tomorrow because of a storm, but no source is given. What should you do?",
  "steps": [
   "Do not forward it at once: it may be false news.",
   "Check with the teacher or an official source before sharing."
  ],
  "answer": "Check with a teacher or official source before forwarding.",
  "checks": []
 },
