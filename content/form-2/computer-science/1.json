 "note": {
  "status": "draft",
  "text": "A computer system takes in data (input), processes it, stores it and gives out results (output).\nInput devices send data into the computer: keyboard (text), mouse and touchpad (pointing), scanner (pictures of paper documents), microphone (sound), webcam (video), barcode reader (product codes), digital camera.\nOutput devices give results from the computer: monitor (screen), printer (paper copies), speakers and headphones (sound), projector (large image).\nSome devices do both (input/output): a touch screen (you touch it and it shows images), a headset with a microphone, a modem.\nChoose devices for the task: a cashier needs a barcode reader; a teacher showing slides needs a projector.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "t": "a supermarket checkout"
  },
  "problem": "Name two input devices and two output devices used at {t}.",
  "steps": [
   "Input: a barcode reader reads the price codes; a keyboard or touch screen for corrections.",
   "Output: a screen shows the prices; a small printer prints the receipt."
  ],
  "answer": "Input: barcode reader, keyboard. Output: screen, receipt printer.",
  "checks": []
 },
