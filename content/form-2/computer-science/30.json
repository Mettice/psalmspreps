 "note": {
  "status": "draft",
  "text": "A digital footprint is the trail of data you leave when you use the internet. It can last for a very long time and be seen by others (schools, employers).\nTypes:\n• Active footprint: data you share on purpose: posts, photos, comments, messages, filling in online forms, reviews.\n• Passive footprint: data collected without you actively sharing it: websites visited, your location, cookies, your IP address, search history, which adverts you click.\nA footprint can be positive (good school work, kind comments, a useful blog) or negative (rude posts, embarrassing photos, cyberbullying).\nOnce something is online, it is hard to delete: others may have copied or shared it.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "x": "a website records the pages you visit"
  },
  "problem": "Is it an active or a passive footprint when {x}? Why?",
  "steps": [
   "You did not choose to share this information.",
   "It was collected automatically while you browsed."
  ],
  "answer": "A passive footprint.",
  "checks": []
 },
