  "steps": [
   "It uses a name and a year that others can guess, and has no capitals or symbols.",
   "A better one is long and mixed, for example “Mango!Rain{7}Blue”."
  ],
  "answer": "No: use a long mix of capital and small letters, numbers and symbols.",
  "checks": []
