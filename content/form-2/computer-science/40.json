 "note": {
  "status": "draft",
  "text": "Desktop publishing solves problems like advertising an event (poster, flyer), informing parents (newsletter), and making cards, certificates and menus.\nSteps:\n1. Decide the purpose, audience and size (A4, A5, card).\n2. Choose a template or a blank page; set the margins, orientation (portrait or landscape) and columns.\n3. Insert text frames (text boxes) and picture frames; type or import the text; insert pictures or clip art.\n4. Arrange the frames: alignment, layering, grouping; use WordArt or headings.\n5. Choose fonts and colours that are easy to read (no more than two or three fonts).\n6. Proofread, save, then print or export as PDF.\nA good poster answers: What? When? Where? Who? (with contact details), with a large heading and an eye-catching picture.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "e": "the school's science fair"
  },
  "problem": "What information must a poster for {e} include?",
  "steps": [
   "What: the name of the event, in a large heading.",
   "When, where and who: the date and time, the place, who can come, and a contact."
  ],
  "answer": "What, when, where and who, with contact details.",
  "checks": []
 },
