 "skills": [
  {
   "id": "s2-54",
   "name": "Verifying the credibility of information"
  }
 ],
 "note": {
  "status": "draft",
  "text": "Not everything online is true. Credible (believable) information comes from a reliable source and can be checked.\nCheck:\n• Source: who wrote it? an official body (ministry, school), a known newspaper, an expert? or an unknown account?\n• Evidence: are there facts, dates and references? can you find the same information on other reliable sites?\n• Date: is it recent or old news shared again?\n• Purpose: is it trying to inform, or to sell, frighten or make you click?\n• Language: many spelling mistakes, shouting in CAPITALS and “Share before it is deleted!” are warning signs.\n• Images can be edited or taken from another event: search for the original.\nFake news spreads fast; think before you share.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {},
  "problem": "A message says: “URGENT!!! Drinking hot water kills all viruses. Share before they delete it!” Is it credible?",
  "steps": [
   "There is no source, no evidence, capitals and pressure to share: warning signs.",
   "Health information should be checked with the Ministry of Health or a doctor."
  ],
  "answer": "No: it has warning signs; check with an official health source.",
  "checks": []
 },
