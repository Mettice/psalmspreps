 "note": {
  "status": "draft",
  "text": "E-mail (electronic mail) sends messages and files over the internet.\nAn e-mail address has the form username@domain, for example ayuk.tabe@gmail.com: the username, the @ sign (at), and the domain of the mail provider.\nParts of an e-mail: To (the receiver), Cc (a copy to others, visible), Bcc (a hidden copy), Subject (a short title), the body (the message), attachments (files), and a signature.\nActions: compose, send, reply, reply all, forward, delete, save as draft, move to folders; spam is unwanted e-mail.\nA formal e-mail has a clear subject, a greeting (Dear Sir/Madam), short paragraphs, a polite closing (Yours faithfully / Kind regards) and your name.\nSafety: do not open attachments or links from unknown senders (phishing).",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {},
  "problem": "Name the three parts of the address teacher.ngum@yahoo.com.",
  "steps": [
   "Before the @ is the username: teacher.ngum.",
   "After the @ is the domain of the provider: yahoo.com."
  ],
  "answer": "username: teacher.ngum; @; domain: yahoo.com",
  "checks": []
 },
