 "note": {
  "status": "draft",
  "text": "A number system (base) uses a fixed set of digits; each place is worth base × the place to its right.\n• Decimal (base 10): digits 0–9; places 1, 10, 100, …\n• Binary (base 2): digits 0 and 1; places 1, 2, 4, 8, 16, … Computers use binary because their circuits have two states (on/off).\n• Octal (base 8): digits 0–7; places 1, 8, 64, …\n• Hexadecimal (base 16): digits 0–9 and A–F (A = 10, B = 11, C = 12, D = 13, E = 14, F = 15); places 1, 16, 256, … Used for colours and memory addresses.\nWrite the base as a small number: 1011₂, 17₈, 2F₁₆.\nValue of a numeral: multiply each digit by its place value and add: 1011₂ = 8 + 0 + 2 + 1 = 11.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "s": "1101",
   "b": 2
  },
  "problem": "Find the decimal value of {s}{sub(b)}.",
  "steps": [
   "Place values in base {b}: {'8, 4, 2, 1'}.",
   "{placeSum(s, b)}"
  ],
  "answer": "{fromBase(s, b)}",
  "checks": [
   "fromBase(s, b) == 13"
  ]
 },
