 "note": {
  "status": "draft",
  "text": "Presentation software (Microsoft PowerPoint, LibreOffice Impress, Google Slides) makes slide shows to present ideas to an audience.\n• A presentation is made of slides; each slide can hold text, pictures, charts, sound and video.\n• Layouts and themes (designs) give slides a consistent look.\n• Transitions are effects between slides; animations move objects on a slide.\n• Views: normal, slide sorter, slide show; speaker notes help the presenter.\nDesktop publishing (DTP) software (Microsoft Publisher, Scribus, Canva) designs printed documents with careful page layout: posters, flyers, brochures, newsletters, cards, certificates.\n• It uses frames (text boxes and picture boxes) that can be placed anywhere on the page, columns, templates, and master pages.\nA word processor is mainly for typing text; DTP gives more control over layout.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "x": "a poster for the school's sports day"
  },
  "problem": "Which kind of software is best to design {x}? Why?",
  "steps": [
   "A poster needs pictures and text placed freely on the page.",
   "Desktop publishing software uses frames and templates for page layout."
  ],
  "answer": "Desktop publishing software.",
  "checks": []
 },
