 "note": {
  "status": "draft",
  "text": "Assistive technologies are devices and software that help people with disabilities use computers and live more independently.\n• Visual impairment: screen readers that read text aloud (NVDA, JAWS, TalkBack), screen magnifiers, Braille displays and embossers, high-contrast settings, large-key keyboards.\n• Hearing impairment: captions and subtitles, hearing aids, visual alerts, video calls for sign language.\n• Physical (mobility) impairment: speech recognition (voice typing), on-screen keyboards, trackballs, head pointers, eye-tracking, switches, sticky keys.\n• Learning and speech difficulties: text-to-speech, word prediction, speech-generating devices.\nBenefits: equal access to education and jobs, independence, communication, inclusion.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "p": "a pupil who is blind"
  },
  "problem": "Which assistive technology can help {p} to use a computer?",
  "steps": [
   "A screen reader reads the text on the screen aloud.",
   "A Braille display shows the text as raised dots to read by touch."
  ],
  "answer": "A screen reader and a Braille display.",
  "checks": []
 },
