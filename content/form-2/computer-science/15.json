 "note": {
  "status": "draft",
  "text": "Computers store numbers in binary, using bits (binary digits, 0 or 1). A group of 8 bits is a byte.\nDecimal → binary: divide by 2 again and again, writing the remainders, then read the remainders from the bottom up. Or subtract place values 128, 64, 32, 16, 8, 4, 2, 1.\nExample: 13 = 8 + 4 + 1 = 1101₂; as an 8-bit byte: 00001101.\nBinary → decimal: add the place values where there is a 1.\nWith n bits you can store 2ⁿ different values: 8 bits store 256 values, from 0 to 255.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "n": 22,
   "two": 2
  },
  "problem": "Convert {n} to binary and write it as an {8}-bit byte.",
  "steps": [
   "{divSteps(n, two)}",
   "As {8} bits, add zeros in front: {bits8(n)}."
  ],
  "answer": "{toBase(n, two)}{sub(two)} = {bits8(n)}",
  "checks": [
   "toBase(n, two) == '10110'"
  ]
 },
