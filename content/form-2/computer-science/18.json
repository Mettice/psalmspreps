   "id": "s2-18",
   "name": "Converting between units of time"
  }
 ],
 "note": {
  "status": "draft",
  "text": "Units of time: 1 minute = 60 seconds; 1 hour = 60 minutes = 3600 seconds; 1 day = 24 hours; 1 week = 7 days.\nTo change a big unit into a smaller one, multiply: 3 h = 3 × 60 = 180 min. To change a small unit into a bigger one, divide: 240 s = 240 ÷ 60 = 4 min.\nComputers also use very small units: a millisecond (ms) is a thousandth of a second (1 s = 1000 ms); a microsecond is a millionth.\nUses: how long a download takes, how long a video lasts, how long a battery works, and the time a program takes to run.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "h": 2,
   "m": 15,
   "sixty": 60
  },
  "problem": "A download takes {h} h {m} min. How many minutes is that?",
  "steps": [
   "Hours to minutes: multiply by {sixty}: {h} × {sixty} = {h * sixty} min.",
   "Add the minutes: {h * sixty} + {m} = {h * sixty + m} min."
  ],
  "answer": "{h * sixty + m} minutes",
  "checks": [
   "h * sixty + m == 135"
  ]
 },
