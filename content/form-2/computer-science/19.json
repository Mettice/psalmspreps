 "note": {
  "status": "draft",
  "text": "Storage units: 1 byte = 8 bits; 1 kilobyte (KB) = 1024 bytes; 1 megabyte (MB) = 1024 KB; 1 gigabyte (GB) = 1024 MB; 1 terabyte (TB) = 1024 GB.\n(In schools we use 1024 because computers work in powers of 2: 1024 = 2¹⁰. Some makers of disks use 1000.)\nTo change a big unit into a smaller one, multiply by 1024 for each step; to change a small unit into a bigger one, divide.\nExamples: 2 KB = 2 × 1024 = 2048 bytes; 3072 MB = 3072 ÷ 1024 = 3 GB; 4 bytes = 32 bits.\nRough sizes: a page of text, a few KB; a photo, a few MB; a film, one or more GB; a large hard disk, a few TB.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "g": 2,
   "k": 1024
  },
  "problem": "A phone has {g} GB of free space. How many MB is that?",
  "steps": [
   "One GB is {k} MB.",
   "{g} × {k} = {storageConvert(g, 'GB', 'MB')} MB."
  ],
  "answer": "{storageConvert(g, 'GB', 'MB')} MB",
  "checks": [
   "storageConvert(g, 'GB', 'MB') == 2048"
  ]
 },
