 "note": {
  "status": "draft",
  "text": "Cloud computing is using computing services (storage, software, processing power) over the internet, on servers in large data centres, instead of only on your own device.\nExamples: storing files on Google Drive, OneDrive, Dropbox or iCloud; using Gmail; editing Google Docs online; watching videos on YouTube; backing up phone photos.\nTypes of service: storage (keep files), software as a service (use programs in a browser), platforms and infrastructure for businesses.\nAdvantages: access files from any device anywhere; automatic backup; easy sharing and working together; no need for a big hard disk; often free for small amounts.\nDisadvantages: needs an internet connection; uses data; privacy and security risks if the account is hacked; you depend on the company; large storage costs money.",
  "checks": []
 },
 "worked_example": {
  "status": "draft",
  "vars": {
   "x": "a pupil saves a project on Google Drive"
  },
  "problem": "Give one advantage and one disadvantage when {x}.",
  "steps": [
   "Advantage: the project can be opened from any phone or computer, and it is not lost if the laptop breaks.",
   "Disadvantage: an internet connection (and data) is needed to open it."
  ],
  "answer": "Access anywhere and a safe backup; but it needs the internet.",
  "checks": []
 },
